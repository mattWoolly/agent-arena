# Per-model environment for qwen3.7-max via Alibaba Cloud Model Studio's
# Anthropic-compatible endpoint. Copy to env/qwen3.7-max.env and fill in the
# key. The real .env file is gitignored; never commit keys.
#
# Docs (verified 2026-08-18):
# https://www.alibabacloud.com/help/en/model-studio/claude-code
# Pay-as-you-go international (Singapore) base URL is WORKSPACE-TEMPLATED:
#   https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/apps/anthropic
# Replace {WorkspaceId} with the Model Studio workspace id. (Beijing region
# uses https://dashscope.aliyuncs.com/apps/anthropic; third-party guides also
# show https://dashscope-intl.aliyuncs.com/apps/anthropic, unconfirmed against
# the primary doc, so verify whichever the account actually accepts at smoke.)
ANTHROPIC_BASE_URL=https://REPLACE_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/apps/anthropic
ANTHROPIC_AUTH_TOKEN=REPLACE_ME
# Pin every internal model slot so no side-channel calls leak elsewhere.
ANTHROPIC_MODEL=qwen3.7-max
ANTHROPIC_DEFAULT_OPUS_MODEL=qwen3.7-max
ANTHROPIC_DEFAULT_SONNET_MODEL=qwen3.7-max
ANTHROPIC_DEFAULT_HAIKU_MODEL=qwen3.7-max
CLAUDE_CODE_SUBAGENT_MODEL=qwen3.7-max

# --- PLAN + VERSION NOTES (from the primary doc, 2026-08-18) ---
# qwen3.7-max is NOT available on the Coding Plan; it needs pay-as-you-go
# (or the Token Plan tier). Documented model ids on this endpoint:
# qwen3.6-plus, qwen3.6-flash, qwen3.7-plus, qwen3.7-max.
# Aggregator sites are already writing about a "qwen 3.8 max"; the official
# Model Studio doc does not list it as of 2026-08-18. Demand a primary source
# before benchmarking any 3.8 claim (see the series' research-hygiene rule).
#
# Smoke-time TODO before the first graded run: confirm served id string via
# bin/served_model.py (this endpoint is exactly the silent-routing risk class
# Z.ai demonstrated), and add qwen3.7-max list prices to the metrics price
# table so cost columns are real.
