# Per-model environment for deepseek-v4-pro via DeepSeek's first-party
# Anthropic-compatible endpoint. Copy to env/deepseek-v4-pro.env and fill in
# the key. The real .env file is gitignored; never commit keys.
#
# Docs (verified 2026-08-18): https://api-docs.deepseek.com/guides/anthropic_api
# DeepSeek's guide authenticates with ANTHROPIC_API_KEY (not AUTH_TOKEN, unlike
# Z.ai/Moonshot). Set here per-run only, so it never shadows the Anthropic
# subscription the way the dry pay-go key in ~/.secrets does.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=REPLACE_ME
# Pin every internal model slot so no side-channel calls leak elsewhere.
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-pro
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-pro

# --- ROUTING HAZARD (documented vendor behavior, same class as Z.ai's) ---
# The endpoint AUTO-MAPS Claude model names: claude-opus-* -> deepseek-v4-pro,
# claude-sonnet-*/haiku-* -> deepseek-v4-flash, and "unsupported Claude names"
# -> deepseek-v4-flash. Always request explicit deepseek ids, and every bout
# using this endpoint MUST carry the served-model guard (EXPECTED.json +
# summarize hard-stop). A typo'd model id here would silently become v4-flash.
#
# Known parameter quirks from the vendor doc: with tool_choice auto/any,
# disable_parallel_tool_use is ignored; cache_control on tool definitions is
# ignored.
#
# Smoke-time TODO before the first graded run: confirm served id string via
# bin/served_model.py, and add deepseek-v4-pro list prices to the metrics
# price table so cost columns are real.
