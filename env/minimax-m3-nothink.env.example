# Per-model environment for minimax-m3-nothink: identical to minimax-m3
# except thinking is suppressed at the harness (MAX_THINKING_TOKENS=0).
# The suppression mechanism is wire-verified at smoke before any graded run;
# if the endpoint still emits thinking blocks under it, the fallback
# mechanism and the deviation are recorded in the bout's ANALYSIS.md.
# Copy to env/minimax-m3-nothink.env and fill in the key.
# The real .env file is gitignored; never commit keys.
#
# Docs: https://platform.minimax.io/docs/token-plan/claude-code
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
ANTHROPIC_AUTH_TOKEN=REPLACE_ME
ANTHROPIC_MODEL=MiniMax-M3
ANTHROPIC_DEFAULT_OPUS_MODEL=MiniMax-M3
ANTHROPIC_DEFAULT_SONNET_MODEL=MiniMax-M3
ANTHROPIC_DEFAULT_HAIKU_MODEL=MiniMax-M3
CLAUDE_CODE_SUBAGENT_MODEL=MiniMax-M3
MAX_THINKING_TOKENS=0
