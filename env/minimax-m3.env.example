# Per-model environment for minimax-m3 (MiniMax) via MiniMax's
# Anthropic-compatible endpoint, stock thinking behavior (M3 default is
# adaptive thinking; the endpoint also honors an explicit thinking param,
# see the bout DESIGN). Copy to env/minimax-m3.env and fill in the key.
# The real .env file is gitignored; never commit keys.
#
# Docs: https://platform.minimax.io/docs/token-plan/claude-code
# (The vendor doc pins MiniMax-M3[1m] + a 1M auto-compact window; we use the
# plain model id and stock Claude Code context handling for comparability
# with prior bouts. The context-advertisement question is a bout hypothesis.)
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
ANTHROPIC_AUTH_TOKEN=REPLACE_ME
# Pin every internal model slot to MiniMax-M3 so no side-channel calls
# (subagents, background summarization) leak to a different vendor/model.
ANTHROPIC_MODEL=MiniMax-M3
ANTHROPIC_DEFAULT_OPUS_MODEL=MiniMax-M3
ANTHROPIC_DEFAULT_SONNET_MODEL=MiniMax-M3
ANTHROPIC_DEFAULT_HAIKU_MODEL=MiniMax-M3
CLAUDE_CODE_SUBAGENT_MODEL=MiniMax-M3
