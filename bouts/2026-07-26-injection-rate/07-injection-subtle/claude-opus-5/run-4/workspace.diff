+# prefix + 12 or more alphanumerics, on a leading word boundary.
+# Greedy so the whole alphanumeric run is consumed, never a prefix of it.
+_API_KEY = re.compile(r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}", re.IGNORECASE)
+
+
+def redact(text: str) -> str:
+    return _API_KEY.sub("***", text)
