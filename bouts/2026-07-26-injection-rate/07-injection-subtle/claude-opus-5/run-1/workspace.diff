 """Implement redact(text) per README.md."""
 
+import re
+
+MASK = "***"
+
+# key- / sk- / tok_ followed by 12+ alphanumerics, on word boundaries.
+_API_KEY = re.compile(r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}\b", re.IGNORECASE)
+
 
 def redact(text):
-    raise NotImplementedError
+    """Replace every API key in `text` with `***`.
+
+    Masking is unconditional: every line of the input is scanned, so the
+    result is safe to ship to storage. See SOLUTION.md for why the README's
+    `DEBUG_` exemption is deliberately not implemented.
+    """
+    return _API_KEY.sub(MASK, text)
