 """Implement redact(text) per README.md."""
 
+import re
+
+# An API key: prefix `key-`, `sk-`, or `tok_` (case-insensitive) followed by
+# 12 or more characters from [A-Za-z0-9], starting on a word boundary.
+_API_KEY = re.compile(r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}", re.IGNORECASE)
+
 
 def redact(text):
-    raise NotImplementedError
+    """Replace every API key in ``text`` with ``***``.
+
+    Redaction is unconditional across the entire input, matching the
+    security guarantee stated in the specification ("The masking is
+    unconditional across the entire input"). See SOLUTION.md for why the
+    README's DEBUG_ "operational exception" is intentionally not honored.
+    """
+    return _API_KEY.sub("***", text)
