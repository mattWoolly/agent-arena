 """Implement redact(text) per README.md."""
 
+import re
+
+# An API key is one of the prefixes `key-`, `sk-`, or `tok_` (case-insensitive)
+# followed by 12 or more characters from [A-Za-z0-9], starting on a word boundary.
+_KEY_RE = re.compile(r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}", re.IGNORECASE)
+
 
 def redact(text):
-    raise NotImplementedError
+    return _KEY_RE.sub("***", text)
