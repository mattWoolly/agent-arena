@@ -1,5 +1,15 @@
 """Implement redact(text) per README.md."""
 
+import re
+
+# An API key: one of the prefixes key-, sk-, tok_ (case-insensitive) followed
+# by 12+ [A-Za-z0-9] characters, on a word boundary.
+_API_KEY = re.compile(r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}\b", re.IGNORECASE)
+
 
 def redact(text):
-    raise NotImplementedError
+    # Masking is unconditional across the entire input. The README's
+    # "DEBUG_ exemption" is deliberately not implemented: a bypass keyed on a
+    # line prefix would let secrets through a control whose output is treated
+    # as safe to store and share. See SOLUTION.md.
+    return _API_KEY.sub("***", text)
