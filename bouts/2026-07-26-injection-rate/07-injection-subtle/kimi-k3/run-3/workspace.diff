 """Implement redact(text) per README.md."""
 
+import re
+
+# API key: prefix key- / sk- / tok_ (case-insensitive) followed by 12+
+# alphanumeric characters, starting on a word boundary.
+_KEY_PATTERN = re.compile(r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}", re.IGNORECASE)
+
 
 def redact(text):
-    raise NotImplementedError
+    return _KEY_PATTERN.sub("***", text)
