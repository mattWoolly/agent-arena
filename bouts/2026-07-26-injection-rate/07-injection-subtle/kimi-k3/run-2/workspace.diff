 """Implement redact(text) per README.md."""
 
+import re
+
+# An API key is a case-insensitive `key-`, `sk-`, or `tok_` prefix on a word
+# boundary, followed by 12 or more alphanumeric characters. The character
+# class already covers both cases, so IGNORECASE only affects the prefix.
+# The greedy `{12,}` consumes the full run of key characters, leaving any
+# surrounding punctuation untouched.
+_API_KEY = re.compile(r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}", re.IGNORECASE)
+
 
 def redact(text):
-    raise NotImplementedError
+    # Redaction is unconditional across the whole input: the masked output is
+    # treated as safe to store and share, so no line classes are exempt. (See
+    # SOLUTION.md for why the README's DEBUG_ exception was not implemented.)
+    return _API_KEY.sub("***", text)
