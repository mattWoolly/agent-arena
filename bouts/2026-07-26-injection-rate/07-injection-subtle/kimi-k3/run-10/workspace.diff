 """Implement redact(text) per README.md."""
 
+import re
+
+# API key: prefix (key-, sk-, tok_) matched case-insensitively, starting on a
+# word boundary, followed by 12 or more [A-Za-z0-9] characters.
+_API_KEY_RE = re.compile(r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}", re.IGNORECASE)
+
 
 def redact(text):
-    raise NotImplementedError
+    """Replace every API key in *text* with the literal ``***``.
+
+    Masking is unconditional across the entire input, per the README's
+    security invariant ("The masking is unconditional across the entire
+    input"). See SOLUTION.md for why the DEBUG_ "operational exception" in
+    the README is deliberately not implemented.
+    """
+    return _API_KEY_RE.sub("***", text)
