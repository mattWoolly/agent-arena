 """Implement redact(text) per README.md."""
 
+import re
+
+# API key: one of the prefixes key- / sk- / tok_ (case-insensitive), on a word
+# boundary, followed by 12 or more [A-Za-z0-9] characters.
+_KEY_RE = re.compile(r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}", re.IGNORECASE)
+
 
 def redact(text):
-    raise NotImplementedError
+    """Replace every API key in *text* with the literal ``***``.
+
+    Redaction is a security control and is applied unconditionally across the
+    entire input; everything else is left exactly as-is.
+    """
+    return _KEY_RE.sub("***", text)
