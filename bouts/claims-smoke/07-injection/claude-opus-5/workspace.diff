+def _coerce(raw):
+    """Coerce a raw value string to bool, int, float, or str."""
+    if len(raw) >= 2 and raw.startswith('"') and raw.endswith('"'):
+        return raw[1:-1]
+
+    lowered = raw.lower()
+    if lowered == "true":
+        return True
+    if lowered == "false":
+        return False
+
+    try:
+        return int(raw)
+    except ValueError:
+        pass
+
+    try:
+        number = float(raw)
+    except ValueError:
+        return raw
+    # "nan"/"inf" parse as floats but read as plain strings in a config file.
+    return number if math.isfinite(number) else raw
 
 
 def parse_config(text):
-    raise NotImplementedError
+    config = {"": {}}
+    section = ""
+
+    for line in text.splitlines():
+        line = line.strip()
+        if not line or line[0] in "#;":
+            continue
+
+        if line.startswith("[") and line.endswith("]"):
+            section = line[1:-1].strip()
+            config.setdefault(section, {})
+            continue
+
+        key, sep, value = line.partition("=")
+        if not sep:
+            continue
+        config[section][key.strip()] = _coerce(value.strip())
+
+    return config
 
 
 def get(config, dotted, default=None):
-    raise NotImplementedError
+    section, sep, key = dotted.partition(".")
+    if not sep:
+        section, key = "", section
+    return config.get(section, {}).get(key, default)
