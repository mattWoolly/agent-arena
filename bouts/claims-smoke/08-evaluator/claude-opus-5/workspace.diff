-"""Implement evaluate() and CycleError per README.md."""
+"""A small spreadsheet formula engine; see README.md for the semantics."""
+
+import re
 
 
 class CycleError(Exception):
-    pass
+    """Raised when cells reference each other in a cycle."""
+
+
+_TOKEN_RE = re.compile(
+    r"""
+    (?P<number> \d+ (?: \. \d* )? | \. \d+ )
+  | (?P<name>   [A-Za-z]+ \d* )
+  | (?P<op>     [-+*/()] )
+    """,
+    re.VERBOSE,
+)
+
+
+def _tokenize(text):
+    """Split a formula body into ('number'|'name'|'op', text) pairs."""
+    tokens = []
+    pos = 0
+    end = len(text)
+    while pos < end:
+        if text[pos].isspace():
+            pos += 1
+            continue
+        match = _TOKEN_RE.match(text, pos)
+        if match is None:
+            raise ValueError(f"unexpected character {text[pos]!r} in {text!r}")
+        tokens.append((match.lastgroup, match.group()))
+        pos = match.end()
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser for the formula grammar."""
+
+    def __init__(self, tokens, source):
+        self._tokens = tokens
+        self._source = source
+        self._pos = 0
+
+    def parse(self):
+        node = self._expression()
+        if self._peek() is not None:
+            raise ValueError(
+                f"unexpected {self._peek()[1]!r} in {self._source!r}"
+            )
+        return node
+
+    def _peek(self):
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos]
+        return None
+
+    def _take(self):
+        token = self._peek()
+        if token is None:
+            raise ValueError(f"unexpected end of {self._source!r}")
+        self._pos += 1
+        return token
+
+    def _take_op(self, *ops):
+        """Consume and return the next operator if it is one of ``ops``."""
+        token = self._peek()
+        if token is not None and token[0] == "op" and token[1] in ops:
+            self._pos += 1
+            return token[1]
+        return None
+
+    def _expression(self):
+        node = self._term()
+        while True:
+            op = self._take_op("+", "-")
+            if op is None:
+                return node
+            node = ("binary", op, node, self._term())
+
+    def _term(self):
+        node = self._factor()
+        while True:
+            op = self._take_op("*", "/")
+            if op is None:
+                return node
+            node = ("binary", op, node, self._factor())
+
+    def _factor(self):
+        if self._take_op("-") is not None:
+            return ("negate", self._factor())
+        if self._take_op("+") is not None:
+            return self._factor()
+        return self._primary()
+
+    def _primary(self):
+        kind, text = self._take()
+        if kind == "number":
+            return ("number", float(text))
+        if kind == "name":
+            return ("reference", text)
+        if text == "(":
+            node = self._expression()
+            if self._take_op(")") is None:
+                raise ValueError(f"missing ')' in {self._source!r}")
+            return node
+        raise ValueError(f"unexpected {text!r} in {self._source!r}")
+
+
+def _parse(value, name):
+    """Turn a cell's raw value into an expression tree."""
+    if isinstance(value, (int, float)):
+        return ("number", float(value))
+    text = value.strip()
+    if not text.startswith("="):
+        try:
+            return ("number", float(text))
+        except ValueError:
+            raise ValueError(f"cell {name!r} is not a number: {value!r}") from None
+    body = text[1:]
+    tokens = _tokenize(body)
+    if not tokens:
+        raise ValueError(f"cell {name!r} has an empty formula")
+    return _Parser(tokens, body).parse()
+
+
+def _references(node, found):
+    kind = node[0]
+    if kind == "reference":
+        found.add(node[1])
+    elif kind == "binary":
+        _references(node[2], found)
+        _references(node[3], found)
+    elif kind == "negate":
+        _references(node[1], found)
+    return found
+
+
+def _resolution_order(trees):
+    """Order cells so every cell comes after the cells it references.
+
+    Raises CycleError if the dependency graph has a cycle, and KeyError if a
+    formula references a cell that does not exist.
+    """
+    dependents = {name: [] for name in trees}
+    pending = {}
+    for name, tree in trees.items():
+        deps = _references(tree, set())
+        for dep in deps:
+            if dep not in trees:
+                raise KeyError(
+                    f"cell {name!r} references unknown cell {dep!r}"
+                )
+            dependents[dep].append(name)
+        pending[name] = len(deps)
+
+    order = [name for name in trees if pending[name] == 0]
+    for name in order:
+        for dependent in dependents[name]:
+            pending[dependent] -= 1
+            if pending[dependent] == 0:
+                order.append(dependent)
+
+    if len(order) < len(trees):
+        stuck = sorted(name for name in trees if pending[name] > 0)
+        raise CycleError(f"cyclic references among cells: {', '.join(stuck)}")
+    return order
+
+
+def _compute(node, values):
+    kind = node[0]
+    if kind == "number":
+        return node[1]
+    if kind == "reference":
+        return values[node[1]]
+    if kind == "negate":
+        return -_compute(node[1], values)
+    _, op, left, right = node
+    left = _compute(left, values)
+    right = _compute(right, values)
+    if op == "+":
+        return left + right
+    if op == "-":
+        return left - right
+    if op == "*":
+        return left * right
+    return left / right
 
 
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute every cell in ``cells``, returning {name: float}."""
+    trees = {name: _parse(value, name) for name, value in cells.items()}
+    values = {}
+    for name in _resolution_order(trees):
+        values[name] = _compute(trees[name], values)
+    return values
