+    @staticmethod
+    def _tokenize(formula):
+        tokens = []
+        position = 0
+
+        while position < len(formula):
+            character = formula[position]
+
+            if character.isspace():
+                position += 1
+                continue
+
+            if character.isdigit():
+                start = position
+                while position < len(formula) and formula[position].isdigit():
+                    position += 1
+                if position < len(formula) and formula[position] == ".":
+                    position += 1
+                    decimal_start = position
+                    while position < len(formula) and formula[position].isdigit():
+                        position += 1
+                    if decimal_start == position:
+                        raise ValueError("decimal point must be followed by a digit")
+                tokens.append(("number", formula[start:position]))
+                continue
+
+            if character.isalpha():
+                start = position
+                while position < len(formula) and formula[position].isalpha():
+                    position += 1
+                while position < len(formula) and formula[position].isdigit():
+                    position += 1
+                tokens.append(("reference", formula[start:position]))
+                continue
+
+            if character in "+-*/^()":
+                tokens.append((character, character))
+                position += 1
+                continue
+
+            raise ValueError(f"unexpected character {character!r}")
+
+        tokens.append(("end", ""))
+        return tokens
+
+    def parse(self):
+        expression = self._parse_sum()
+        if self._peek() != "end":
+            raise ValueError(f"unexpected token {self._value()!r}")
+        return expression
+
+    def _peek(self):
+        return self.tokens[self.position][0]
+
+    def _value(self):
+        return self.tokens[self.position][1]
+
+    def _take(self, kind):
+        if self._peek() != kind:
+            raise ValueError(f"expected {kind!r}, got {self._value()!r}")
+        value = self._value()
+        self.position += 1
+        return value
+
+    def _parse_sum(self):
+        expression = self._parse_product()
+        while self._peek() in ("+", "-"):
+            operator = self._take(self._peek())
+            expression = (operator, expression, self._parse_product())
+        return expression
+
+    def _parse_product(self):
