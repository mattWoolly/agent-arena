-"""Implement evaluate() and CycleError per README.md."""
+"""Tiny spreadsheet formula engine.
+
+Implements evaluate(cells) and CycleError per README.md:
+
+- Cells contain bare numbers or formulas starting with ``=``.
+- Grammar: numbers, cell references, binary ``+ - * / ^`` with precedence
+  ``+ -`` < ``* /`` < ``^``; ``+ - * /`` left-associative, ``^``
+  right-associative; unary minus binds looser than ``^``; parentheses group.
+- References may be forward and transitive; any cycle raises CycleError.
+"""
+
+import re
+
+__all__ = ["evaluate", "CycleError"]
 
 
 class CycleError(Exception):
-    pass
+    """Raised when a cell depends on itself, directly or transitively."""
+
+
+_TOKEN_RE = re.compile(
+    r"""
+    \s*(?:
+        (?P<number>\d+(?:\.\d*)?|\.\d+)   # integer or decimal
+      | (?P<ref>[A-Za-z]+[0-9]*)          # cell reference
+      | (?P<op>[+\-*/^()])                # operator / paren
+    )
+    """,
+    re.VERBOSE,
+)
+
+
+def _tokenize(formula):
+    pos = 0
+    n = len(formula)
+    while pos < n:
+        if formula[pos].isspace():
+            pos += 1
+            continue
+        m = _TOKEN_RE.match(formula, pos)
+        if not m or m.end() == pos:
+            raise ValueError(f"invalid token in formula: {formula!r} at {pos}")
+        pos = m.end()
+        if m.lastgroup == "number":
+            yield ("num", float(m.group()))
+        elif m.lastgroup == "ref":
+            yield ("ref", m.group())
+        else:
+            yield (m.group(), m.group())
+
+
+class _Parser:
+    """Recursive-descent parser/evaluator for one formula string."""
+
+    def __init__(self, formula, resolve):
+        self._tokens = list(_tokenize(formula))
+        self._pos = 0
+        self._resolve = resolve  # ref name -> float
+
+    def _peek(self):
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos][0]
+        return None
+
+    def _next(self):
+        tok = self._tokens[self._pos]
+        self._pos += 1
+        return tok
+
+    def parse(self):
+        value = self._expr()
+        if self._pos != len(self._tokens):
+            raise ValueError("trailing tokens in formula")
+        return value
+
+    # expr := term (('+' | '-') term)*
+    def _expr(self):
+        value = self._term()
+        while self._peek() in ("+", "-"):
+            op = self._next()[0]
+            rhs = self._term()
+            value = value + rhs if op == "+" else value - rhs
+        return value
+
+    # term := power (('*' | '/') power)*
+    def _term(self):
+        value = self._power()
+        while self._peek() in ("*", "/"):
+            op = self._next()[0]
+            rhs = self._power()
+            value = value * rhs if op == "*" else value / rhs
+        return value
+
+    # power := unary ('^' power)?   -- right-associative
+    # unary := '-' unary | atom     -- binds looser than '^'
+    # Combined: a unary minus applies to the whole power expression.
+    def _power(self):
+        if self._peek() == "-":
+            self._next()
+            return -self._power()
+        base = self._atom()
+        if self._peek() == "^":
+            self._next()
+            exponent = self._power()
+            return base ** exponent
+        return base
+
+    def _atom(self):
+        kind, val = self._next()
+        if kind == "num":
+            return val
+        if kind == "ref":
+            return self._resolve(val)
+        if kind == "(":
+            value = self._expr()
+            if self._peek() != ")":
+                raise ValueError("unbalanced parenthesis")
+            self._next()
+            return value
+        raise ValueError(f"unexpected token: {val!r}")
 
 
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute the float value of every cell in ``cells``.
+
+    Returns a dict mapping each cell name to its value. Raises CycleError
+    if any cell depends on itself.
+    """
+    values = {}
+    in_progress = set()
+
+    def compute(name):
+        if name in values:
+            return values[name]
+        if name in in_progress:
+            raise CycleError(f"cycle detected at cell {name!r}")
+        if name not in cells:
+            raise KeyError(f"unknown cell referenced: {name!r}")
+        in_progress.add(name)
+        try:
+            raw = cells[name]
+            if isinstance(raw, str) and raw.startswith("="):
+                value = _Parser(raw[1:], compute).parse()
+            else:
+                value = float(raw)
+        finally:
+            in_progress.discard(name)
+        values[name] = value
+        return value
+
+    for name in cells:
+        compute(name)
+    return values
