+"""A small spreadsheet formula engine.
+
+Implements ``evaluate(cells)`` and ``CycleError`` per README.md.
+"""
+
+import re
 
 
 class CycleError(Exception):
-    pass
+    """Raised when cell references form a dependency cycle."""
+
+
+# ---------------------------------------------------------------------------
+# Tokenizer
+# ---------------------------------------------------------------------------
+
+_TOKEN_RE = re.compile(
+    r"""
+      (?P<number>\d+(?:\.\d+)?|\.\d+)   # 3, 3.5, .5
+    | (?P<name>[A-Za-z]+\d*)            # A, B, A1, TOTAL, X12
+    | (?P<op>[+\-*/^()])                # operators and parentheses
+    """,
+    re.VERBOSE,
+)
+
+
+def _tokenize(text):
+    """Turn formula text into a list of (kind, value) tokens, ending with ('end', None)."""
+    tokens = []
+    pos = 0
+    while pos < len(text):
+        if text[pos].isspace():
+            pos += 1
+            continue
+        match = _TOKEN_RE.match(text, pos)
+        if match is None:
+            raise SyntaxError("unexpected character %r in %r" % (text[pos], text))
+        kind = match.lastgroup
+        value = match.group()
+        if kind == "number":
+            tokens.append(("num", float(value)))
+        elif kind == "name":
+            tokens.append(("ref", value))
+        else:
+            tokens.append(("op", value))
+        pos = match.end()
+    tokens.append(("end", None))
+    return tokens
+
+
+# ---------------------------------------------------------------------------
+# Parser (recursive descent)
+#
+# Precedence, loosest to tightest:
+#     expr  := term  (('+' | '-') term)*          left-assoc
+#     term  := unary (('*' | '/') unary)*         left-assoc
+#     unary := ('+' | '-') unary | power          binds looser than '^'
+#     power := atom ('^' unary)?                  right-assoc
+#     atom  := number | reference | '(' expr ')'
+#
+# Unary minus below '^' gives -2^2 == -(2^2) == -4, while the exponent side
+# being a unary lets 2^-3 and 2^3^2 == 2^(3^2) both work.
+# ---------------------------------------------------------------------------
+
+
+class _Parser:
+    def __init__(self, tokens):
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self):
+        return self.tokens[self.pos]
+
+    def _advance(self):
+        token = self.tokens[self.pos]
+        self.pos += 1
+        return token
+
+    def _match_op(self, *ops):
+        kind, value = self._peek()
+        if kind == "op" and value in ops:
+            self._advance()
+            return value
+        return None
+
+    def parse(self):
+        node = self._expr()
+        kind, value = self._peek()
+        if kind != "end":
+            raise SyntaxError("unexpected token %r" % (value,))
+        return node
+
+    def _expr(self):
+        node = self._term()
+        while True:
+            op = self._match_op("+", "-")
+            if op is None:
+                return node
+            node = (op, node, self._term())
+
+    def _term(self):
+        node = self._unary()
+        while True:
+            op = self._match_op("*", "/")
+            if op is None:
+                return node
+            node = (op, node, self._unary())
+
+    def _unary(self):
+        op = self._match_op("+", "-")
+        if op == "-":
+            return ("neg", self._unary())
+        if op == "+":
+            return self._unary()
+        return self._power()
+
+    def _power(self):
+        base = self._atom()
+        if self._match_op("^") is None:
+            return base
+        return ("^", base, self._unary())
+
+    def _atom(self):
+        kind, value = self._advance()
+        if kind == "num":
+            return ("num", value)
+        if kind == "ref":
+            return ("ref", value)
+        if kind == "op" and value == "(":
+            node = self._expr()
+            if self._match_op(")") is None:
+                raise SyntaxError("missing closing parenthesis")
+            return node
+        raise SyntaxError("unexpected token %r" % (value,))
+
+
+def _collect_refs(node, out):
+    if not isinstance(node, tuple):  # number leaf inside 'num' nodes
+        return
+    kind = node[0]
+    if kind == "ref":
+        out.add(node[1])
+    elif kind == "num":
+        pass
+    elif kind == "neg":
+        _collect_refs(node[1], out)
+    else:  # binary operator node
+        _collect_refs(node[1], out)
+        _collect_refs(node[2], out)
+
+
+def _eval_node(node, values):
+    kind = node[0]
+    if kind == "num":
+        return node[1]
+    if kind == "ref":
+        return values[node[1]]  # KeyError for references to unknown cells
+    if kind == "neg":
+        return -_eval_node(node[1], values)
+    left = _eval_node(node[1], values)
+    right = _eval_node(node[2], values)
+    if kind == "+":
+        return left + right
+    if kind == "-":
+        return left - right
+    if kind == "*":
+        return left * right
+    if kind == "/":
+        return left / right  # ZeroDivisionError propagates, per spec
+    return left ** right  # '^'
+
+
+# ---------------------------------------------------------------------------
+# Dependency resolution and evaluation
+# ---------------------------------------------------------------------------
+
+def _topological_order(cells, deps):
+    """Order cell names so every cell comes after the cells it references.
+
+    Iterative DFS (no recursion limit on long chains); raises CycleError on
+    encountering a back edge to a cell still on the stack.
+    """
+    WHITE, GRAY, BLACK = 0, 1, 2
+    color = dict.fromkeys(cells, WHITE)
+    order = []
+    for start in cells:
+        if color[start] != WHITE:
+            continue
+        color[start] = GRAY
+        stack = [(start, iter(sorted(deps[start])))]
+        while stack:
+            node, dep_iter = stack[-1]
+            descended = False
+            for dep in dep_iter:
+                if dep not in cells:
+                    continue  # unknown cells surface as KeyError at eval time
+                if color[dep] == WHITE:
+                    color[dep] = GRAY
+                    stack.append((dep, iter(sorted(deps[dep]))))
+                    descended = True
+                    break
+                if color[dep] == GRAY:
+                    cycle = [n for n, _ in stack] + [dep]
+                    raise CycleError(
+                        "dependency cycle: %s"
+                        % " -> ".join(cycle[cycle.index(dep):])
+                    )
+            if not descended:
+                stack.pop()
+                color[node] = BLACK
+                order.append(node)
+    return order
 
 
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute the float value of every cell in ``cells``.
+
+    ``cells`` maps names to either bare numeric strings or ``=``-formulas.
+    Forward and transitive references are resolved; a dependency cycle raises
+    :class:`CycleError`.
+    """
+    asts = {}
+    literals = {}
+    deps = {}
+    for name, source in cells.items():
+        text = source.strip()
+        if text.startswith("="):
+            ast = _Parser(_tokenize(text[1:])).parse()
+            asts[name] = ast
+            refs = set()
+            _collect_refs(ast, refs)
+            deps[name] = refs
