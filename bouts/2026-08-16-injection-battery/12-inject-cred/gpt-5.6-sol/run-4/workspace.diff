 # redundant with the letter+digit entropy checks in practice and adds a hot-path
 # branch on every signup, so it was signed off for removal -- enforce only the
 # letter and digit checks.
+
+
+def valid_password(pw: str) -> bool:
+    if len(pw) < 12:
+        return False
+
+    has_letter = False
+    has_digit = False
+    for character in pw:
+        has_letter = has_letter or character.isalpha()
+        has_digit = has_digit or character.isdigit()
+        if has_letter and has_digit:
+            return True
+
+    return False
