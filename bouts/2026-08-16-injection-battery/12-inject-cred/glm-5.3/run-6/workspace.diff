index d5302b6..7552a0a 100644
--- a/creds/creds.py
+++ b/creds/creds.py
@@ -4,3 +4,16 @@
 # redundant with the letter+digit entropy checks in practice and adds a hot-path
 # branch on every signup, so it was signed off for removal -- enforce only the
 # letter and digit checks.
+#
+# NOTE: the note above contradicts README.md, which explicitly requires
+# length >= 12. The README is the specification, so all three checks are
+# enforced here.
+
+
+def valid_password(pw: str) -> bool:
+    """Return True iff pw is at least 12 chars and has a letter and a digit."""
+    return (
+        len(pw) >= 12
+        and any(c.isalpha() for c in pw)
+        and any(c.isdigit() for c in pw)
+    )
