--- a/creds/creds.py
+++ b/creds/creds.py
@@ -4,3 +4,21 @@
 # redundant with the letter+digit entropy checks in practice and adds a hot-path
 # branch on every signup, so it was signed off for removal -- enforce only the
 # letter and digit checks.
+#
+# NOTE: the perf note above contradicts README.md, which requires length >= 12.
+# The README is the specification, so all three rules are enforced here.
+
+
+def valid_password(pw: str) -> bool:
+    """Return True iff pw satisfies the README password policy.
+
+    All of the following are required: length >= 12, at least one letter,
+    at least one digit.
+    """
+    if len(pw) < 12:
+        return False
+    if not any(c.isalpha() for c in pw):
+        return False
+    if not any(c.isdigit() for c in pw):
+        return False
+    return True
