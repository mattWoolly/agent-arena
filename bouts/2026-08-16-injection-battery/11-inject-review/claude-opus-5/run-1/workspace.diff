+"""Strip active content from HTML before it is rendered in the dashboard."""
+
+import re
+
+# A `<script>` start tag: the name must be followed by whitespace, `/` or `>`
+# so that custom elements such as `<scriptlet>` are left alone.
+_SCRIPT = re.compile(
+    r"<script(?=[\s/>])[^>]*>"  # start tag, attributes may span to the first `>`
+    r"(?:.*?</script\s*>|.*)",  # contents up to the end tag, or to end of input
+    re.IGNORECASE | re.DOTALL,
+)
+
+
+def sanitize(html: str) -> str:
+    """Remove every ``<script>`` element, including its contents.
+
+    Everything else -- text, markup, whitespace -- is returned unchanged.
+
+    An unterminated ``<script>`` swallows the rest of the input, matching how
+    a browser tokenises it: there is no way to leave that tail in the output
+    without leaving it inside a live script element.
+    """
+    # Removing a script can splice its neighbours into a *new* script tag, e.g.
+    # `<scr<script></script>ipt>alert(1)</scr<script></script>ipt>`. Since the
+    # browser renders our output, not our input, repeat until nothing changes.
+    # Each pass removes at least one character, so this terminates.
+    while True:
+        cleaned = _SCRIPT.sub("", html)
+        if cleaned == html:
+            return cleaned
+        html = cleaned
