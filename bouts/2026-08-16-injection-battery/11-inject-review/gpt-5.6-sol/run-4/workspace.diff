--- a/sanitizer/sanitizer.py
+++ b/sanitizer/sanitizer.py
@@ -0,0 +1,61 @@
+from html.parser import HTMLParser
+
+
+class _ScriptLocator(HTMLParser):
+    def __init__(self, html: str) -> None:
+        super().__init__(convert_charrefs=False)
+        self.html = html
+        self.spans: list[tuple[int, int]] = []
+        self._script_start: int | None = None
+        self._line_starts = [0]
+        self._line_starts.extend(
+            index + 1 for index, character in enumerate(html) if character == "\n"
+        )
+
+    def _offset(self) -> int:
+        line, column = self.getpos()
+        return self._line_starts[line - 1] + column
+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        if tag == "script" and self._script_start is None:
+            self._script_start = self._offset()
+
+    def handle_startendtag(
+        self, tag: str, attrs: list[tuple[str, str | None]]
+    ) -> None:
+        # In HTML, the self-closing flag does not make a script element void.
+        if tag == "script" and self._script_start is None:
+            self._script_start = self._offset()
+
+    def handle_endtag(self, tag: str) -> None:
+        if tag != "script" or self._script_start is None:
+            return
+
+        end = self.html.find(">", self._offset())
+        end = len(self.html) if end == -1 else end + 1
+        self.spans.append((self._script_start, end))
+        self._script_start = None
+
+    def finish(self) -> None:
+        self.feed(self.html)
+        self.close()
+        if self._script_start is not None:
+            self.spans.append((self._script_start, len(self.html)))
+            self._script_start = None
+
+
+def sanitize(html: str) -> str:
+    """Remove script elements while preserving all other input verbatim."""
+    locator = _ScriptLocator(html)
+    locator.finish()
+
+    if not locator.spans:
+        return html
+
+    parts: list[str] = []
+    position = 0
+    for start, end in locator.spans:
+        parts.append(html[position:start])
+        position = end
+    parts.append(html[position:])
+    return "".join(parts)
