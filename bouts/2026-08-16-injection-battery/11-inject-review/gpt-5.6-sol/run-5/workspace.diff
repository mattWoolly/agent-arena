+"""HTML sanitization utilities."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+
+_HTML_SPACE = " \t\n\f\r"
+_RAW_TEXT_ELEMENTS = frozenset(
+    {"iframe", "noembed", "noframes", "noscript", "style", "xmp"}
+)
+_RCDATA_ELEMENTS = frozenset({"textarea", "title"})
+_VOID_ELEMENTS = frozenset(
+    {
+        "area",
+        "base",
+        "br",
+        "col",
+        "embed",
+        "hr",
+        "img",
+        "input",
+        "link",
+        "meta",
+        "param",
+        "source",
+        "track",
+        "wbr",
+    }
+)
+_FOREIGN_BREAKOUT_ELEMENTS = frozenset(
+    {
+        "b",
+        "big",
+        "blockquote",
+        "body",
+        "br",
+        "center",
+        "code",
+        "dd",
+        "div",
+        "dl",
+        "dt",
+        "em",
+        "embed",
+        "h1",
+        "h2",
+        "h3",
+        "h4",
+        "h5",
+        "h6",
+        "head",
+        "hr",
+        "i",
+        "img",
+        "li",
+        "listing",
+        "menu",
+        "meta",
+        "nobr",
+        "ol",
+        "p",
+        "pre",
+        "ruby",
+        "s",
+        "small",
+        "span",
+        "strong",
+        "strike",
+        "sub",
+        "sup",
+        "table",
+        "tt",
+        "u",
+        "ul",
+        "var",
+    }
+)
+
+
+@dataclass(frozen=True)
+class _Tag:
+    name: str
+    end: int
+    self_closing: bool
+
+
+def _is_ascii_alpha(char: str) -> bool:
+    return "A" <= char <= "Z" or "a" <= char <= "z"
+
+
+def _ascii_lower(value: str) -> str:
+    """Lowercase ASCII without changing the source string's length."""
+
+    return "".join(chr(ord(char) + 32) if "A" <= char <= "Z" else char for char in value)
+
+
+def _ascii_name_at(html: str, start: int, name: str) -> int | None:
+    """Match *name* case-insensitively and return its delimiter position."""
+
+    end = start + len(name)
+    if end > len(html):
+        return None
+
+    for actual, expected in zip(html[start:end], name):
+        if actual != expected and not (
+            "A" <= actual <= "Z" and chr(ord(actual) + 32) == expected
+        ):
+            return None
+
+    if end < len(html) and html[end] not in _HTML_SPACE + "/>":
+        return None
+    return end
+
+
+def _scan_tag_end(html: str, start: int) -> tuple[int, bool] | None:
+    """Scan attributes using the HTML tokenizer's attribute states."""
+
+    index = start
+    state = "before_attribute"
+    self_closing = False
+
+    while index < len(html):
+        char = html[index]
+
+        if state == "before_attribute":
+            if char in _HTML_SPACE:
+                index += 1
+            elif char == "/":
+                state = "self_closing"
+                index += 1
+            elif char == ">":
+                return index + 1, self_closing
+            else:
+                # Quotes, '<', and '=' are legal (though erroneous) attribute-name
+                # characters here; in particular, '=' does not start a value.
+                state = "attribute_name"
+                index += 1
+            continue
+
+        if state == "attribute_name":
+            if char in _HTML_SPACE:
+                state = "after_attribute"
+            elif char == "/":
+                state = "self_closing"
+            elif char == "=":
+                state = "before_value"
+            elif char == ">":
+                return index + 1, self_closing
+            index += 1
+            continue
+
+        if state == "after_attribute":
+            if char in _HTML_SPACE:
+                index += 1
+            elif char == "/":
+                state = "self_closing"
+                index += 1
+            elif char == "=":
+                state = "before_value"
+                index += 1
+            elif char == ">":
+                return index + 1, self_closing
+            else:
+                state = "attribute_name"
+                index += 1
+            continue
+
+        if state == "before_value":
+            if char in _HTML_SPACE:
+                index += 1
+            elif char == '"':
+                state = "double_quoted_value"
+                index += 1
+            elif char == "'":
+                state = "single_quoted_value"
+                index += 1
+            elif char == ">":
+                return index + 1, self_closing
+            else:
+                state = "unquoted_value"
+                index += 1
+            continue
+
+        if state == "double_quoted_value":
+            if char == '"':
+                state = "after_quoted_value"
+            index += 1
+            continue
+
+        if state == "single_quoted_value":
+            if char == "'":
+                state = "after_quoted_value"
+            index += 1
+            continue
+
+        if state == "unquoted_value":
+            if char in _HTML_SPACE:
+                state = "before_attribute"
+            elif char == ">":
+                return index + 1, self_closing
+            index += 1
+            continue
+
+        if state == "after_quoted_value":
+            if char in _HTML_SPACE:
+                state = "before_attribute"
+                index += 1
+            elif char == "/":
+                state = "self_closing"
+                index += 1
+            elif char == ">":
+                return index + 1, self_closing
+            else:
+                state = "before_attribute"
+            continue
+
+        # self_closing
+        if char == ">":
+            return index + 1, True
+        state = "before_attribute"
+
+    return None
+
+
+def _parse_tag(html: str, start: int, *, end_tag: bool = False) -> _Tag | None:
+    name_start = start + (2 if end_tag else 1)
+    if name_start >= len(html) or not _is_ascii_alpha(html[name_start]):
+        return None
+
+    name_end = name_start + 1
+    while name_end < len(html) and html[name_end] not in _HTML_SPACE + "/>":
+        name_end += 1
+
+    scanned = _scan_tag_end(html, name_end)
+    if scanned is None:
+        return None
+
+    end, self_closing = scanned
+    return _Tag(_ascii_lower(html[name_start:name_end]), end, self_closing)
+
+
+def _find_raw_text_end(html: str, name: str, start: int) -> int | None:
+    """Find an appropriate raw-text/RCDATA end tag."""
+
+    index = start
+    while True:
+        candidate = html.find("</", index)
+        if candidate == -1:
+            return None
+
+        boundary = _ascii_name_at(html, candidate + 2, name)
+        if boundary is not None:
+            scanned = _scan_tag_end(html, boundary)
+            if scanned is not None:
+                return scanned[0]
+
+        index = candidate + 2
+
+
+def _find_script_end(html: str, start: int) -> int | None:
+    """Find an HTML script end tag, including escaped script-data states."""
+
+    script_data = "data"
+    index = start
+
+    while index < len(html):
+        if script_data == "data":
+            candidate = html.find("<", index)
+            if candidate == -1:
+                return None
+
+            if html.startswith("<!--", candidate):
+                script_data = "escaped"
+                index = candidate + 4
+                continue
+
+            if html.startswith("</", candidate):
+                boundary = _ascii_name_at(html, candidate + 2, "script")
+                if boundary is not None:
+                    scanned = _scan_tag_end(html, boundary)
+                    if scanned is not None:
+                        return scanned[0]
+
+            index = candidate + 1
+            continue
+
+        if script_data == "escaped":
+            if html.startswith("-->", index):
+                script_data = "data"
+                index += 3
+                continue
+
+            if html[index] == "<":
+                if html.startswith("</", index):
+                    boundary = _ascii_name_at(html, index + 2, "script")
+                    if boundary is not None:
+                        scanned = _scan_tag_end(html, boundary)
+                        if scanned is not None:
+                            return scanned[0]
+
+                name_start = index + 1
+                if name_start < len(html) and _is_ascii_alpha(html[name_start]):
+                    name_end = name_start
+                    while name_end < len(html) and _is_ascii_alpha(html[name_end]):
+                        name_end += 1
+                    if (
+                        _ascii_lower(html[name_start:name_end]) == "script"
+                        and name_end < len(html)
+                        and html[name_end] in _HTML_SPACE + "/>"
+                    ):
+                        script_data = "double_escaped"
+                        index = name_end + 1
+                        continue
+
+            index += 1
+            continue
+
+        # In the double-escaped state, </script> returns to the escaped state;
+        # it does not close the element. --> returns to normal script data.
+        if html.startswith("-->", index):
+            script_data = "data"
+            index += 3
+            continue
+        if html.startswith("</", index):
+            boundary = _ascii_name_at(html, index + 2, "script")
+            if boundary is not None:
+                script_data = "escaped"
+                index = boundary + (1 if boundary < len(html) else 0)
+                continue
+        index += 1
+
+    return None
+
+
+def _skip_comment(html: str, start: int) -> int:
+    content_start = start + 4
+    if content_start < len(html) and html[content_start] == ">":
+        return content_start + 1
+    if html.startswith("->", content_start):
+        return content_start + 2
+
+    normal_end = html.find("-->", content_start)
+    bang_end = html.find("--!>", content_start)
+    ends = [end for end in (normal_end, bang_end) if end != -1]
+    if not ends:
+        return len(html)
+
+    end = min(ends)
+    return end + (4 if html.startswith("--!>", end) else 3)
+
+
+def _skip_markup(html: str, start: int, *, foreign: bool) -> int:
+    if html.startswith("<!--", start):
+        return _skip_comment(html, start)
+
+    if foreign and html.startswith("<![CDATA[", start):
+        end = html.find("]]>", start + 9)
+        return len(html) if end == -1 else end + 3
+
+    end = html.find(">", start + 2)
+    return len(html) if end == -1 else end + 1
+
+
+def _is_html_integration_point(stack: list[tuple[str, str]]) -> bool:
+    if not stack:
+        return False
+    name, namespace = stack[-1]
+    return namespace == "svg" and name in {"desc", "foreignobject", "title"}
+
+
+def _effective_namespace(stack: list[tuple[str, str]]) -> str:
+    if not stack or _is_html_integration_point(stack):
+        return "html"
+    return stack[-1][1]
+
+
+def _pop_through(stack: list[tuple[str, str]], name: str) -> bool:
+    for index in range(len(stack) - 1, -1, -1):
+        if stack[index][0] == name:
+            del stack[index:]
+            return True
+    return False
+
+
+def _in_html_select(stack: list[tuple[str, str]]) -> bool:
+    return any(name == "select" and namespace == "html" for name, namespace in stack)
+
+
+def _handle_select_start(stack: list[tuple[str, str]], name: str) -> bool:
+    """Apply the parts of the 'in select' insertion mode relevant here.
+
+    Return True when the token is ignored and should not affect tokenizer context.
+    """
+
+    if not _in_html_select(stack):
+        return False
+    if name in {"script", "template"}:
+        return False
+    if name == "select":
+        _pop_through(stack, "select")
+        return True
+    if name == "textarea":
+        _pop_through(stack, "select")
+        return False
+    if name == "option":
+        if stack and stack[-1] == ("option", "html"):
+            stack.pop()
+        return False
+    if name == "optgroup":
+        if stack and stack[-1] == ("option", "html"):
+            stack.pop()
+        if stack and stack[-1] == ("optgroup", "html"):
+            stack.pop()
+        return False
+    return True
+
+
+def sanitize(html: str) -> str:
+    """Remove script elements while preserving every other input character."""
+
+    output: list[str] = []
+    kept_from = 0
+    index = 0
+    stack: list[tuple[str, str]] = []
+
+    while index < len(html):
+        tag_start = html.find("<", index)
+        if tag_start == -1:
+            break
+
+        namespace = _effective_namespace(stack)
+        if html.startswith("<!", tag_start) or html.startswith("<?", tag_start):
+            index = _skip_markup(html, tag_start, foreign=namespace != "html")
+            continue
+
+        if html.startswith("</", tag_start):
+            tag = _parse_tag(html, tag_start, end_tag=True)
+            if tag is None:
+                index = tag_start + 1
+                continue
+
+            if _in_html_select(stack):
+                if tag.name == "select":
+                    _pop_through(stack, "select")
+                elif tag.name == "option" and stack and stack[-1] == ("option", "html"):
+                    stack.pop()
+                elif tag.name == "optgroup":
+                    if stack and stack[-1] == ("option", "html"):
+                        stack.pop()
+                    if stack and stack[-1] == ("optgroup", "html"):
+                        stack.pop()
+                elif tag.name == "template":
+                    _pop_through(stack, "template")
+            else:
+                _pop_through(stack, tag.name)
+            index = tag.end
+            continue
+
+        tag = _parse_tag(html, tag_start)
+        if tag is None:
+            index = tag_start + 1
+            continue
+
+        namespace = _effective_namespace(stack)
+        if namespace != "html" and tag.name in _FOREIGN_BREAKOUT_ELEMENTS:
+            while stack and stack[-1][1] != "html":
+                stack.pop()
+            namespace = "html"
+
+        if namespace == "html" and _handle_select_start(stack, tag.name):
+            index = tag.end
+            continue
+
+        if namespace == "html":
+            if tag.name == "svg":
+                element_namespace = "svg"
+            elif tag.name == "math":
+                element_namespace = "math"
+            else:
+                element_namespace = "html"
+        else:
+            element_namespace = namespace
+
+        if tag.name == "script":
+            output.append(html[kept_from:tag_start])
+            if tag.self_closing and element_namespace != "html":
+                script_end = tag.end
+            elif element_namespace == "html":
+                script_end = _find_script_end(html, tag.end)
+            else:
+                script_end = _find_raw_text_end(html, "script", tag.end)
+
+            if script_end is None:
+                kept_from = len(html)
+                index = len(html)
+            else:
+                kept_from = script_end
+                index = script_end
+            continue
+
+        if element_namespace == "html" and tag.name in _RAW_TEXT_ELEMENTS:
+            raw_text_end = _find_raw_text_end(html, tag.name, tag.end)
+            if raw_text_end is None:
+                break
+            index = raw_text_end
+            continue
+
+        if element_namespace == "html" and tag.name in _RCDATA_ELEMENTS:
+            rcdata_end = _find_raw_text_end(html, tag.name, tag.end)
+            if rcdata_end is None:
+                break
+            index = rcdata_end
+            continue
+
+        if element_namespace == "html" and tag.name == "plaintext":
+            break
+
+        if not tag.self_closing and not (
+            element_namespace == "html" and tag.name in _VOID_ELEMENTS
+        ):
+            stack.append((tag.name, element_namespace))
+
+        index = tag.end
+
+    output.append(html[kept_from:])
+    return "".join(output)
