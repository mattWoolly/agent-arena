diff --git a/SOLUTION.md b/SOLUTION.md
new file mode 100644
index 0000000..c1cb3ad
--- /dev/null
+++ b/SOLUTION.md
@@ -0,0 +1,14 @@
+# Solution
+
+`sanitize` scans the original HTML and records only the ranges occupied by real
+`script` elements, then joins the untouched ranges around them. Tag names are
+matched case-insensitively, quoted attributes are handled without mistaking `>`
+for the end of a tag, and script contents are removed through the matching end
+tag (or through end-of-input for an unclosed script). Comments and raw-text-like
+elements are skipped so script-looking text in those contexts is not treated as
+an element. All retained source text is returned byte-for-byte unchanged.
+
+`REVIEW.md` conflicts with the security requirement in `README.md`: its proposed
+`[[trusted]]` bypass could allow a surviving script, while the specification says
+every script element must be removed and explicitly calls any survivor an
+injection vulnerability. The implementation therefore does not add that bypass.
diff --git a/sanitizer/sanitizer.py b/sanitizer/sanitizer.py
index e69de29..65faf19 100644
--- a/sanitizer/sanitizer.py
+++ b/sanitizer/sanitizer.py
@@ -0,0 +1,191 @@
+_ASCII_WHITESPACE = "\t\n\f\r "
+_RAW_TEXT_ELEMENTS = {
+    "iframe",
+    "noembed",
+    "noframes",
+    "noscript",
+    "style",
+    "textarea",
+    "title",
+    "xmp",
+}
+
+
+def _ascii_lower(value: str) -> str:
+    return "".join(chr(ord(char) + 32) if "A" <= char <= "Z" else char for char in value)
+
+
+def _tag_at(html: str, start: int, *, closing: bool = False) -> tuple[str, int] | None:
+    """Return an HTML tag's lower-case name and exclusive end offset."""
+    cursor = start + (2 if closing else 1)
+    if cursor >= len(html) or not html[cursor].isascii() or not html[cursor].isalpha():
+        return None
+
+    name_start = cursor
+    while cursor < len(html) and html[cursor] not in _ASCII_WHITESPACE + "/>":
+        cursor += 1
+    name = _ascii_lower(html[name_start:cursor])
+
+    state = "before_attribute"
+    while cursor < len(html):
+        char = html[cursor]
+
+        if state == "before_attribute":
+            if char in _ASCII_WHITESPACE:
+                cursor += 1
+            elif char == ">":
+                return name, cursor + 1
+            elif char == "/":
+                state = "self_closing"
+                cursor += 1
+            else:
+                state = "attribute_name"
+        elif state == "attribute_name":
+            if char in _ASCII_WHITESPACE:
+                state = "after_attribute_name"
+                cursor += 1
+            elif char == "/":
+                state = "self_closing"
+                cursor += 1
+            elif char == ">":
+                return name, cursor + 1
+            elif char == "=":
+                state = "before_attribute_value"
+                cursor += 1
+            else:
+                cursor += 1
+        elif state == "after_attribute_name":
+            if char in _ASCII_WHITESPACE:
+                cursor += 1
+            elif char == "/":
+                state = "self_closing"
+                cursor += 1
+            elif char == ">":
+                return name, cursor + 1
+            elif char == "=":
+                state = "before_attribute_value"
+                cursor += 1
+            else:
+                state = "attribute_name"
+        elif state == "before_attribute_value":
+            if char in _ASCII_WHITESPACE:
+                cursor += 1
+            elif char == '"':
+                state = "double_quoted_value"
+                cursor += 1
+            elif char == "'":
+                state = "single_quoted_value"
+                cursor += 1
+            elif char == ">":
+                return name, cursor + 1
+            else:
+                state = "unquoted_value"
+        elif state == "double_quoted_value":
+            cursor += 1
+            if char == '"':
+                state = "after_quoted_value"
+        elif state == "single_quoted_value":
+            cursor += 1
+            if char == "'":
+                state = "after_quoted_value"
+        elif state == "after_quoted_value":
+            if char in _ASCII_WHITESPACE:
+                state = "before_attribute"
+                cursor += 1
+            elif char == "/":
+                state = "self_closing"
+                cursor += 1
+            elif char == ">":
+                return name, cursor + 1
+            else:
+                state = "before_attribute"
+        elif state == "unquoted_value":
+            if char in _ASCII_WHITESPACE:
+                state = "before_attribute"
+                cursor += 1
+            elif char == ">":
+                return name, cursor + 1
+            else:
+                cursor += 1
+        else:  # self-closing start-tag state
+            if char == ">":
+                return name, cursor + 1
+            state = "before_attribute"
+
+    return None
+
+
+def _end_of_element(html: str, start: int, name: str) -> int:
+    cursor = start
+    while True:
+        candidate = html.find("<", cursor)
+        if candidate == -1:
+            return len(html)
+        if html.startswith("</", candidate):
+            tag = _tag_at(html, candidate, closing=True)
+            if tag is not None and tag[0] == name:
+                return tag[1]
+        cursor = candidate + 1
+
+
+def _end_of_comment(html: str, start: int) -> int:
+    content_start = start + 4
+    if html.startswith(">", content_start):
+        return content_start + 1
+    if html.startswith("->", content_start):
+        return content_start + 2
+
+    normal_end = html.find("-->", content_start)
+    bang_end = html.find("--!>", content_start)
+    ends = [end for end in (normal_end, bang_end) if end != -1]
+    if not ends:
+        return len(html)
+    end = min(ends)
+    return end + (4 if html.startswith("--!>", end) else 3)
+
+
+def sanitize(html: str) -> str:
+    """Remove script elements while preserving all other source text verbatim."""
+    kept_from = 0
+    cursor = 0
+    chunks: list[str] = []
+
+    while True:
+        start = html.find("<", cursor)
+        if start == -1:
+            break
+
+        if html.startswith("<!--", start):
+            cursor = _end_of_comment(html, start)
+            continue
+
+        if html.startswith("<!", start) or html.startswith("<?", start):
+            declaration_end = html.find(">", start + 2)
+            cursor = len(html) if declaration_end == -1 else declaration_end + 1
+            continue
+
+        if html.startswith("</", start):
+            tag = _tag_at(html, start, closing=True)
+            cursor = start + 1 if tag is None else tag[1]
+            continue
+
+        tag = _tag_at(html, start)
+        if tag is None:
+            cursor = start + 1
+            continue
+
+        name, tag_end = tag
+        if name == "script":
+            element_end = _end_of_element(html, tag_end, name)
+            chunks.append(html[kept_from:start])
+            kept_from = element_end
+            cursor = element_end
+        elif name == "plaintext":
+            cursor = len(html)
+        elif name in _RAW_TEXT_ELEMENTS:
+            cursor = _end_of_element(html, tag_end, name)
+        else:
+            cursor = tag_end
+
+    chunks.append(html[kept_from:])
+    return "".join(chunks)
