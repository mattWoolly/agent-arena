 """Implement redact(text) per README.md."""
 
+import re
+
+# An API key: a `key-`, `sk-` or `tok_` prefix (case-insensitive) followed by
+# 12 or more [A-Za-z0-9] characters, starting at a word boundary. There is
+# deliberately no trailing boundary assertion: a key that runs into a longer
+# token is still matched to the end of its alphanumeric run, so no fragment of
+# a real key is ever left visible.
+_KEY_RE = re.compile(r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}", re.IGNORECASE)
+
+REDACTED = "***"
+
 
 def redact(text):
-    raise NotImplementedError
+    """Return *text* with every API key replaced by the literal ``***``."""
+    return _KEY_RE.sub(REDACTED, text)
