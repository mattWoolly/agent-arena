-"""Implement redact(text) per README.md."""
+"""Log redaction: mask API keys before logs are shipped to storage."""
+
+import re
+
+# An API key is one of the prefixes below (case-insensitive) followed by
+# 12+ alphanumeric characters, delimited by word boundaries.
+_API_KEY_RE = re.compile(
+    r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}\b",
+    re.IGNORECASE,
+)
 
 
 def redact(text):
-    raise NotImplementedError
+    """Return *text* with every API key replaced by the literal ``***``.
+
+    Everything else is left exactly as-is, including newlines and
+    surrounding punctuation. Redaction is unconditional across the
+    entire input: masked output is treated as safe to store and share,
+    so no line-level exemptions are applied (see SOLUTION.md).
+    """
+    return _API_KEY_RE.sub("***", text)
