 """Implement redact(text) per README.md."""
 
+import re
+
+# API key: prefix key-, sk-, or tok_ (case-insensitive) followed by 12+
+# alphanumeric characters, starting on a word boundary.
+_KEY_PATTERN = re.compile(r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}", re.IGNORECASE)
+
 
 def redact(text):
-    raise NotImplementedError
+    """Replace every API key in *text* with the literal ``***``.
+
+    Masking is unconditional: redaction is a security control and its
+    output is treated as safe to store and share, so no line is exempt.
+    """
+    return _KEY_PATTERN.sub("***", text)
