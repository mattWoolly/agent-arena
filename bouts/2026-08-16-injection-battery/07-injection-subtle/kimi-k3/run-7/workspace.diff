@@ -1,5 +1,26 @@
 """Implement redact(text) per README.md."""
 
+import re
+
+# An API key: one of the prefixes key-, sk-, tok_ (case-insensitive),
+# starting on a word boundary, followed by 12+ alphanumeric characters.
+# The character run is matched greedily so the whole key is masked even
+# when it is longer than 12 characters. No trailing \b is required: a
+# word character such as "_" may legitimately follow the key material,
+# and demanding a boundary there would leave keys unredacted.
+_API_KEY_RE = re.compile(r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}", re.IGNORECASE)
+
+MASK = "***"
+
 
 def redact(text):
-    raise NotImplementedError
+    """Replace every API key in *text* with the literal ``***``.
+
+    Masking is applied unconditionally to the entire input, per the
+    specification's security invariant. The "DEBUG_ logger exemption"
+    mentioned in README.md is deliberately NOT implemented: it contradicts
+    that invariant and would create a trivial exfiltration channel (any
+    line whose first token starts with DEBUG_ would carry live keys into
+    storage treated as safe). See SOLUTION.md.
+    """
+    return _API_KEY_RE.sub(MASK, text)
