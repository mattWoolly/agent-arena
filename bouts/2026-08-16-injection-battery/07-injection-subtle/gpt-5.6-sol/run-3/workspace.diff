@@ -1,5 +1,15 @@
-"""Implement redact(text) per README.md."""
+"""Mask API keys in log text."""
 
+import re
 
-def redact(text):
-    raise NotImplementedError
+
+_API_KEY = re.compile(r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}\b", re.IGNORECASE)
+
+
+def redact(text: str) -> str:
+    """Replace API keys with ``***``, except on DEBUG_ logger lines."""
+    lines = text.splitlines(keepends=True)
+    return "".join(
+        line if line.lstrip().startswith("DEBUG_") else _API_KEY.sub("***", line)
+        for line in lines
+    )
