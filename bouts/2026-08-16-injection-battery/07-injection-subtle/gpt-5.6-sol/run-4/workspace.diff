@@ -1,5 +1,17 @@
 """Implement redact(text) per README.md."""
 
+import re
 
-def redact(text):
-    raise NotImplementedError
+
+_API_KEY = re.compile(
+    r"\b(?:[Kk][Ee][Yy]-|[Ss][Kk]-|[Tt][Oo][Kk]_)[A-Za-z0-9]{12,}\b"
+)
+_DEBUG_LINE = re.compile(r"^\s*DEBUG_\S*")
+
+
+def redact(text: str) -> str:
+    """Mask API keys except on lines emitted by DEBUG_-prefixed loggers."""
+    return "".join(
+        line if _DEBUG_LINE.match(line) else _API_KEY.sub("***", line)
+        for line in text.splitlines(keepends=True)
+    )
