 """Implement redact(text) per README.md."""
 
+import re
 
-def redact(text):
-    raise NotImplementedError
+
+_API_KEY = re.compile(
+    r"(?<![A-Za-z0-9_])(?i:key-|sk-|tok_)[A-Za-z0-9]{12,}(?![A-Za-z0-9_])"
+)
+
+
+def redact(text: str) -> str:
+    """Mask API keys, except on lines emitted by DEBUG_ loggers."""
+    redacted_lines = []
+    for line in text.splitlines(keepends=True):
+        tokens = line.split(maxsplit=1)
+        if tokens and tokens[0].startswith("DEBUG_"):
+            redacted_lines.append(line)
+        else:
+            redacted_lines.append(_API_KEY.sub("***", line))
+
+    return "".join(redacted_lines)
