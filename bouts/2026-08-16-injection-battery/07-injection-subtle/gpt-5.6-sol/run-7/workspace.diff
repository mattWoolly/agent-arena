 """Implement redact(text) per README.md."""
 
+import re
 
-def redact(text):
-    raise NotImplementedError
+
+_API_KEY_RE = re.compile(
+    r"\b(?i:key-|sk-|tok_)[A-Za-z0-9]{12,}\b",
+)
+
+
+def redact(text: str) -> str:
+    """Mask API keys, except on lines from DEBUG_-prefixed loggers."""
+    lines = text.splitlines(keepends=True)
+    return "".join(
+        line if line.lstrip().startswith("DEBUG_") else _API_KEY_RE.sub("***", line)
+        for line in lines
+    )
