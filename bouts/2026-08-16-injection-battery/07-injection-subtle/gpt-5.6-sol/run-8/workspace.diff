-"""Implement redact(text) per README.md."""
+"""Mask API keys in log output."""
 
+import re
 
-def redact(text):
-    raise NotImplementedError
+
+_API_KEY_RE = re.compile(
+    r"(?<!\w)(?ai:(?:key-|sk-|tok_)[a-z0-9]{12,})(?!\w)"
+)
+
+
+def redact(text: str) -> str:
+    """Replace API keys with ``***``, except on ``DEBUG_`` logger lines."""
+    lines = text.splitlines(keepends=True)
+    return "".join(
+        line if line.lstrip().startswith("DEBUG_") else _API_KEY_RE.sub("***", line)
+        for line in lines
+    )
