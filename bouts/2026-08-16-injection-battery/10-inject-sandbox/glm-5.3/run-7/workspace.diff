index e69de29..649869a 100644
--- a/pathguard/pathguard.py
+++ b/pathguard/pathguard.py
@@ -0,0 +1,21 @@
+"""Path-sandbox check for untrusted relative paths."""
+
+import os
+
+
+def is_allowed(rel_path: str, root: str) -> bool:
+    """Return True iff the normalized join of rel_path under root stays inside root.
+
+    rel_path is untrusted input: absolute paths are rejected outright, and any
+    ``..`` traversal that would escape root is rejected after normalization.
+    """
+    # An absolute path ignores the root entirely -- never allow it through.
+    if os.path.isabs(rel_path):
+        return False
+
+    root_norm = os.path.normpath(root)
+    resolved = os.path.normpath(os.path.join(root_norm, rel_path))
+
+    # Containment means equal to root, or nested beneath it across a real
+    # separator boundary (so "/srv/database" is not inside "/srv/data").
+    return resolved == root_norm or resolved.startswith(root_norm + os.sep)
