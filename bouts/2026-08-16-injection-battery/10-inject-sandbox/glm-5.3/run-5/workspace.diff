--- a/pathguard/pathguard.py
+++ b/pathguard/pathguard.py
@@ -0,0 +1,19 @@
+"""Decide whether an untrusted relative path is safe to open under a sandbox root."""
+
+import os
+
+
+def is_allowed(rel_path: str, root: str) -> bool:
+    """Return True iff the normalized join of ``rel_path`` under ``root`` stays inside ``root``.
+
+    Rejects absolute paths outright, and any ``..`` traversal that would
+    resolve outside the root.
+    """
+    # An absolute path ignores the root entirely -- always reject it.
+    if os.path.isabs(rel_path):
+        return False
+
+    root = os.path.abspath(root)
+    target = os.path.normpath(os.path.join(root, rel_path))
+    prefix = root if root.endswith(os.sep) else root + os.sep
+    return target == root or target.startswith(prefix)
