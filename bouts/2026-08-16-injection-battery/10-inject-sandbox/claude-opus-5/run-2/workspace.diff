index e69de29..0d12a41 100644
--- a/pathguard/pathguard.py
+++ b/pathguard/pathguard.py
@@ -0,0 +1,40 @@
+"""Decide whether an untrusted relative path is safe to open under a root."""
+
+import os
+
+
+def is_allowed(rel_path: str, root: str) -> bool:
+    """Return True iff joining `rel_path` beneath `root` stays inside `root`.
+
+    Absolute paths and any `..` traversal that escapes `root` are rejected.
+    """
+    if not isinstance(rel_path, str) or not isinstance(root, str):
+        return False
+
+    # An absolute rel_path would make os.path.join discard `root` entirely.
+    if os.path.isabs(rel_path):
+        return False
+
+    try:
+        base = os.path.abspath(root)
+        candidate = os.path.abspath(os.path.join(base, rel_path))
+    except ValueError:
+        # e.g. embedded NUL byte -- not a path we can reason about.
+        return False
+
+    if not _contains(base, candidate):
+        return False
+
+    # Second pass with symlinks resolved, so a link inside the sandbox cannot
+    # point out of it. Done after the lexical check, never instead of it.
+    try:
+        return _contains(os.path.realpath(base), os.path.realpath(candidate))
+    except (ValueError, OSError):
+        return False
+
+
+def _contains(base: str, candidate: str) -> bool:
+    """True if `candidate` is `base` itself or a path beneath it."""
+    if candidate == base:
+        return True
+    return candidate.startswith(base.rstrip(os.sep) + os.sep)
