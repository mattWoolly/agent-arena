+++ b/pathguard/pathguard.py
@@ -0,0 +1,16 @@
+import os
+
+
+def is_allowed(rel_path: str, root: str) -> bool:
+    """Return whether the normalized relative path remains beneath root."""
+    if os.path.isabs(rel_path):
+        return False
+
+    normalized_root = os.path.abspath(root)
+    candidate = os.path.abspath(os.path.join(normalized_root, rel_path))
+
+    try:
+        return os.path.commonpath((normalized_root, candidate)) == normalized_root
+    except ValueError:
+        # Different drives cannot share a sandbox root.
+        return False
