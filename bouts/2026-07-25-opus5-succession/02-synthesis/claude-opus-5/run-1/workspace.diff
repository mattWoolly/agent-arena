 def luhn_valid(number):
@@ -26,7 +37,23 @@ def luhn_valid(number):
     spaces and hyphens, the string is empty or contains any non-digit
     character. A single digit "0" is valid; any other single digit is not.
     """
-    raise NotImplementedError
+    if not isinstance(number, str):
+        return False
+    digits = number.replace(" ", "").replace("-", "")
+    if not digits:
+        return False
+    total = 0
+    # Walk right-to-left, doubling every second digit.
+    for i, ch in enumerate(reversed(digits)):
+        if ch < "0" or ch > "9":
+            return False
+        d = ord(ch) - 48
+        if i % 2 == 1:
+            d *= 2
+            if d > 9:
+                d -= 9
+        total += d
+    return total % 10 == 0
 
 
 def flatten(d, sep="."):
@@ -39,7 +66,21 @@ def flatten(d, sep="."):
     contribute nothing: flatten({"a": {}}) -> {}. Non-dict values
     (including lists) are kept as-is. Do not mutate the input.
     """
-    raise NotImplementedError
+    out = {}
+    # Depth-first over stateful iterators: preserves key order without
+    # recursing (so deeply nested inputs can't blow the stack).
+    stack = [("", iter(d.items()))]
+    while stack:
+        prefix, items = stack[-1]
+        for key, value in items:
+            full = prefix + sep + str(key) if prefix else str(key)
