-    raise NotImplementedError
+    if not isinstance(s, str):
+        raise ValueError("duration must be a string, got %r" % (type(s).__name__,))
+    # The units are optional but ordered, so the regex itself rejects
+    # out-of-order, duplicated, unknown, and unnumbered units; a fullmatch
+    # rejects whitespace and trailing garbage. Only "" matches with no group.
+    match = _DURATION_RE.fullmatch(s)
