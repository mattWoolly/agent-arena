+    # front is always the max of the current window.
+    candidates = deque()
+    for i, n in enumerate(nums):
+        while candidates and nums[candidates[-1]] <= n:
+            candidates.pop()
+        candidates.append(i)
+        if candidates[0] <= i - window:
+            candidates.popleft()
