 def rolling_max(nums, window):
@@ -65,4 +111,20 @@ def rolling_max(nums, window):
     Must run in O(n) time (use a deque-based approach, not max() per
     window) — it will be tested on a large input with a tight time budget.
     """
-    raise NotImplementedError
+    if window <= 0:
+        raise ValueError("window must be positive, got %r" % (window,))
+    if window > len(nums):
+        return []
+    out = []
+    # (index, value) pairs with strictly decreasing values; the leftmost is
+    # the max of the current window.
+    dq = deque()
+    for i, v in enumerate(nums):
+        while dq and dq[-1][1] <= v:
+            dq.pop()
+        dq.append((i, v))
+        if dq[0][0] <= i - window:
+            dq.popleft()
+        if i >= window - 1:
+            out.append(dq[0][1])
+    return out
