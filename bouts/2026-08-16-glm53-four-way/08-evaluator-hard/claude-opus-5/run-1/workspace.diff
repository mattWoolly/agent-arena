+def _parse_cell(text):
+    """Parse one raw cell value into an AST."""
+    body = text.strip() if isinstance(text, str) else text
+    if not isinstance(body, str):
+        # Tolerate a cell already given as a number.
+        return ("num", float(body))
+    if body.startswith("="):
+        body = body[1:]
+    elif body == "":
+        return ("num", 0.0)
+    return _Parser(_tokenize(body), text).parse()
