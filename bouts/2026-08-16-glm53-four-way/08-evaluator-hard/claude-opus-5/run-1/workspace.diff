+
+def _refs(node, out):
+    """Collect referenced cell names, in first-appearance order."""
+    stack = [node]
+    while stack:
+        current = stack.pop()
+        tag = current[0]
+        if tag == "ref":
+            out.append(current[1])
+        elif tag == "bin":
+            stack.append(current[3])
+            stack.append(current[2])
+        elif tag == "neg":
+            stack.append(current[1])
+    return out
+
+
+def _order(asts):
+    """Return cell names in dependency order, raising CycleError on a cycle.
+
+    Iterative so that long reference chains do not hit Python's recursion
+    limit.
+    """
+    done = set()
+    on_path = set()
+    order = []
+    for root in asts:
+        if root in done:
+            continue
+        # Each frame is [name, deps, index-of-next-dep-to-visit].
+        stack = [[root, _refs(asts[root], []), 0]]
+        on_path.add(root)
+        while stack:
+            frame = stack[-1]
+            name, deps, index = frame
+            if index == len(deps):
+                stack.pop()
+                on_path.discard(name)
+                done.add(name)
+                order.append(name)
+                continue
+            frame[2] += 1
+            dep = deps[index]
+            if dep in done:
+                continue
+            if dep in on_path:
+                raise CycleError(
+                    "cycle detected: %s" % " -> ".join(
+                        [f[0] for f in stack] + [dep]
+                    )
+                )
+            if dep not in asts:
+                raise KeyError("unknown cell %r referenced by %r" % (dep, name))
+            on_path.add(dep)
+            stack.append([dep, _refs(asts[dep], []), 0])
+    return order
+
+
+def _eval(node, values):
+    """Evaluate an AST whose references are all present in `values`."""
+    tag = node[0]
+    if tag == "num":
+        return node[1]
+    if tag == "ref":
+        return values[node[1]]
+    if tag == "neg":
+        return -_eval(node[1], values)
+    op = node[1]
+    left = _eval(node[2], values)
+    right = _eval(node[3], values)
+    if op == "+":
+        return left + right
+    if op == "-":
+        return left - right
+    if op == "*":
+        return left * right
+    if op == "/":
+        if right == 0:
+            raise ZeroDivisionError("float division by zero")
+        return left / right
+    return float(left ** right)
 
 
