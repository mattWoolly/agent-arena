+
+_NUMBER, _NAME, _OP, _END = "number", "name", "op", "end"
+
+
+def _tokenize(text):
+    """Turn a formula body into a list of (kind, value) pairs."""
+    tokens = []
+    pos = 0
+    end = len(text)
+    while pos < end:
+        match = _TOKEN_RE.match(text, pos)
+        if match is None:
+            if text[pos].isspace():
+                pos += 1
+                continue
+            raise ValueError("unexpected character %r in %r" % (text[pos], text))
+        pos = match.end()
+        kind = match.lastgroup
+        tokens.append((kind, match.group(kind)))
+    tokens.append((_END, None))
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser producing tuple ASTs.
+
+    expr   := term (('+' | '-') term)*
+    term   := factor (('*' | '/') factor)*
+    factor := ('-' | '+') factor | power
+    power  := atom ('^' factor)?
+    atom   := number | name | '(' expr ')'
+
+    Unary minus sits above '^' in `factor`, so `-2^2` parses as `-(2^2)`.
+    The right operand of '^' is a `factor`, which makes '^' right-associative
+    and also allows a signed exponent (`2^-1`).
+    """
+
+    def __init__(self, tokens, source):
+        self.tokens = tokens
+        self.source = source
+        self.pos = 0
+
+    def peek(self):
+        return self.tokens[self.pos]
+
+    def advance(self):
+        token = self.tokens[self.pos]
+        self.pos += 1
+        return token
+
+    def error(self, message):
+        return ValueError("%s in %r" % (message, self.source))
+
+    def parse(self):
+        node = self.expr()
+        kind, value = self.peek()
+        if kind != _END:
+            raise self.error("unexpected token %r" % (value,))
+        return node
+
+    def expr(self):
+        node = self.term()
+        while self.peek() == (_OP, "+") or self.peek() == (_OP, "-"):
+            op = self.advance()[1]
+            node = ("bin", op, node, self.term())
+        return node
+
+    def term(self):
+        node = self.factor()
+        while self.peek() == (_OP, "*") or self.peek() == (_OP, "/"):
+            op = self.advance()[1]
+            node = ("bin", op, node, self.factor())
+        return node
+
+    def factor(self):
+        kind, value = self.peek()
+        if kind == _OP and value in ("-", "+"):
+            self.advance()
