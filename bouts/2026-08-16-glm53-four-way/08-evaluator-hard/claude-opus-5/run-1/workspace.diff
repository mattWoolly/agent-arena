+_TOKEN_RE = re.compile(
+    r"""
+    \s*(?:
+        (?P<number>\d+\.\d*|\.\d+|\d+)
+      | (?P<name>[A-Za-z]+[0-9]*)
+      | (?P<op>[-+*/^()])
+    )
+    """,
+    re.VERBOSE,
