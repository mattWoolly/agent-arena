+"""A small spreadsheet formula engine.
+
+See README.md for the semantics. The public surface is :func:`evaluate` and
+:class:`CycleError`.
+"""
+
+import re
+
+__all__ = ["evaluate", "CycleError"]
 
 
 class CycleError(Exception):
-    pass
+    """Raised when cells reference each other in a cycle."""
+
+
+# --------------------------------------------------------------------------
+# Tokenizer
+# --------------------------------------------------------------------------
+
+_TOKEN_RE = re.compile(
+    r"""
+    \s*(?:
+        (?P<number>(?:\d+\.\d*|\.\d+|\d+))   # 1, 1.5, 1., .5
+      | (?P<name>[A-Za-z]+\d*)               # A, B2, TOTAL, X12
+      | (?P<op>[-+*/^()])
+    )
+    """,
+    re.VERBOSE,
+)
+
+
+def _tokenize(text):
+    """Yield (kind, value) pairs; raise ValueError on unknown characters."""
+    tokens = []
+    pos = 0
+    while pos < len(text):
+        match = _TOKEN_RE.match(text, pos)
+        if match is None:
+            if text[pos:].strip() == "":
+                break
+            raise ValueError("unexpected character %r in %r" % (text[pos], text))
+        pos = match.end()
+        kind = match.lastgroup
+        tokens.append((kind, match.group(kind)))
+    tokens.append(("end", None))
+    return tokens
+
+
+# --------------------------------------------------------------------------
+# Parser
+# --------------------------------------------------------------------------
+#
+#   expr   := term (('+' | '-') term)*
+#   term   := factor (('*' | '/') factor)*
+#   factor := ('-' | '+') factor | power        # unary minus, looser than '^'
+#   power  := atom ('^' factor)?                # right-associative
+#   atom   := number | name | '(' expr ')'
+#
+# Nodes are tuples: ("num", v) | ("ref", name) | ("neg", node)
+#                 | ("bin", op, left, right)
+
+
+class _Parser:
+    def __init__(self, tokens, source):
+        self.tokens = tokens
+        self.pos = 0
+        self.source = source
+
+    def peek(self):
+        return self.tokens[self.pos]
+
+    def advance(self):
+        token = self.tokens[self.pos]
+        self.pos += 1
+        return token
+
+    def accept_op(self, *ops):
+        kind, value = self.peek()
+        if kind == "op" and value in ops:
+            self.advance()
+            return value
+        return None
+
+    def error(self, message):
+        return ValueError("%s in %r" % (message, self.source))
+
+    def parse(self):
+        node = self.expr()
+        if self.peek()[0] != "end":
+            raise self.error("unexpected token %r" % (self.peek()[1],))
+        return node
+
+    def expr(self):
+        node = self.term()
+        while True:
+            op = self.accept_op("+", "-")
+            if op is None:
+                return node
+            node = ("bin", op, node, self.term())
+
+    def term(self):
+        node = self.factor()
+        while True:
+            op = self.accept_op("*", "/")
+            if op is None:
+                return node
+            node = ("bin", op, node, self.factor())
+
+    def factor(self):
+        op = self.accept_op("-", "+")
+        if op is not None:
+            operand = self.factor()
+            return ("neg", operand) if op == "-" else operand
+        return self.power()
+
+    def power(self):
+        base = self.atom()
+        if self.accept_op("^") is not None:
+            # Right-associative, and the exponent may carry a unary minus.
+            return ("bin", "^", base, self.factor())
+        return base
+
+    def atom(self):
+        kind, value = self.advance()
+        if kind == "number":
+            return ("num", float(value))
+        if kind == "name":
+            return ("ref", value)
+        if kind == "op" and value == "(":
+            node = self.expr()
+            if self.accept_op(")") is None:
+                raise self.error("expected ')'")
+            return node
+        raise self.error("unexpected %r" % (value,))
+
+
+def _parse_cell(text):
+    """Parse one cell's source into an AST node."""
+    stripped = text.strip()
+    if stripped.startswith("="):
+        return _Parser(_tokenize(stripped[1:]), text).parse()
+    try:
+        return ("num", float(stripped))
+    except ValueError:
+        raise ValueError("invalid cell value %r" % (text,))
+
+
+def _refs(node, out):
+    kind = node[0]
+    if kind == "ref":
+        out.append(node[1])
+    elif kind == "neg":
+        _refs(node[1], out)
+    elif kind == "bin":
+        _refs(node[2], out)
+        _refs(node[3], out)
+    return out
+
+
+# --------------------------------------------------------------------------
+# Evaluation
+# --------------------------------------------------------------------------
+
+
+def _eval(node, values):
+    kind = node[0]
+    if kind == "num":
+        return node[1]
+    if kind == "ref":
+        return values[node[1]]
+    if kind == "neg":
+        return -_eval(node[1], values)
+
+    op = node[1]
+    left = _eval(node[2], values)
+    right = _eval(node[3], values)
+    if op == "+":
+        return left + right
+    if op == "-":
+        return left - right
+    if op == "*":
+        return left * right
+    if op == "/":
+        return left / right  # ZeroDivisionError propagates, per the spec
+    return float(left ** right)
+
+
+def _topological_order(asts, deps):
+    """Return cell names in dependency-first order, or raise CycleError."""
+    UNVISITED, ON_STACK, DONE = 0, 1, 2
+    state = dict.fromkeys(asts, UNVISITED)
+    order = []
+
+    for root in asts:
+        if state[root] != UNVISITED:
+            continue
+        # Iterative DFS so that long reference chains cannot blow the stack.
+        stack = [(root, iter(deps[root]))]
+        state[root] = ON_STACK
+        while stack:
+            name, pending = stack[-1]
+            for dep in pending:
+                if dep not in asts:
+                    raise KeyError("unknown cell %r referenced by %r" % (dep, name))
+                if state[dep] == ON_STACK:
+                    raise CycleError("cycle detected at cell %r" % (dep,))
+                if state[dep] == UNVISITED:
+                    state[dep] = ON_STACK
+                    stack.append((dep, iter(deps[dep])))
+                    break
+            else:
+                stack.pop()
+                state[name] = DONE
+                order.append(name)
+    return order
 
 
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute every cell in ``cells``, returning ``{name: float}``."""
+    asts = {name: _parse_cell(text) for name, text in cells.items()}
+    deps = {name: _refs(node, []) for name, node in asts.items()}
+
+    values = {}
+    for name in _topological_order(asts, deps):
+        values[name] = _eval(asts[name], values)
+    return values
