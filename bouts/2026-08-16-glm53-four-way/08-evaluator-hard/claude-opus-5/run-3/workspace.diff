+
+
+# --- evaluation --------------------------------------------------------------
+
+
+def _refs(node, out):
+    """Collect the cell names referenced by ``node`` into ``out`` (in order)."""
+    tag = node[0]
+    if tag == "ref":
+        out.append(node[1])
+    elif tag == "num":
+        pass
+    elif tag == "neg":
+        _refs(node[1], out)
+    else:
+        _refs(node[1], out)
+        _refs(node[2], out)
+    return out
+
+
+def _eval(node, values):
+    """Evaluate an AST; every referenced cell must already be in ``values``."""
+    tag = node[0]
+    if tag == "num":
+        return node[1]
+    if tag == "ref":
+        return values[node[1]]
+    if tag == "neg":
+        return -_eval(node[1], values)
+    left = _eval(node[1], values)
+    right = _eval(node[2], values)
+    if tag == "+":
+        return left + right
+    if tag == "-":
+        return left - right
+    if tag == "*":
+        return left * right
+    if tag == "/":
+        return left / right
+    return left ** right
+
+
+_VISITING, _DONE = 1, 2
 
 
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute every cell in ``cells``, returning ``{name: float}``.
+
+    Raises :class:`CycleError` on any dependency cycle, ``KeyError`` for a
+    reference to an unknown cell, and ``ZeroDivisionError`` for division by zero.
+    """
+    asts = {}
+    deps = {}
+    for name, text in cells.items():
+        node = _parse_cell(name, text)
+        asts[name] = node
+        deps[name] = _refs(node, [])
+
+    values = {}
+    state = {}
+    # Iterative depth-first resolution, so that long reference chains do not
+    # exhaust the interpreter's recursion limit.
+    for root in asts:
+        if state.get(root) == _DONE:
+            continue
+        stack = [root]
+        while stack:
+            name = stack[-1]
+            status = state.get(name)
+            if status == _DONE:
+                stack.pop()
+                continue
+            if status == _VISITING:
+                # every dependency has been resolved by now
+                stack.pop()
+                values[name] = _eval(asts[name], values)
+                state[name] = _DONE
+                continue
+            state[name] = _VISITING
+            for dep in deps[name]:
+                dep_status = state.get(dep)
+                if dep_status == _DONE:
+                    continue
+                if dep_status == _VISITING:
+                    raise CycleError(_cycle_message(stack, state, dep))
+                if dep not in asts:
+                    raise KeyError(dep)
+                stack.append(dep)
+    return values
+
+
+def _cycle_message(stack, state, dep):
+    chain = [name for name in stack if state.get(name) == _VISITING]
+    chain = chain[chain.index(dep):] + [dep]
+    return "cycle: " + " -> ".join(chain)
