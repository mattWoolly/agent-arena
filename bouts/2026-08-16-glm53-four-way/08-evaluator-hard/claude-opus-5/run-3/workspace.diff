+    def power(self):
+        base = self.atom()
+        if self._accept("^"):
+            # right-associative, and the exponent may itself be negated (2^-3)
+            return ("^", base, self.unary())
+        return base
+
+    def atom(self):
+        kind, text = self._next()
+        if kind == NUMBER:
+            return ("num", float(text))
+        if kind == NAME:
+            return ("ref", text)
+        if kind == OP and text == "(":
+            node = self.expr()
+            if not self._accept(")"):
