+
+def _parse_cell(name, text):
+    """Parse one cell's source into an AST."""
+    if not isinstance(text, str):
+        raise ValueError("cell %s: expected a string, got %r" % (name, type(text).__name__))
+    source = text.strip()
+    if source.startswith("="):
+        try:
+            return _Parser(_tokenize(source[1:])).parse()
+        except ValueError as exc:
+            raise ValueError("cell %s: %s" % (name, exc))
+    try:
