-    pass
+    """Raised when cell references form a dependency cycle."""
+
+
+# --- tokenizer ---------------------------------------------------------------
+
+_TOKEN_RE = re.compile(
+    r"""
+    \s*(?:
+        (?P<number>\d+\.\d*|\.\d+|\d+)
+      | (?P<name>[A-Za-z]+\d*)
+      | (?P<op>[-+*/^()])
+    )
+    """,
+    re.VERBOSE,
+)
+
+NUMBER, NAME, OP, END = "number", "name", "op", "end"
+
+
+def _tokenize(text):
+    """Return a list of ``(kind, value)`` tokens, terminated by ``(END, None)``."""
+    tokens = []
+    pos = 0
+    while pos < len(text):
+        match = _TOKEN_RE.match(text, pos)
+        if match is None:
+            if text[pos:].strip() == "":
+                break
+            raise ValueError("unexpected character %r at %d" % (text[pos], pos))
+        pos = match.end()
+        kind = match.lastgroup
+        tokens.append((kind, match.group(kind)))
+    tokens.append((END, None))
+    return tokens
+
+
+# --- parser ------------------------------------------------------------------
+#
+# expr   := term (('+' | '-') term)*
+# term   := unary (('*' | '/') unary)*
+# unary  := '-' unary | '+' unary | power        # looser than '^': -2^2 == -(2^2)
+# power  := atom ('^' unary)?                    # right-associative
+# atom   := number | name | '(' expr ')'
+#
+# An AST node is a tuple: ('num', v) | ('ref', name) | ('neg', x) | (op, l, r).
+
+
+class _Parser:
+    def __init__(self, tokens):
+        self._tokens = tokens
+        self._pos = 0
+
+    def _peek(self):
+        return self._tokens[self._pos]
+
+    def _next(self):
+        token = self._tokens[self._pos]
+        self._pos += 1
+        return token
+
+    def _accept(self, value):
+        kind, text = self._peek()
+        if kind == OP and text == value:
+            self._pos += 1
+            return True
+        return False
+
+    def parse(self):
+        node = self.expr()
+        kind, text = self._peek()
+        if kind != END:
+            raise ValueError("unexpected token %r" % (text,))
+        return node
+
+    def expr(self):
+        node = self.term()
+        while True:
+            if self._accept("+"):
+                node = ("+", node, self.term())
+            elif self._accept("-"):
+                node = ("-", node, self.term())
+            else:
+                return node
+
+    def term(self):
+        node = self.unary()
+        while True:
+            if self._accept("*"):
+                node = ("*", node, self.unary())
+            elif self._accept("/"):
+                node = ("/", node, self.unary())
+            else:
+                return node
+
+    def unary(self):
+        if self._accept("-"):
+            return ("neg", self.unary())
+        if self._accept("+"):
+            return self.unary()
+        return self.power()
