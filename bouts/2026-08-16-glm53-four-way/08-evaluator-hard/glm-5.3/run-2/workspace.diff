 """Implement evaluate() and CycleError per README.md."""
 
+import re
+
 
 class CycleError(Exception):
-    pass
+    """Raised when cell references form a dependency cycle."""
+
+
+# --- tokenizing ---------------------------------------------------------------
+
+_TOKEN_RE = re.compile(
+    r"(?P<ws>\s+)"
+    r"|(?P<num>\d+(?:\.\d*)?|\.\d+)"
+    r"|(?P<ref>[A-Za-z]+\d*)"
+    r"|(?P<op>[-+*/^()])"
+)
+
+# A bare (non-formula) cell value: an optionally signed decimal number.
+_BARE_NUMBER_RE = re.compile(r"[+-]?(?:\d+(?:\.\d*)?|\.\d+)")
+
+
+def _tokenize(text):
+    """Split a formula body into ``(kind, value)`` tokens.
+
+    Kinds are ``"num"`` (float), ``"ref"`` (cell name), and ``"op"`` (a
+    binary operator, ``(``, ``)``, ``u-`` or ``u+``).  A ``+``/``-`` is
+    unary when it starts the formula or follows another operator or ``(``.
+    """
+    tokens = []
+    pos = 0
+    while pos < len(text):
+        m = _TOKEN_RE.match(text, pos)
+        if m is None:
+            raise ValueError(f"unexpected character {text[pos]!r} in {text!r}")
+        pos = m.end()
+        kind = m.lastgroup
+        if kind == "ws":
+            continue
+        if kind == "num":
+            tokens.append(("num", float(m.group())))
+        elif kind == "ref":
+            tokens.append(("ref", m.group()))
+        else:
+            sym = m.group()
+            prev = tokens[-1] if tokens else None
+            after_operand = prev is not None and prev[0] in ("num", "ref")
+            closed = prev == ("op", ")")
+            if sym in "+-" and not (after_operand or closed):
+                tokens.append(("op", "u" + sym))
+            else:
+                tokens.append(("op", sym))
+    return tokens
+
+
+# --- parsing (shunting-yard to RPN) -------------------------------------------
+
+# Higher number binds tighter.  Unary +/- sit between `* /` and `^` so that
+# unary minus binds looser than `^`: `-2^2` is `-(2^2)` = -4, `(-2)^2` = 4.
+_PREC = {"+": 1, "-": 1, "*": 2, "/": 2, "u+": 3, "u-": 3, "^": 4}
+_RIGHT_ASSOC = frozenset({"^"})
+_OPEN_PAREN = ("op", "(")
+
+
+def _to_rpn(tokens, src):
+    """Convert tokens to postfix (RPN) via the shunting-yard algorithm.
+
+    ``^`` is right-associative; ``+ - * /`` are left-associative.  A prefix
+    ``u-``/``u+`` is pushed without popping: it must not displace a ``^``
+    waiting for its right operand (``2^-3`` is ``2^(-3)``), and ``-2^2``
+    works out because a later ``^`` outranks the stacked ``u-`` and pops it.
+    """
+    out = []
+    ops = []
+    expect_operand = True  # False means the next token must be an operator/`)`
+    for tok in tokens:
+        kind, val = tok
+        if kind in ("num", "ref"):
+            if not expect_operand:
+                raise ValueError(f"unexpected {val!r} in {src!r}")
+            expect_operand = False
+            out.append(tok)
+        elif val == "(":
+            if not expect_operand:
+                raise ValueError(f"unexpected '(' in {src!r}")
+            ops.append(tok)
+        elif val == ")":
+            if expect_operand:
+                raise ValueError(f"unexpected ')' in {src!r}")
+            while ops and ops[-1] != _OPEN_PAREN:
+                out.append(ops.pop())
+            if not ops:
+                raise ValueError(f"unbalanced parentheses in {src!r}")
+            ops.pop()
+        elif val in ("u-", "u+"):
+            if not expect_operand:
+                raise ValueError(f"unexpected {val!r} in {src!r}")
+            ops.append(tok)
+        else:
+            if expect_operand:
+                raise ValueError(f"missing operand before {val!r} in {src!r}")
+            prec = _PREC[val]
+            while ops and ops[-1] != _OPEN_PAREN:
+                top = _PREC[ops[-1][1]]
+                if top > prec or (top == prec and val not in _RIGHT_ASSOC):
+                    out.append(ops.pop())
+                else:
+                    break
+            ops.append(tok)
+            expect_operand = True
+    if expect_operand:
+        raise ValueError(f"empty or incomplete formula {src!r}")
+    while ops:
+        tok = ops.pop()
+        if tok == _OPEN_PAREN:
+            raise ValueError(f"unbalanced parentheses in {src!r}")
+        out.append(tok)
+    return out
+
+
+# --- evaluation ----------------------------------------------------------------
+
+def _eval_rpn(tokens, values):
+    """Evaluate an RPN token list against already-computed cell values."""
+    stack = []
+    for kind, val in tokens:
+        if kind == "num":
+            stack.append(val)
+        elif kind == "ref":
+            if val not in values:
+                raise KeyError(val)
+            stack.append(values[val])
+        elif val == "u-":
+            if not stack:
+                raise ValueError("malformed formula")
+            stack.append(-stack.pop())
+        elif val == "u+":
+            if not stack:
+                raise ValueError("malformed formula")
+            stack.append(+stack.pop())
+        else:
+            if len(stack) < 2:
+                raise ValueError("malformed formula")
+            right = stack.pop()
+            left = stack.pop()
+            if val == "+":
+                stack.append(left + right)
+            elif val == "-":
+                stack.append(left - right)
+            elif val == "*":
+                stack.append(left * right)
+            elif val == "/":
+                stack.append(left / right)  # ZeroDivisionError propagates
+            else:
+                stack.append(left ** right)
+    if len(stack) != 1:
+        raise ValueError("malformed formula")
+    return stack[0]
+
+
+def _parse_cell(name, text):
+    """Classify one cell as ``("num", value)`` or ``("rpn", tokens, deps)``."""
+    if isinstance(text, str):
+        src = text.strip()
+        if src.startswith("="):
+            tokens = _to_rpn(_tokenize(src[1:]), src)
+            deps = [t[1] for t in tokens if t[0] == "ref"]
+            return ("rpn", tokens, deps)
+        if _BARE_NUMBER_RE.fullmatch(src):
+            return ("num", float(src))
+        raise ValueError(f"invalid value for cell {name!r}: {text!r}")
+    if isinstance(text, (int, float)) and not isinstance(text, bool):
+        return ("num", float(text))
+    raise ValueError(f"invalid value for cell {name!r}: {text!r}")
 
 
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute every cell's float value, resolving references in any order.
+
+    Raises :class:`CycleError` if any cell reaches itself through references,
+    ``KeyError`` if a formula references a cell absent from ``cells``, and
+    ``ValueError`` for malformed numbers or formulas.
+    """
+    parsed = {}
+    values = {}
+    color = {}  # absent = unvisited, 1 = being computed, 2 = computed
+
+    def parse(name):
+        if name not in parsed:
+            parsed[name] = _parse_cell(name, cells[name])
+        return parsed[name]
+
+    for root in cells:
+        if color.get(root) == 2:
+            continue
+        # Iterative depth-first search, so arbitrarily long dependency chains
+        # cannot hit Python's recursion limit.  A cell is computed only once
+        # all of its references have been computed (post-order).
+        stack = [(root, False)]
+        path = []  # gray cells, in visit order, for the cycle message
+        while stack:
+            name, expanded = stack.pop()
+            if expanded:
+                entry = parsed[name]
+                if entry[0] == "num":
+                    values[name] = entry[1]
+                else:
+                    values[name] = _eval_rpn(entry[1], values)
+                color[name] = 2
+                path.pop()
+                continue
+            if color.get(name) == 2:
+                continue
+            if color.get(name) == 1:
+                raise CycleError(
+                    "cycle detected: " + " -> ".join(path + [name])
+                )
+            if name not in cells:
+                raise KeyError(name)
+            entry = parse(name)
+            color[name] = 1
+            path.append(name)
+            stack.append((name, True))
+            if entry[0] == "rpn":
+                for dep in entry[2]:
+                    stack.append((dep, False))
+    return values
