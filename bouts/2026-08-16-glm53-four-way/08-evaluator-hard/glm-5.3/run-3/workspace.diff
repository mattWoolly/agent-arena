 """Implement evaluate() and CycleError per README.md."""
 
+import re
+
 
 class CycleError(Exception):
-    pass
+    """Raised when a cell depends on itself, directly or transitively."""
+
+
+# A token is a number, a cell name (letters then digits), or one of the
+# operator/parenthesis characters. Order matters: the number alternative must
+# be tried before the cell-name one only in the sense that they never overlap
+# (a cell name starts with a letter), so a plain alternation is safe.
+_TOKEN_RE = re.compile(r"\d+\.?\d*|\.\d+|[A-Za-z]+[0-9]*|[+\-*/^()]")
+_PUNCTUATION = set("+-*/^()")
+
+# AST nodes, as tuples:
+#   ("num", value)          literal number
+#   ("ref", name)           cell reference
+#   ("neg", operand)        unary minus
+#   ("bin", op, lhs, rhs)   binary operator
+
+
+def _tokenize(text):
+    tokens = []
+    pos = 0
+    while pos < len(text):
+        if text[pos].isspace():
+            pos += 1
+            continue
+        match = _TOKEN_RE.match(text, pos)
+        if match is None:
+            raise ValueError(
+                f"unexpected character {text[pos]!r} in formula {text!r}"
+            )
+        tokens.append(match.group())
+        pos = match.end()
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser for the formula grammar.
+
+        expr    := term (("+" | "-") term)*
+        term    := unary (("*" | "/") unary)*
+        unary   := ("+" | "-") unary | power
+        power   := primary ("^" unary)?
+        primary := NUMBER | CELLREF | "(" expr ")"
+
+    Unary minus lives between "term" and "power": it binds tighter than
+    "* /" and "+ -" but looser than "^", so -2^2 is -(2^2). The exponent of
+    "^" is itself a unary, which keeps "^" right-associative (2^3^2 = 512)
+    while still allowing a negated exponent (2^-3).
+    """
+
+    def __init__(self, tokens, text):
+        self._tokens = tokens
+        self._text = text
+        self._pos = 0
+
+    def parse(self):
+        node = self._expr()
+        if self._pos != len(self._tokens):
+            raise ValueError(
+                f"unexpected token {self._tokens[self._pos]!r} in formula "
+                f"{self._text!r}"
+            )
+        return node
+
+    def _peek(self):
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos]
+        return None
+
+    def _take(self):
+        token = self._peek()
+        if token is not None:
+            self._pos += 1
+        return token
+
+    def _expect(self, expected):
+        token = self._take()
+        if token != expected:
+            raise ValueError(
+                f"expected {expected!r} but found {token!r} in formula "
+                f"{self._text!r}"
+            )
+
+    def _expr(self):
+        node = self._term()
+        while self._peek() in ("+", "-"):
+            op = self._take()
+            node = ("bin", op, node, self._term())
+        return node
+
+    def _term(self):
+        node = self._unary()
+        while self._peek() in ("*", "/"):
+            op = self._take()
+            node = ("bin", op, node, self._unary())
+        return node
+
+    def _unary(self):
+        if self._peek() in ("+", "-"):
+            op = self._take()
+            operand = self._unary()
+            if op == "+":
+                return operand
+            return ("neg", operand)
+        return self._power()
+
+    def _power(self):
+        node = self._primary()
+        if self._peek() == "^":
+            self._take()
+            node = ("bin", "^", node, self._unary())
+        return node
+
+    def _primary(self):
+        token = self._take()
+        if token == "(":
+            node = self._expr()
+            self._expect(")")
+            return node
+        if token is None or token in _PUNCTUATION:
+            raise ValueError(
+                f"unexpected token {token!r} in formula {self._text!r}"
+            )
+        if token[0].isdigit() or token[0] == ".":
+            return ("num", float(token))
+        return ("ref", token)
+
+
+def _parse_cell(source):
+    """Turn a cell's raw string into a literal number or a formula AST."""
+    text = source.strip()
+    if not text.startswith("="):
+        try:
+            return ("num", float(text))
+        except ValueError:
+            raise ValueError(
+                f"invalid cell value {source!r}: expected a number or a "
+                "formula beginning with '='"
+            ) from None
+    tokens = _tokenize(text[1:])
+    if not tokens:
+        raise ValueError(f"empty formula in {source!r}")
+    return _Parser(tokens, text).parse()
+
+
+def _dependencies(node, out):
+    kind = node[0]
+    if kind == "ref":
+        out.append(node[1])
+    elif kind == "neg":
+        _dependencies(node[1], out)
+    elif kind == "bin":
+        _dependencies(node[2], out)
+        _dependencies(node[3], out)
+    return out
+
+
+def _eval_node(node, values):
+    kind = node[0]
+    if kind == "num":
+        return node[1]
+    if kind == "ref":
+        return values[node[1]]
+    if kind == "neg":
+        return -_eval_node(node[1], values)
+    lhs = _eval_node(node[2], values)
+    rhs = _eval_node(node[3], values)
+    op = node[1]
+    if op == "+":
+        return lhs + rhs
+    if op == "-":
+        return lhs - rhs
+    if op == "*":
+        return lhs * rhs
+    if op == "/":
+        return lhs / rhs
+    return lhs ** rhs
 
 
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute the float value of every cell in ``cells``.
+
+    ``cells`` maps names to bare-number strings or "=" formulas. Formulas may
+    reference any other cell, forward or backward; cycles raise CycleError.
+    """
+    asts = {name: _parse_cell(source) for name, source in cells.items()}
+    values = {}
+    # 1 = cell is on the dependency path being explored, 2 = value computed.
+    state = {}
+
+    # Iterative depth-first resolution so that arbitrarily long reference
+    # chains do not recurse in Python.
+    for root in cells:
+        if state.get(root) == 2:
+            continue
+        state[root] = 1
+        stack = [(root, iter(_dependencies(asts[root], [])))]
+        while stack:
+            name, pending = stack[-1]
+            next_cell = None
+            for dep in pending:
+                if dep not in asts:
+                    raise KeyError(dep)
+                if state.get(dep) == 1:
+                    path = [entry[0] for entry in stack]
+                    cycle = path[path.index(dep):] + [dep]
+                    raise CycleError(" -> ".join(cycle))
+                if state.get(dep, 0) == 0:
+                    state[dep] = 1
+                    next_cell = dep
+                    break
+            if next_cell is None:
+                stack.pop()
+                state[name] = 2
+                values[name] = _eval_node(asts[name], values)
+            else:
+                stack.append((next_cell, iter(_dependencies(asts[next_cell], []))))
+    return values
