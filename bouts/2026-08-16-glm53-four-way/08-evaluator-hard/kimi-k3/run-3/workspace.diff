 """Implement evaluate() and CycleError per README.md."""
 
+import re
+
 
 class CycleError(Exception):
     pass
 
 
+_TOKEN_RE = re.compile(r"""
+    \s*(?:(?P<num>\d+(?:\.\d+)?)|(?P<ref>[A-Za-z]+\d*)|(?P<op>[+\-*/^()]))
+""", re.VERBOSE)
+
+# Token types
+NUM, REF, OP = "num", "ref", "op"
+
+
+def _tokenize(text):
+    tokens = []
+    pos = 0
+    n = len(text)
+    while pos < n:
+        if text[pos].isspace():
+            pos += 1
+            continue
+        m = _TOKEN_RE.match(text, pos)
+        if not m or m.start() != pos or m.end() == pos:
+            raise ValueError(f"unexpected character at {pos}: {text[pos]!r}")
+        pos = m.end()
+        if m.group(NUM) is not None:
+            tokens.append((NUM, float(m.group(NUM))))
+        elif m.group(REF) is not None:
+            tokens.append((REF, m.group(REF)))
+        else:
+            tokens.append((OP, m.group(OP)))
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser/evaluator over a token stream.
+
+    Grammar (precedence low -> high):
+        expr    := term (('+' | '-') term)*
+        term    := factor (('*' | '/') factor)*
+        factor  := ('-')* power            # unary minus binds looser than ^
+        power   := atom ('^' factor)?      # ^ is right-associative
+        atom    := NUM | REF | '(' expr ')'
+    """
+
+    def __init__(self, tokens, resolve):
+        self.tokens = tokens
+        self.i = 0
+        self.resolve = resolve  # ref name -> float
+
+    def peek(self):
+        return self.tokens[self.i] if self.i < len(self.tokens) else None
+
+    def advance(self):
+        tok = self.tokens[self.i]
+        self.i += 1
+        return tok
+
+    def parse(self):
+        value = self.expr()
+        if self.peek() is not None:
+            raise ValueError("unexpected trailing tokens")
+        return value
+
+    def expr(self):
+        value = self.term()
+        while self.peek() in ((OP, "+"), (OP, "-")):
+            op = self.advance()[1]
+            rhs = self.term()
+            value = value + rhs if op == "+" else value - rhs
+        return value
+
+    def term(self):
+        value = self.factor()
+        while self.peek() in ((OP, "*"), (OP, "/")):
+            op = self.advance()[1]
+            rhs = self.factor()
+            value = value * rhs if op == "*" else value / rhs
+        return value
+
+    def factor(self):
+        if self.peek() == (OP, "-"):
+            self.advance()
+            return -self.factor()
+        return self.power()
+
+    def power(self):
+        base = self.atom()
+        if self.peek() == (OP, "^"):
+            self.advance()
+            # right-associative; exponent goes through factor so that
+            # 2^-3 works and unary minus on the left binds looser.
+            return base ** self.factor()
+        return base
+
+    def atom(self):
+        tok = self.advance()
+        if tok[0] == NUM:
+            return tok[1]
+        if tok[0] == REF:
+            return self.resolve(tok[1])
+        if tok == (OP, "("):
+            value = self.expr()
+            if self.peek() != (OP, ")"):
+                raise ValueError("missing closing parenthesis")
+            self.advance()
+            return value
+        raise ValueError(f"unexpected token: {tok}")
+
+
 def evaluate(cells):
-    raise NotImplementedError
+    values = {}
+    visiting = set()
+
+    def resolve(name):
+        if name in values:
+            return values[name]
+        if name in visiting:
+            raise CycleError(name)
+        if name not in cells:
+            raise KeyError(f"unknown cell: {name}")
+        visiting.add(name)
+        try:
+            raw = cells[name]
+            if raw.startswith("="):
+                value = _Parser(_tokenize(raw[1:]), resolve).parse()
+            else:
+                value = float(raw)
+            values[name] = value
+            return value
+        finally:
+            visiting.discard(name)
+
+    for name in cells:
+        resolve(name)
+    return values
