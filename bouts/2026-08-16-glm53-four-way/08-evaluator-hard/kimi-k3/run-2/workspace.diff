-"""Implement evaluate() and CycleError per README.md."""
+"""Tiny spreadsheet formula engine.
+
+Implements evaluate() and CycleError per README.md: recursive-descent
+parsing of `=`-prefixed formulas with + - * / ^ (right-associative),
+parentheses, unary minus (binding looser than ^), cell references with
+memoized resolution and cycle detection.
+"""
+
+import re
+
+__all__ = ["evaluate", "CycleError"]
 
 
 class CycleError(Exception):
     pass
 
 
+_TOKEN_RE = re.compile(
+    r"""
+    \s*(?:
+        (?P<number>\d+(?:\.\d+)?|\.\d+)
+      | (?P<name>[A-Za-z]+\d*)
+      | (?P<op>[-+*/^()=])
+    )
+    """,
+    re.VERBOSE,
+)
+
+
+class _Parser:
+    def __init__(self, text, resolve):
+        self.tokens = self._tokenize(text)
+        self.pos = 0
+        self.resolve = resolve
+
+    @staticmethod
+    def _tokenize(text):
+        tokens = []
+        i = 0
+        while i < len(text):
+            if text[i].isspace():
+                i += 1
+                continue
+            m = _TOKEN_RE.match(text, i)
+            if not m:
+                raise ValueError(f"unexpected character at {i}: {text[i]!r}")
+            i = m.end()
+            if m.lastgroup == "number":
+                tokens.append(("num", float(m.group())))
+            elif m.lastgroup == "name":
+                tokens.append(("ref", m.group()))
+            else:
+                tokens.append(("op", m.group()))
+        return tokens
+
+    def _peek(self):
+        return self.tokens[self.pos] if self.pos < len(self.tokens) else (None, None)
+
+    def _next(self):
+        tok = self._peek()
+        self.pos += 1
+        return tok
+
+    def _expect(self, value):
+        kind, val = self._next()
+        if kind != "op" or val != value:
+            raise ValueError(f"expected {value!r}, got {val!r}")
+
+    def parse(self):
+        value = self.expr()
+        if self.pos != len(self.tokens):
+            raise ValueError("trailing tokens in formula")
+        return value
+
+    # expr := term (('+'|'-') term)*
+    def expr(self):
+        value = self.term()
+        while True:
+            kind, val = self._peek()
+            if kind == "op" and val in "+-":
+                self._next()
+                rhs = self.term()
+                value = value + rhs if val == "+" else value - rhs
+            else:
+                return value
+
+    # term := unary (('*'|'/') unary)*
+    def term(self):
+        value = self.unary()
+        while True:
+            kind, val = self._peek()
+            if kind == "op" and val in "*/":
+                self._next()
+                rhs = self.unary()
+                value = value * rhs if val == "*" else value / rhs
+            else:
+                return value
+
+    # unary := '-' unary | power   (unary minus binds looser than ^)
+    def unary(self):
+        kind, val = self._peek()
+        if kind == "op" and val == "-":
+            self._next()
+            return -self.unary()
+        if kind == "op" and val == "+":
+            self._next()
+            return self.unary()
+        return self.power()
+
+    # power := atom ('^' unary)?   (^ is right-associative)
+    def power(self):
+        base = self.atom()
+        kind, val = self._peek()
+        if kind == "op" and val == "^":
+            self._next()
+            return base ** self.unary()
+        return base
+
+    # atom := number | ref | '(' expr ')'
+    def atom(self):
+        kind, val = self._next()
+        if kind == "num":
+            return val
+        if kind == "ref":
+            return self.resolve(val)
+        if kind == "op" and val == "(":
+            value = self.expr()
+            self._expect(")")
+            return value
+        raise ValueError(f"unexpected token: {val!r}")
+
+
 def evaluate(cells):
-    raise NotImplementedError
+    values = {}
+    resolving = set()
+
+    def resolve(name):
+        if name in values:
+            return values[name]
+        if name in resolving:
+            raise CycleError(f"dependency cycle through cell {name}")
+        if name not in cells:
+            raise KeyError(f"undefined cell: {name}")
+        resolving.add(name)
+        try:
+            raw = cells[name]
+            if isinstance(raw, str) and raw.startswith("="):
+                value = _Parser(raw[1:], resolve).parse()
+            elif isinstance(raw, str):
+                value = float(raw.strip())
+            else:
+                value = float(raw)
+        finally:
+            resolving.discard(name)
+        values[name] = value
+        return value
+
+    for name in cells:
+        resolve(name)
+    return values
