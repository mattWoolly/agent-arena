+
+_TOKEN_RE = re.compile(
+    r"\s*(?:(?P<number>\d+(?:\.\d*)?|\.\d+)|(?P<name>[A-Za-z]+[0-9]*)|(?P<op>[-+*/^()]))"
+)
+
+
+class _Parser:
+    """Recursive-descent parser/evaluator for one formula body.
+
+    Grammar (precedence low to high), per README:
+
+        expr  := term  (('+' | '-') term)*      # left-associative
+        term  := unary (('*' | '/') unary)*     # left-associative
+        unary := ('-' | '+') unary | power      # binds looser than '^'
+        power := atom  ('^' unary)?             # right-associative
+        atom  := NUMBER | NAME | '(' expr ')'
+
+    Because unary minus recurses into `power`, `-2^2` parses as `-(2^2)`,
+    while `2^-3` still works (the exponent is a `unary`).
+    """
+
+    def __init__(self, text, resolve):
+        self.tokens = self._tokenize(text)
+        self.pos = 0
+        self.resolve = resolve
+
+    @staticmethod
+    def _tokenize(text):
+        tokens = []
+        pos, end = 0, len(text)
+        while pos < end:
+            m = _TOKEN_RE.match(text, pos)
+            if not m:
+                raise ValueError(f"invalid character in formula at {text[pos:]!r}")
+            tokens.append((m.lastgroup, m.group().strip()))
+            pos = m.end()
+        return tokens
+
+    def parse(self):
+        if not self.tokens:
+            raise ValueError("empty formula")
+        value = self.expr()
+        if self.pos != len(self.tokens):
+            raise ValueError(f"unexpected trailing token {self.tokens[self.pos][1]!r}")
+        return value
+
+    def _peek_op(self):
+        if self.pos < len(self.tokens) and self.tokens[self.pos][0] == "op":
+            return self.tokens[self.pos][1]
+        return None
+
+    def expr(self):
+        value = self.term()
+        while True:
+            op = self._peek_op()
+            if op == "+":
+                self.pos += 1
+                value += self.term()
+            elif op == "-":
+                self.pos += 1
+                value -= self.term()
+            else:
+                return value
+
+    def term(self):
+        value = self.unary()
+        while True:
+            op = self._peek_op()
+            if op == "*":
+                self.pos += 1
+                value *= self.unary()
+            elif op == "/":
+                self.pos += 1
+                value /= self.unary()
+            else:
+                return value
+
+    def unary(self):
+        op = self._peek_op()
+        if op == "-":
+            self.pos += 1
+            return -self.unary()
+        if op == "+":
+            self.pos += 1
+            return self.unary()
+        return self.power()
+
+    def power(self):
+        base = self.atom()
+        if self._peek_op() == "^":
+            self.pos += 1
+            return base ** self.unary()
+        return base
+
+    def atom(self):
+        if self.pos >= len(self.tokens):
+            raise ValueError("unexpected end of formula")
+        kind, text = self.tokens[self.pos]
+        if kind == "number":
+            self.pos += 1
+            return float(text)
+        if kind == "name":
+            self.pos += 1
+            return self.resolve(text)
+        if text == "(":
+            self.pos += 1
+            value = self.expr()
+            if self._peek_op() != ")":
+                raise ValueError("missing closing parenthesis")
+            self.pos += 1
+            return value
+        raise ValueError(f"unexpected token {text!r}")
 
 
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute every cell's float value, resolving references transitively.
+
+    Forward references are supported (cells are resolved on demand, not in
+    dict order). Any dependency cycle raises CycleError; division by zero
+    propagates Python's ZeroDivisionError.
+    """
+    values = {}
+    visiting = set()
+
+    def resolve(name):
+        if name in values:
+            return values[name]
+        if name in visiting:
+            raise CycleError(f"dependency cycle through cell {name!r}")
+        if name not in cells:
+            raise KeyError(f"reference to unknown cell {name!r}")
+        visiting.add(name)
+        raw = cells[name].strip()
+        if raw.startswith("="):
+            value = _Parser(raw[1:], resolve).parse()
+        else:
+            value = float(raw)
+        visiting.discard(name)
+        values[name] = value
+        return value
+
+    for name in cells:
+        resolve(name)
+    return values
