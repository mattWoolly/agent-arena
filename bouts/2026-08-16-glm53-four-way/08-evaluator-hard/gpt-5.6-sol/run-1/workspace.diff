+class _Parser:
+    def __init__(self, formula, resolve):
+        self.formula = formula
+        self.resolve = resolve
+        self.position = 0
+        self.token = None
+        self.value = None
+        self._advance()
+
+    def parse(self):
+        value = self._expression()
+        if self.token != "EOF":
+            raise ValueError(
+                f"unexpected token {self.value!r} at position {self.position}"
+            )
+        return value
+
+    def _advance(self):
+        text = self.formula
+        length = len(text)
+        while self.position < length and text[self.position].isspace():
+            self.position += 1
+
+        if self.position == length:
+            self.token = "EOF"
+            self.value = None
+            return
+
+        start = self.position
+        char = text[start]
+        if char in "+-*/^()":
+            self.position += 1
+            self.token = char
+            self.value = char
+            return
+
+        if char.isascii() and char.isalpha():
+            self.position += 1
+            while self.position < length:
+                char = text[self.position]
+                if not (char.isascii() and char.isalpha()):
+                    break
+                self.position += 1
+            while self.position < length:
+                char = text[self.position]
+                if not (char.isascii() and char.isdigit()):
+                    break
+                self.position += 1
+            self.token = "CELL"
+            self.value = text[start : self.position]
+            return
+
+        if char.isascii() and (char.isdigit() or char == "."):
+            saw_digit = False
+            while self.position < length:
+                char = text[self.position]
+                if not (char.isascii() and char.isdigit()):
+                    break
+                saw_digit = True
+                self.position += 1
+            if self.position < length and text[self.position] == ".":
+                self.position += 1
+                while self.position < length:
+                    char = text[self.position]
+                    if not (char.isascii() and char.isdigit()):
+                        break
+                    saw_digit = True
+                    self.position += 1
+            if not saw_digit:
+                raise ValueError(f"invalid number at position {start}")
+            self.token = "NUMBER"
+            self.value = text[start : self.position]
+            return
+
+        raise ValueError(f"unexpected character {char!r} at position {start}")
+
+    def _expression(self):
+        value = self._term()
+        while self.token in ("+", "-"):
+            operator = self.token
+            self._advance()
+            right = self._term()
+            if operator == "+":
+                value += right
+            else:
+                value -= right
+        return value
+
+    def _term(self):
+        value = self._unary()
+        while self.token in ("*", "/"):
+            operator = self.token
+            self._advance()
+            right = self._unary()
+            if operator == "*":
+                value *= right
+            else:
+                value /= right
+        return value
+
+    def _unary(self):
+        if self.token == "-":
+            self._advance()
+            return -self._unary()
+        return self._power()
+
+    def _power(self):
+        value = self._primary()
+        if self.token == "^":
+            self._advance()
+            value **= self._unary()
+        return value
+
+    def _primary(self):
+        if self.token == "NUMBER":
+            value = float(self.value)
+            self._advance()
+            return value
+
+        if self.token == "CELL":
+            name = self.value
+            self._advance()
+            return self.resolve(name)
+
+        if self.token == "(":
+            self._advance()
+            value = self._expression()
+            if self.token != ")":
+                raise ValueError("missing closing parenthesis")
+            self._advance()
+            return value
+
+        raise ValueError(f"expected a number, cell, or '('; got {self.value!r}")
 
 
