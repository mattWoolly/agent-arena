+
+_NUMBER_RE = re.compile(r"\d+(?:\.\d*)?|\.\d+")
+_NAME_RE = re.compile(r"[A-Za-z]+\d*")
+_OPERATOR_RE = re.compile(r"[-+*/()]")
+
+# A bare (non-formula) cell value: an optional sign, then an integer or decimal.
+_BARE_NUMBER_RE = re.compile(r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)")
+
+
+def _tokenize(text):
+    """Split a formula body into (kind, value) tokens.
+
+    Kinds: "num" (float value), "name" (cell reference), "op" (operator or
+    parenthesis character). Raises ValueError on any other character.
+    """
+    tokens = []
+    pos = 0
+    while pos < len(text):
+        if text[pos].isspace():
+            pos += 1
+            continue
+        match = _NUMBER_RE.match(text, pos) or _NAME_RE.match(text, pos)
+        if match:
+            if match.re is _NUMBER_RE:
+                tokens.append(("num", float(match.group())))
+            else:
+                tokens.append(("name", match.group()))
+        else:
+            match = _OPERATOR_RE.match(text, pos)
+            if not match:
+                raise ValueError(
+                    f"unexpected character {text[pos]!r} at position {pos} in {text!r}"
+                )
+            tokens.append(("op", match.group()))
+        pos = match.end()
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser over the token stream.
+
+    Builds a tuple-based AST: ("num", value), ("ref", name), ("neg", operand),
+    and ("bin", op, left, right). Binary operators are left-associative, with
+    "*" and "/" binding tighter than "+" and "-"; unary minus sits below that.
+    """
+
+    def __init__(self, text):
+        self.text = text
+        self.tokens = _tokenize(text)
+        self.pos = 0
+
+    def parse(self):
+        node = self._expr()
+        if self.pos != len(self.tokens):
+            raise ValueError(
+                f"unexpected token {self.tokens[self.pos][1]!r} in {self.text!r}"
+            )
+        return node
+
+    def _peek(self):
+        return self.tokens[self.pos] if self.pos < len(self.tokens) else None
+
+    def _take(self):
+        token = self._peek()
+        if token is None:
+            raise ValueError(f"unexpected end of formula {self.text!r}")
+        self.pos += 1
+        return token
+
+    def _expr(self):
+        node = self._term()
+        while self._peek() in (("op", "+"), ("op", "-")):
+            op = self._take()[1]
+            node = ("bin", op, node, self._term())
+        return node
+
+    def _term(self):
+        node = self._unary()
+        while self._peek() in (("op", "*"), ("op", "/")):
+            op = self._take()[1]
+            node = ("bin", op, node, self._unary())
+        return node
+
+    def _unary(self):
+        if self._peek() == ("op", "-"):
+            self._take()
+            return ("neg", self._unary())
+        return self._atom()
+
+    def _atom(self):
+        kind, value = self._take()
+        if kind in ("num", "name"):
+            return ("num", value) if kind == "num" else ("ref", value)
+        if (kind, value) == ("op", "("):
+            node = self._expr()
+            if self._take() != ("op", ")"):
+                raise ValueError(f"missing closing parenthesis in {self.text!r}")
+            return node
+        raise ValueError(f"unexpected token {value!r} in {self.text!r}")
+
+
+def _to_postfix(root):
+    """Flatten an AST into postfix (stack-machine) instruction order.
+
+    Instructions: ("num", value), ("ref", name), ("neg",), ("apply", op).
+    Iterative so that long operator chains never hit the recursion limit.
+    """
+    instructions = []
+    stack = [(root, False)]
+    while stack:
+        node, ready = stack.pop()
+        if ready:
+            instructions.append(node)
+        elif node[0] == "bin":
+            _, op, left, right = node
+            stack.append((("apply", op), True))
+            stack.append((right, False))
+            stack.append((left, False))
+        elif node[0] == "neg":
+            stack.append((("neg",), True))
+            stack.append((node[1], False))
+        else:  # ("num", ...) or ("ref", ...)
+            instructions.append(node)
+    return instructions
+
+
+def _compile(value, name):
+    """Compile one cell's raw value into a postfix program."""
+    if isinstance(value, (int, float)):
+        return [("num", float(value))]
+    if not isinstance(value, str):
+        raise TypeError(f"cell {name!r} has a non-string value: {value!r}")
+    text = value.strip()
+    if text.startswith("="):
+        return _to_postfix(_Parser(text[1:]).parse())
+    if _BARE_NUMBER_RE.fullmatch(text):
+        return [("num", float(text))]
+    raise ValueError(f"cell {name!r} has an invalid value: {value!r}")
+
+
+def _apply(op, left, right):
+    if op == "+":
+        return left + right
+    if op == "-":
+        return left - right
+    if op == "*":
+        return left * right
+    return left / right  # "/"; ZeroDivisionError propagates, as specified
+
+
+def _resolve(root, programs, values):
+    """Compute `root`'s value, resolving dependencies depth-first on an
+    explicit stack of frames (so long reference chains never recurse)."""
+    if root in values:
+        return values[root]
+    # Each frame is [cell, program, instruction pointer, operand stack].
+    frames = [[root, programs[root], 0, []]]
+    on_stack = {root}
+    while frames:
+        name, program, pc, operands = frames[-1]
+        if pc == len(program):
+            frames.pop()
+            value = operands[-1]
+            values[name] = value
+            on_stack.discard(name)
+            if frames:
+                frames[-1][3].append(value)
+            continue
+        frames[-1][2] = pc + 1
+        kind = program[pc][0]
+        if kind == "num":
+            operands.append(program[pc][1])
+        elif kind == "ref":
+            target = program[pc][1]
+            if target in values:
+                operands.append(values[target])
+            elif target in on_stack:
+                start = next(i for i, frame in enumerate(frames) if frame[0] == target)
+                cycle = [frame[0] for frame in frames[start:]] + [target]
+                raise CycleError("dependency cycle: " + " -> ".join(cycle))
+            elif target not in programs:
+                raise KeyError(f"reference to unknown cell {target!r} from {name!r}")
+            else:
+                on_stack.add(target)
+                frames.append([target, programs[target], 0, []])
+        elif kind == "neg":
+            operands.append(-operands.pop())
+        else:  # ("apply", op)
+            right = operands.pop()
+            left = operands.pop()
+            operands.append(_apply(program[pc][1], left, right))
+    return values[root]
 
 
