-"""Implement evaluate() and CycleError per README.md."""
+"""Implement evaluate() and CycleError per README.md.
+
+A tiny spreadsheet formula engine: parse each cell's formula into an AST,
+resolve references (including forward and transitive ones) with an iterative
+depth-first walk, and detect dependency cycles.
+"""
+
+import re
 
 
 class CycleError(Exception):
-    pass
+    """Raised when a cell references itself, directly or transitively."""
+
+
+_TOKEN_RE = re.compile(
+    r"""
+    (?P<number>(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?)   # 3, 3.5, .5, 1e3
+  | (?P<cell>[A-Za-z]+[0-9]*)                          # A, B, A1, TOTAL, X12
+  | (?P<op>[+\-*/()])                                  # operators / parens
+  | (?P<space>\s+)
+    """,
+    re.VERBOSE,
+)
+
+
+def _tokenize(text):
+    """Yield (kind, value) pairs; raise ValueError on anything unexpected."""
+    pos = 0
+    while pos < len(text):
+        match = _TOKEN_RE.match(text, pos)
+        if match is None:
+            raise ValueError(
+                "unexpected character %r at position %d in %r" % (text[pos], pos, text)
+            )
+        pos = match.end()
+        if match.lastgroup == "space":
+            continue
+        if match.lastgroup == "number":
+            yield ("number", float(match.group("number")))
+        elif match.lastgroup == "cell":
+            yield ("cell", match.group("cell"))
+        else:
+            yield ("op", match.group("op"))
+
+
+# AST nodes are tuples: ("num", value) | ("ref", name) | ("neg", node)
+#                      | ("bin", op, left, right)
+class _Parser:
+    """Recursive-descent parser for the formula grammar in README.md."""
+
+    def __init__(self, tokens, text):
+        self._tokens = list(tokens)
+        self._text = text
+        self._pos = 0
+
+    def parse(self):
+        node = self._expr()
+        if self._pos != len(self._tokens):
+            raise ValueError("trailing input in formula %r" % self._text)
+        return node
+
+    def _peek(self):
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos]
+        return (None, None)
+
+    def _next(self):
+        token = self._peek()
+        self._pos += 1
+        return token
+
+    def _expr(self):
+        node = self._term()
+        while self._peek() == ("op", "+") or self._peek() == ("op", "-"):
+            op = self._next()[1]
+            node = ("bin", op, node, self._term())
+        return node
+
+    def _term(self):
+        node = self._factor()
+        while self._peek() == ("op", "*") or self._peek() == ("op", "/"):
+            op = self._next()[1]
+            node = ("bin", op, node, self._factor())
+        return node
+
+    def _factor(self):
+        kind, value = self._peek()
+        if (kind, value) == ("op", "-"):
+            self._next()
+            return ("neg", self._factor())
+        if (kind, value) == ("op", "+"):
+            self._next()
+            return self._factor()
+        return self._atom()
+
+    def _atom(self):
+        kind, value = self._next()
+        if kind == "number":
+            return ("num", value)
+        if kind == "cell":
+            return ("ref", value)
+        if (kind, value) == ("op", "("):
+            node = self._expr()
+            if self._next() != ("op", ")"):
+                raise ValueError("missing ')' in formula %r" % self._text)
+            return node
+        raise ValueError("unexpected token %r in formula %r" % (value, self._text))
+
+
+def _parse(value):
+    """Parse a cell's raw string into an AST.
+
+    Blank cells evaluate to 0; numbers and formulas (=...) go through the
+    tokenizer/parser.
+    """
+    if value.startswith("="):
+        return _Parser(_tokenize(value[1:]), value).parse()
+    stripped = value.strip()
+    if not stripped:
+        return ("num", 0.0)
+    return ("num", float(stripped))
+
+
+def _dependencies(node, out):
+    """Collect the cell names a node references into `out` (a set)."""
+    kind = node[0]
+    if kind == "ref":
+        out.add(node[1])
+    elif kind == "neg":
+        _dependencies(node[1], out)
+    elif kind == "bin":
+        _dependencies(node[2], out)
+        _dependencies(node[3], out)
+
+
+def _eval_node(node, values):
+    """Evaluate an AST against already-computed cell values."""
+    kind = node[0]
+    if kind == "num":
+        return node[1]
+    if kind == "ref":
+        # A reference to a cell that isn't in the sheet behaves as an empty
+        # cell, i.e. 0.
+        return values.get(node[1], 0.0)
+    if kind == "neg":
+        return -_eval_node(node[1], values)
+    op, left, right = node[1], _eval_node(node[2], values), _eval_node(node[3], values)
+    if op == "+":
+        return left + right
+    if op == "-":
+        return left - right
+    if op == "*":
+        return left * right
+    return left / right  # "/"; ZeroDivisionError propagates, per README
+
+
+_DONE, _VISITING = 2, 1
 
 
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute the float value of every cell in `cells`.
+
+    Raises CycleError if any cell depends on itself, directly or transitively.
+    """
+    asts = {name: _parse(value) for name, value in cells.items()}
+
+    values = {}
+    state = {}
+
+    for root in asts:
+        if state.get(root) == _DONE:
+            continue
+        # Iterative DFS so long reference chains don't hit the recursion limit.
+        # A node is pushed twice: once to visit (expanding its dependencies),
+        # then again to compute its value once those are resolved.
+        stack = [(root, False)]
+        while stack:
+            name, expanded = stack.pop()
+            if expanded:
+                values[name] = _eval_node(asts[name], values)
+                state[name] = _DONE
+                continue
+            status = state.get(name)
+            if status == _DONE:
+                continue
+            if status == _VISITING:
+                raise CycleError("cycle detected involving cell %r" % name)
+            state[name] = _VISITING
+            stack.append((name, True))
+            deps = set()
+            _dependencies(asts[name], deps)
+            for dep in deps:
+                # References to cells absent from the sheet stay unresolved
+                # here; _eval_node treats them as 0.
+                if dep in asts and state.get(dep) != _DONE:
+                    stack.append((dep, False))
+
+    return values
