+    def _expression(self):
+        value = self._term()
+        while self.token in ("+", "-"):
+            operator = self.token
+            self._advance()
+            right = self._term()
+            value = value + right if operator == "+" else value - right
+        return value
+
+    def _term(self):
+        value = self._factor()
+        while self.token in ("*", "/"):
+            operator = self.token
+            self._advance()
+            right = self._factor()
+            value = value * right if operator == "*" else value / right
+        return value
+
+    def _factor(self):
+        if self.token == "-":
+            self._advance()
+            return -self._factor()
