+class _FormulaParser:
+    def __init__(self, formula, resolve):
+        self.formula = formula
+        self.resolve = resolve
+        self.position = 0
+
+    def parse(self):
+        value = self._parse_expression()
+        self._skip_whitespace()
+        if self.position != len(self.formula):
+            self._syntax_error()
+        return value
+
+    def _parse_expression(self):
+        value = self._parse_term()
+        while True:
+            operator = self._take_one_of("+-")
+            if operator is None:
+                return value
+            right = self._parse_term()
+            if operator == "+":
+                value += right
+            else:
+                value -= right
+
+    def _parse_term(self):
+        value = self._parse_unary()
+        while True:
+            operator = self._take_one_of("*/")
+            if operator is None:
+                return value
+            right = self._parse_unary()
+            if operator == "*":
+                value *= right
+            else:
+                value /= right
+
+    def _parse_unary(self):
+        self._skip_whitespace()
+        if self._take("-"):
+            return -self._parse_unary()
+        return self._parse_primary()
+
+    def _parse_primary(self):
+        self._skip_whitespace()
+        if self._take("("):
+            value = self._parse_expression()
+            if not self._take(")"):
+                self._syntax_error("missing closing parenthesis")
+            return value
+
+        character = self._peek()
+        if character is not None and character.isdigit():
+            return self._parse_number()
+        if character is not None and character.isascii() and character.isalpha():
+            return self.resolve(self._parse_cell_name())
+        self._syntax_error("expected a number, cell reference, or parenthesis")
+
+    def _parse_number(self):
+        start = self.position
+        while self._peek() is not None and self._peek().isdigit():
+            self.position += 1
+        if self._peek() == ".":
+            self.position += 1
+            decimal_start = self.position
+            while self._peek() is not None and self._peek().isdigit():
+                self.position += 1
+            if self.position == decimal_start:
+                self._syntax_error("expected digits after decimal point")
+        return float(self.formula[start:self.position])
+
+    def _parse_cell_name(self):
+        start = self.position
+        while (
+            self._peek() is not None
+            and self._peek().isascii()
+            and self._peek().isalpha()
+        ):
+            self.position += 1
+        while self._peek() is not None and self._peek().isdigit():
+            self.position += 1
+        return self.formula[start:self.position]
+
+    def _take_one_of(self, characters):
+        self._skip_whitespace()
+        character = self._peek()
+        if character is not None and character in characters:
+            self.position += 1
+            return character
+        return None
+
+    def _take(self, character):
+        self._skip_whitespace()
+        if self._peek() == character:
+            self.position += 1
+            return True
+        return False
+
+    def _peek(self):
+        if self.position >= len(self.formula):
+            return None
+        return self.formula[self.position]
+
+    def _skip_whitespace(self):
+        while self._peek() is not None and self._peek().isspace():
+            self.position += 1
+
+    def _syntax_error(self, detail="unexpected token"):
+        raise ValueError(
+            f"invalid formula at position {self.position}: {detail}"
+        )
 
 
