+
+def _refs(node):
+    """Cell names referenced by an AST, in first-appearance order."""
+    names = []
+    stack = [node]
+    while stack:
+        current = stack.pop()
+        tag = current[0]
+        if tag == "ref":
+            names.append(current[1])
+        elif tag == "bin":
+            stack.append(current[3])
+            stack.append(current[2])
+        elif tag == "neg":
