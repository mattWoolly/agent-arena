+def _tokenize(text):
+    """Split a formula body into ('number'|'name'|'op', text) tuples."""
+    tokens = []
+    pos = 0
+    while pos < len(text):
+        match = _TOKEN_RE.match(text, pos)
+        if match is None:
+            if text[pos:].strip() == "":
+                break
+            raise ValueError("unexpected character %r in %r" % (text[pos], text))
+        kind = match.lastgroup
+        tokens.append((kind, match.group(kind)))
+        pos = match.end()
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser producing a small tuple-based AST.
+
+    expr   := term (('+' | '-') term)*
+    term   := factor (('*' | '/') factor)*
+    factor := ('-' | '+') factor | atom
+    atom   := NUMBER | NAME | '(' expr ')'
+    """
+
+    def __init__(self, tokens, source):
+        self.tokens = tokens
+        self.source = source
+        self.pos = 0
+
+    def parse(self):
+        node = self.expr()
+        if self.pos != len(self.tokens):
+            raise ValueError(
+                "unexpected token %r in %r"
+                % (self.tokens[self.pos][1], self.source)
+            )
+        return node
+
+    def peek(self):
+        if self.pos < len(self.tokens):
+            return self.tokens[self.pos]
+        return (None, None)
+
+    def expr(self):
+        node = self.term()
+        while self.peek() in (("op", "+"), ("op", "-")):
+            op = self.tokens[self.pos][1]
+            self.pos += 1
+            node = ("bin", op, node, self.term())
+        return node
+
+    def term(self):
+        node = self.factor()
+        while self.peek() in (("op", "*"), ("op", "/")):
+            op = self.tokens[self.pos][1]
+            self.pos += 1
+            node = ("bin", op, node, self.factor())
+        return node
+
+    def factor(self):
+        kind, text = self.peek()
+        if kind == "op" and text in ("-", "+"):
+            self.pos += 1
+            operand = self.factor()
+            return ("neg", operand) if text == "-" else operand
+        return self.atom()
