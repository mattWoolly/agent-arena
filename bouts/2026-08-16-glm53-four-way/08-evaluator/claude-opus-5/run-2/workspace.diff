+    def parse_expr(self):
+        node = self.parse_term()
+        while self._peek() == ("op", "+") or self._peek() == ("op", "-"):
+            op = self._advance()[1]
+            node = ("bin", op, node, self.parse_term())
+        return node
+
+    def parse_term(self):
+        node = self.parse_factor()
