+
+def _tokenize(text, cell):
+    """Split `text` into (kind, value) tokens. Whitespace is insignificant."""
+    tokens = []
+    pos = 0
+    end = len(text)
+    while pos < end:
+        match = _TOKEN_RE.match(text, pos)
+        if match is None:
+            if text[pos:].strip() == "":
+                break
+            raise ValueError(
+                "invalid character %r in cell %s" % (text[pos], cell)
+            )
+        pos = match.end()
+        kind = match.lastgroup
+        tokens.append((kind, match.group(kind)))
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser for the formula grammar.
+
+    expr   := term (('+' | '-') term)*
+    term   := factor (('*' | '/') factor)*
+    factor := ('-' | '+') factor | atom
+    atom   := number | name | '(' expr ')'
+    """
+
+    def __init__(self, tokens, cell):
+        self.tokens = tokens
+        self.cell = cell
+        self.pos = 0
+
+    def _peek(self):
+        if self.pos < len(self.tokens):
+            return self.tokens[self.pos]
+        return (None, None)
+
+    def _advance(self):
+        token = self.tokens[self.pos]
+        self.pos += 1
+        return token
+
+    def parse(self):
+        if not self.tokens:
+            raise ValueError("empty formula in cell %s" % self.cell)
+        node = self.parse_expr()
+        if self.pos != len(self.tokens):
+            raise ValueError(
+                "unexpected token %r in cell %s"
+                % (self.tokens[self.pos][1], self.cell)
+            )
