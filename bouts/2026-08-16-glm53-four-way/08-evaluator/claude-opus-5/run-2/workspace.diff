+# Longest-match-first: names before numbers doesn't matter (disjoint starts),
+# but a number must swallow its decimal part in one token.
+_TOKEN_RE = re.compile(
+    r"""
+    \s*(?:
+        (?P<number>(?:\d+\.\d*|\.\d+|\d+))
+      | (?P<name>[A-Za-z]+\d*)
+      | (?P<op>[-+*/()])
+    )
+    """,
+    re.VERBOSE,
