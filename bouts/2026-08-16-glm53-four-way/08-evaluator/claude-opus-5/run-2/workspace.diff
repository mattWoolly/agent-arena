+
+
+def _order(asts):
+    """Return cell names in dependency order, raising CycleError on cycles.
+
+    Iterative depth-first search so that long reference chains cannot exhaust
+    the interpreter's recursion limit.
+    """
+    deps = {cell: _refs(node, []) for cell, node in asts.items()}
+    for cell, names in deps.items():
+        for name in names:
+            if name not in asts:
