+        # Each frame is [cell, index of the next dependency to visit].
+        stack = [[root, 0]]
+        on_stack.add(root)
+        while stack:
+            frame = stack[-1]
+            cell, index = frame
+            children = deps[cell]
+            if index < len(children):
+                frame[1] += 1
+                child = children[index]
+                if child in on_stack:
+                    raise CycleError(
+                        "cycle detected involving cell %s" % child
+                    )
+                if child not in done:
+                    stack.append([child, 0])
+                    on_stack.add(child)
+            else:
+                stack.pop()
+                on_stack.discard(cell)
+                done.add(cell)
+                order.append(cell)
+    return order
+
+
+def _eval(node, values):
+    """Evaluate an AST node; every referenced cell is already in `values`."""
+    tag = node[0]
+    if tag == "num":
+        return node[1]
+    if tag == "ref":
+        return values[node[1]]
+    if tag == "neg":
+        return -_eval(node[1], values)
+    op, left, right = node[1], _eval(node[2], values), _eval(node[3], values)
+    if op == "+":
+        return left + right
+    if op == "-":
+        return left - right
+    if op == "*":
+        return left * right
+    return left / right  # ZeroDivisionError propagates, per the spec.
 
 
