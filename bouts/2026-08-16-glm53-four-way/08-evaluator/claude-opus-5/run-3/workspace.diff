+"""A small spreadsheet formula engine.
+
+See README.md for the semantics. Each cell's source is compiled once into a
+postfix instruction list; cells are then evaluated in dependency order, which
+is found with an iterative depth-first search that also detects cycles.
+"""
+
+import re
 
 
 class CycleError(Exception):
-    pass
+    """Raised when cells reference each other in a cycle."""
+
+
+# --- lexer ----------------------------------------------------------------
+
+_NUMBER = re.compile(r"\d+(?:\.\d*)?|\.\d+")
+_NAME = re.compile(r"[A-Za-z]+\d*")
+_OPERATORS = "+-*/()"
+
+_NUM, _REF, _OP = "num", "ref", "op"
+
+
+def _tokenize(text):
+    """Turn a formula body into a list of (kind, value) tokens."""
+    tokens = []
+    pos, end = 0, len(text)
+    while pos < end:
+        ch = text[pos]
+        if ch.isspace():
+            pos += 1
+            continue
+        if ch in _OPERATORS:
+            tokens.append((_OP, ch))
+            pos += 1
+            continue
+        match = _NUMBER.match(text, pos) if (ch.isdigit() or ch == ".") else None
+        if match is not None:
+            tokens.append((_NUM, float(match.group())))
+            pos = match.end()
+            continue
+        match = _NAME.match(text, pos)
+        if match is not None:
+            tokens.append((_REF, match.group()))
+            pos = match.end()
+            continue
+        raise ValueError("unexpected character %r in %r" % (ch, text))
+    return tokens
+
+
+# --- parser ---------------------------------------------------------------
+#
+#   expr   := term (('+' | '-') term)*
+#   term   := unary (('*' | '/') unary)*
+#   unary  := ('+' | '-') unary | atom
+#   atom   := NUMBER | REF | '(' expr ')'
+#
+# The parser emits postfix instructions, so evaluation never recurses and a
+# formula like "=1+1+1+..." cannot exhaust the interpreter stack.
+
+_PUSH_NUM, _PUSH_REF, _BINOP, _NEGATE = 0, 1, 2, 3
+
+
+class _Parser:
+    def __init__(self, tokens, source):
+        self.tokens = tokens
+        self.source = source
+        self.pos = 0
+        self.code = []
+
+    def peek(self):
+        return self.tokens[self.pos] if self.pos < len(self.tokens) else None
+
+    def parse(self):
+        self.expr()
+        if self.pos != len(self.tokens):
+            raise ValueError("trailing input in %r" % self.source)
+        return self.code
+
+    def expr(self):
+        self.term()
+        while True:
+            token = self.peek()
+            if token is None or token[0] != _OP or token[1] not in "+-":
+                return
+            self.pos += 1
+            self.term()
+            self.code.append((_BINOP, token[1]))
+
+    def term(self):
+        self.unary()
+        while True:
+            token = self.peek()
+            if token is None or token[0] != _OP or token[1] not in "*/":
+                return
+            self.pos += 1
+            self.unary()
+            self.code.append((_BINOP, token[1]))
+
+    def unary(self):
+        token = self.peek()
+        if token is not None and token[0] == _OP and token[1] in "+-":
+            self.pos += 1
+            self.unary()
+            if token[1] == "-":
+                self.code.append((_NEGATE, None))
+            return
+        self.atom()
+
+    def atom(self):
+        token = self.peek()
+        if token is None:
+            raise ValueError("unexpected end of formula in %r" % self.source)
+        kind, value = token
+        self.pos += 1
+        if kind == _NUM:
+            self.code.append((_PUSH_NUM, value))
+        elif kind == _REF:
+            self.code.append((_PUSH_REF, value))
+        elif value == "(":
+            self.expr()
+            closing = self.peek()
+            if closing is None or closing != (_OP, ")"):
+                raise ValueError("unbalanced parenthesis in %r" % self.source)
+            self.pos += 1
+        else:
+            raise ValueError("unexpected %r in %r" % (value, self.source))
+
+
+def _compile(source):
+    """Compile a cell's source string into postfix instructions."""
+    if not isinstance(source, str):
+        raise TypeError("cell value must be a string, got %r" % (source,))
+    text = source.strip()
+    if text.startswith("="):
+        return _Parser(_tokenize(text[1:]), source).parse()
+    return [(_PUSH_NUM, float(text))]
+
+
+# --- evaluation -----------------------------------------------------------
+
+
+def _dependencies(code):
+    """Referenced cell names, in first-seen order and without duplicates."""
+    seen, deps = set(), []
+    for op, arg in code:
+        if op == _PUSH_REF and arg not in seen:
+            seen.add(arg)
+            deps.append(arg)
+    return deps
+
+
+def _evaluation_order(programs):
+    """Topologically sort cells so dependencies come first.
+
+    Iterative DFS: `state` is 0 while a cell is on the current path and 1 once
+    it is finished, so meeting a 0 means we have looped back on ourselves.
+    """
+    order = []
+    state = {}
+    for root in programs:
+        if root in state:
+            continue
+        state[root] = 0
+        stack = [[root, 0]]
+        path = [root]
+        while stack:
+            frame = stack[-1]
+            name, index = frame
+            deps = _dependencies(programs[name])
+            if index == len(deps):
+                state[name] = 1
+                order.append(name)
+                path.pop()
+                stack.pop()
+                continue
+            frame[1] = index + 1
+            dep = deps[index]
+            if dep not in programs:
+                raise KeyError("%s references unknown cell %s" % (name, dep))
+            visited = state.get(dep)
+            if visited is None:
+                state[dep] = 0
+                stack.append([dep, 0])
+                path.append(dep)
+            elif visited == 0:
+                cycle = path[path.index(dep):] + [dep]
+                raise CycleError(" -> ".join(cycle))
+    return order
+
+
+def _run(code, values):
+    """Execute postfix instructions against already-computed cell values."""
+    stack = []
+    for op, arg in code:
+        if op == _PUSH_NUM:
+            stack.append(arg)
+        elif op == _PUSH_REF:
+            stack.append(values[arg])
+        elif op == _NEGATE:
+            stack[-1] = -stack[-1]
+        else:
+            right = stack.pop()
+            left = stack.pop()
+            if arg == "+":
+                stack.append(left + right)
+            elif arg == "-":
+                stack.append(left - right)
+            elif arg == "*":
+                stack.append(left * right)
+            else:
+                stack.append(left / right)
+    return stack[0]
 
 
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute every cell's value.
