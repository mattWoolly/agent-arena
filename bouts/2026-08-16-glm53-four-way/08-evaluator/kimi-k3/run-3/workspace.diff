-"""Implement evaluate() and CycleError per README.md."""
+"""Spreadsheet formula engine: recursive-descent parser + memoized evaluator."""
+
+import re
+
+_TOKEN_RE = re.compile(
+    r"\s*(?:(?P<num>\d+(?:\.\d+)?)|(?P<ref>[A-Za-z]+\d*)|(?P<op>[+\-*/()]))"
+)
 
 
 class CycleError(Exception):
     pass
 
 
+def _tokenize(text):
+    pos = 0
+    while pos < len(text):
+        m = _TOKEN_RE.match(text, pos)
+        if not m or m.end() == pos:
+            raise ValueError(f"unexpected character in formula: {text[pos:]!r}")
+        pos = m.end()
+        if m.group("num") is not None:
+            yield ("num", float(m.group("num")))
+        elif m.group("ref") is not None:
+            yield ("ref", m.group("ref"))
+        else:
+            yield ("op", m.group("op"))
+    yield ("end", None)
+
+
+class _Parser:
+    def __init__(self, text, resolve):
+        self._tokens = _tokenize(text)
+        self._cur = next(self._tokens)
+        self._resolve = resolve  # cell name -> float
+
+    def _advance(self):
+        tok = self._cur
+        self._cur = next(self._tokens)
+        return tok
+
+    def _expect_op(self, op):
+        kind, val = self._cur
+        if kind != "op" or val != op:
+            raise ValueError(f"expected {op!r}, got {self._cur!r}")
+        self._advance()
+
+    def parse(self):
+        value = self._expr()
+        if self._cur[0] != "end":
+            raise ValueError(f"trailing tokens: {self._cur!r}")
+        return value
+
+    def _expr(self):
+        value = self._term()
+        while self._cur == ("op", "+") or self._cur == ("op", "-"):
+            op = self._advance()[1]
+            rhs = self._term()
+            value = value + rhs if op == "+" else value - rhs
+        return value
+
+    def _term(self):
+        value = self._factor()
+        while self._cur == ("op", "*") or self._cur == ("op", "/"):
+            op = self._advance()[1]
+            rhs = self._factor()
+            value = value * rhs if op == "*" else value / rhs
+        return value
+
+    def _factor(self):
+        kind, val = self._cur
+        if kind == "num":
+            self._advance()
+            return val
+        if kind == "ref":
+            self._advance()
+            return self._resolve(val)
+        if self._cur == ("op", "-"):
+            self._advance()
+            return -self._factor()
+        if self._cur == ("op", "("):
+            self._advance()
+            value = self._expr()
+            self._expect_op(")")
+            return value
+        raise ValueError(f"unexpected token: {self._cur!r}")
+
+
 def evaluate(cells):
-    raise NotImplementedError
+    values = {}  # name -> float, memoized
+    visiting = set()  # names on the current dependency path
+
+    def resolve(name):
+        if name in values:
+            return values[name]
+        if name not in cells:
+            raise ValueError(f"unknown cell: {name!r}")
+        if name in visiting:
+            raise CycleError(f"dependency cycle involving {name!r}")
+        visiting.add(name)
+        try:
+            raw = cells[name]
+            if raw.lstrip().startswith("="):
+                value = _Parser(raw.lstrip()[1:], resolve).parse()
+            else:
+                value = float(raw.strip())
+        finally:
+            visiting.discard(name)
+        values[name] = value
+        return value
+
