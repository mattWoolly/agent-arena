-"""Implement evaluate() and CycleError per README.md."""
+"""Spreadsheet formula engine per README.md."""
+
+import re
+
+_TOKEN_RE = re.compile(
+    r"""
+    \s*(?:
+        (?P<num>\d+(?:\.\d*)?|\.\d+)
+      | (?P<name>[A-Za-z]+\d*)
+      | (?P<op>[+\-*/()])
+    )
+    """,
+    re.VERBOSE,
+)
 
 
 class CycleError(Exception):
     pass
 
 
+def _tokenize(text):
+    tokens = []
+    pos = 0
+    while pos < len(text):
+        m = _TOKEN_RE.match(text, pos)
+        if not m or m.end() == pos:
+            raise ValueError(f"unexpected character at {pos}: {text[pos]!r}")
+        pos = m.end()
+        kind = m.lastgroup
+        tokens.append((kind, m.group(kind)))
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser for the formula grammar.
+
+    expr   := term (('+' | '-') term)*
+    term   := factor (('*' | '/') factor)*
+    factor := '-' factor | '(' expr ')' | num | name
+    """
+
+    def __init__(self, tokens):
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self):
+        if self.pos < len(self.tokens):
+            return self.tokens[self.pos]
+        return (None, None)
+
+    def _next(self):
+        tok = self._peek()
+        self.pos += 1
+        return tok
+
+    def parse(self):
+        node = self._expr()
+        if self.pos != len(self.tokens):
+            raise ValueError(f"unexpected token: {self.tokens[self.pos][1]!r}")
+        return node
+
+    def _expr(self):
+        node = self._term()
+        while self._peek()[1] in ("+", "-"):
+            op = self._next()[1]
+            node = (op, node, self._term())
+        return node
+
+    def _term(self):
+        node = self._factor()
+        while self._peek()[1] in ("*", "/"):
+            op = self._next()[1]
+            node = (op, node, self._factor())
+        return node
+
+    def _factor(self):
+        kind, value = self._peek()
+        if value == "-":
+            self._next()
+            return ("neg", self._factor())
+        if value == "(":
+            self._next()
+            node = self._expr()
+            if self._next()[1] != ")":
+                raise ValueError("missing closing parenthesis")
+            return node
+        if kind == "num":
+            self._next()
+            return ("num", float(value))
+        if kind == "name":
+            self._next()
+            return ("ref", value)
+        raise ValueError(f"unexpected token: {value!r}")
+
+
+def _eval_node(node, resolve):
+    op = node[0]
+    if op == "num":
+        return node[1]
+    if op == "ref":
+        return resolve(node[1])
+    if op == "neg":
+        return -_eval_node(node[1], resolve)
+    left = _eval_node(node[1], resolve)
+    right = _eval_node(node[2], resolve)
+    if op == "+":
+        return left + right
+    if op == "-":
+        return left - right
+    if op == "*":
+        return left * right
+    return left / right
+
+
 def evaluate(cells):
-    raise NotImplementedError
+    results = {}
+    visiting = set()
+
+    def resolve(name):
+        if name in results:
+            return results[name]
+        if name in visiting:
+            raise CycleError(f"dependency cycle through {name!r}")
+        if name not in cells:
+            raise KeyError(f"undefined cell: {name!r}")
+        visiting.add(name)
+        try:
+            raw = cells[name]
+            if raw.startswith("="):
+                ast = _Parser(_tokenize(raw[1:])).parse()
+                value = _eval_node(ast, resolve)
+            else:
+                value = float(raw)
+        finally:
+            visiting.discard(name)
+        results[name] = value
+        return value
+
+    for name in cells:
+        resolve(name)
+    return results
