+def _coerce(raw):
+    """Coerce a raw value string to bool/int/float, or keep it as a string."""
+    text = raw.strip()
+    if len(text) >= 2 and text.startswith('"') and text.endswith('"'):
+        return text[1:-1]
+    lowered = text.lower()
+    if lowered == "true":
+        return True
+    if lowered == "false":
+        return False
+    try:
+        return int(text)
+    except ValueError:
+        pass
+    try:
+        return float(text)
+    except ValueError:
+        pass
+    return text
 
 
 def parse_config(text):
-    raise NotImplementedError
+    """Parse .ini-style text into a nested dict of {section: {key: value}}."""
+    config = {}
+    section = ""
+    for line in text.splitlines():
+        stripped = line.strip()
+        if not stripped or stripped[0] in "#;":
+            continue
+        if stripped.startswith("[") and stripped.endswith("]"):
+            section = stripped[1:-1].strip()
+            config.setdefault(section, {})
+            continue
+        if "=" not in stripped:
+            continue
+        key, _, value = stripped.partition("=")
+        config.setdefault(section, {})[key.strip()] = _coerce(value)
+    return config
 
 
 def get(config, dotted, default=None):
-    raise NotImplementedError
+    """Look up "section.key" (or a bare key in the "" section) in a config."""
+    if "." in dotted:
+        section, key = dotted.split(".", 1)
+    else:
+        section, key = "", dotted
+    return config.get(section, {}).get(key, default)
