+def _coerce(value):
+    """Coerce a raw value string to bool/int/float per the spec."""
+    text = value.strip()
+    if len(text) >= 2 and text.startswith('"') and text.endswith('"'):
+        return text[1:-1]
+    lowered = text.lower()
+    if lowered == "true":
+        return True
+    if lowered == "false":
+        return False
+    try:
+        return int(text)
+    except ValueError:
+        pass
+    try:
+        return float(text)
+    except ValueError:
+        pass
+    return text
 
 
 def parse_config(text):
-    raise NotImplementedError
+    """Parse .ini-style text into a nested {section: {key: value}} dict."""
+    config = {}
+    section = ""
+    for raw_line in text.splitlines():
+        line = raw_line.strip()
+        if not line or line.startswith("#") or line.startswith(";"):
+            continue
+        if line.startswith("[") and line.endswith("]"):
+            section = line[1:-1].strip()
+            config.setdefault(section, {})
+            continue
+        key, _, value = line.partition("=")
+        config.setdefault(section, {})[key.strip()] = _coerce(value)
+    return config
 
 
 def get(config, dotted, default=None):
-    raise NotImplementedError
+    """Look up "section.key" (or a bare key in the "" section)."""
+    if "." in dotted:
+        section, _, key = dotted.partition(".")
+    else:
+        section, key = "", dotted
+    return config.get(section, {}).get(key, default)
