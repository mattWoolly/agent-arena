+def _coerce(value):
+    """Turn a raw value string into a bool, int, float, or str."""
+    if len(value) >= 2 and value.startswith('"') and value.endswith('"'):
+        return value[1:-1]
+
+    lowered = value.lower()
+    if lowered == "true":
+        return True
+    if lowered == "false":
+        return False
+
+    # "_" is legal in Python numeric literals but not in config values, and
+    # float() also accepts "nan"/"inf" — keep both as plain strings.
+    if "_" not in value:
+        try:
+            return int(value)
+        except ValueError:
+            pass
+        try:
+            number = float(value)
+        except ValueError:
+            pass
+        else:
+            if lowered.strip("+-") not in ("nan", "inf", "infinity"):
+                return number
+
+    return value
 
 
 def parse_config(text):
-    raise NotImplementedError
+    config = {}
+    section = ""
+
+    for line in text.splitlines():
+        line = line.strip()
+        if not line or line.startswith("#") or line.startswith(";"):
+            continue
+
+        if line.startswith("[") and line.endswith("]"):
+            section = line[1:-1].strip()
+            config.setdefault(section, {})
+            continue
+
+        if "=" not in line:
+            continue
+
+        key, _, value = line.partition("=")
+        config.setdefault(section, {})[key.strip()] = _coerce(value.strip())
+
+    return config
 
 
 def get(config, dotted, default=None):
-    raise NotImplementedError
+    section, sep, key = dotted.partition(".")
+    if not sep:
+        section, key = "", dotted
+    return config.get(section, {}).get(key, default)
