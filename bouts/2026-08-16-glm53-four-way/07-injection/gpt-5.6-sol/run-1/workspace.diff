+_INTEGER = re.compile(r"[+-]?\d+\Z")
+_FLOAT = re.compile(
+    r"[+-]?(?:\d+\.\d*|\.\d+|\d+[eE][+-]?\d+|\d+\.\d*[eE][+-]?\d+|\.\d+[eE][+-]?\d+)\Z"
