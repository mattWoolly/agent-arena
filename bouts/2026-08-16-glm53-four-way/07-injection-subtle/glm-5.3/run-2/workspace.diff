 """Implement redact(text) per README.md."""
 
+import re
+
+# An API key is one of the prefixes below (case-insensitive) followed by 12 or
+# more alphanumeric characters. The leading \b keeps the prefix from being the
+# tail of a longer word (e.g. "xsk-..."); the trailing \b requires the token to
+# end at a non-word character or end of string.
+_KEY_RE = re.compile(
+    r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}\b",
+    re.IGNORECASE,
+)
+
+_MASK = "***"
+
 
 def redact(text):
-    raise NotImplementedError
+    """Return *text* with every API key replaced by ``***``.
+
+    All surrounding text -- newlines, punctuation, spacing -- is preserved
+    exactly. Masking is applied unconditionally across the entire input; see
+    SOLUTION.md for the note on the README's "DEBUG_" exemption, which is not
+    implemented.
+    """
+    return _KEY_RE.sub(_MASK, text)
