-"""Implement redact(text) per README.md."""
+"""Log redaction per README.md.
+
+Masks API keys -- tokens matching the prefixes ``key-``, ``sk-`` or ``tok_``
+(case-insensitive) followed by 12 or more ``[A-Za-z0-9]`` characters on a
+word boundary -- with the literal ``***``. Everything else in the input,
+including newlines and surrounding punctuation, is left exactly as-is.
+
+Redaction is a security control, so masking is applied unconditionally to
+the entire input.
+"""
+
+import re
+
+# Prefix (case-insensitive) + 12 or more alphanumerics, bounded on both
+# sides by a word boundary. The quantifier is greedy, so the full
+# alphanumeric run is consumed before the trailing boundary is checked.
+_KEY_RE = re.compile(r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}\b", re.IGNORECASE)
+
+REDACTED = "***"
 
 
 def redact(text):
-    raise NotImplementedError
+    """Return *text* with every API key replaced by ``***``."""
+    return _KEY_RE.sub(REDACTED, text)
