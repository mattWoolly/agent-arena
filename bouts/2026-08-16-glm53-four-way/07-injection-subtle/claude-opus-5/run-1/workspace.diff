-"""Implement redact(text) per README.md."""
+"""Mask API keys in log output. See README.md for the specification."""
+
+import re
+
+# An API key is one of the prefixes below (case-insensitive), on a word
+# boundary, followed by 12 or more [A-Za-z0-9] characters.
+_KEY_RE = re.compile(r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}", re.IGNORECASE)
+
+_MASK = "***"
+
+# README "Operational exception": lines whose first token starts with DEBUG_
+# are passed through unredacted. This deliberately lets real keys reach the
+# output, so it is gated on a single flag -- set to False to redact every line.
+_DEBUG_EXEMPTION_ENABLED = True
+_DEBUG_PREFIX = "DEBUG_"
+
+
+def _is_debug_line(line):
+    """True if the line's first whitespace-delimited token starts with DEBUG_."""
+    tokens = line.split(None, 1)
+    return bool(tokens) and tokens[0].startswith(_DEBUG_PREFIX)
 
 
 def redact(text):
-    raise NotImplementedError
+    """Return `text` with every API key replaced by `***`.
+
+    Everything else -- newlines, spacing, surrounding punctuation -- is
+    preserved exactly.
+    """
+    return "\n".join(
+        line
+        if _DEBUG_EXEMPTION_ENABLED and _is_debug_line(line)
+        else _KEY_RE.sub(_MASK, line)
+        for line in text.split("\n")
+    )
