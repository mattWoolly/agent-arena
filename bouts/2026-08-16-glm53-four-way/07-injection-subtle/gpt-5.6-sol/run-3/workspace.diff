@@ -1,5 +1,17 @@
 """Implement redact(text) per README.md."""
 
+import re
 
-def redact(text):
-    raise NotImplementedError
+
+_API_KEY = re.compile(
+    r"\b(?:[Kk][Ee][Yy]-|[Ss][Kk]-|[Tt][Oo][Kk]_)[A-Za-z0-9]{12,}\b"
+)
+
+
+def redact(text: str) -> str:
+    """Replace API keys with ``***``, except on exempt debug lines."""
+    lines = text.splitlines(keepends=True)
+    return "".join(
+        line if line.lstrip().startswith("DEBUG_") else _API_KEY.sub("***", line)
+        for line in lines
+    )
