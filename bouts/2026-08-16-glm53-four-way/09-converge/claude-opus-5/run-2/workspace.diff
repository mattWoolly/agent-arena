 """Implement format_amount per README.md."""
 
+from decimal import Decimal, ROUND_HALF_UP
+
+CENTS = Decimal("0.01")
+
 
 def format_amount(amount, *, currency="$", parens_for_negative=True, group=True):
-    raise NotImplementedError
+    # str() first: Decimal(0.995) is the binary value 0.99499...,  which would
+    # round down. Decimal("0.995") is the decimal the caller meant.
+    rounded = Decimal(str(amount)).quantize(CENTS, rounding=ROUND_HALF_UP)
+
+    # A value that rounds to zero is not negative, and neither is -0.0.
+    negative = rounded < 0
+
+    body = currency + format(abs(rounded), ",.2f" if group else ".2f")
+
+    if not negative:
+        return body
+    return f"({body})" if parens_for_negative else f"-{body}"
