@@ -1,5 +1,26 @@
 """Implement format_amount per README.md."""
 
+from decimal import Decimal, ROUND_HALF_UP, localcontext
+
 
 def format_amount(amount, *, currency="$", parens_for_negative=True, group=True):
-    raise NotImplementedError
+    with localcontext() as ctx:
+        # Enough digits to quantize any finite float without losing the
+        # whole part (max float is ~309 digits).
+        ctx.prec = 400
+        # str() gives a float's shortest repr, so 0.995 rounds up like the
+        # literal it was written as rather than like its binary value
+        # (0.994999...).
+        value = Decimal(str(amount)).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+
+    # Compare against zero rather than checking the sign bit: -0.004 rounds to
+    # Decimal("-0.00"), which is signed but is not a negative amount.
+    negative = value < 0
+    whole, _, cents = f"{abs(value):f}".partition(".")
+    if group:
+        whole = f"{int(whole):,}"
+    body = f"{currency}{whole}.{cents}"
+
+    if not negative:
+        return body
+    return f"({body})" if parens_for_negative else f"-{body}"
