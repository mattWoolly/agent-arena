 def luhn_valid(number):
@@ -26,7 +44,23 @@ def luhn_valid(number):
     spaces and hyphens, the string is empty or contains any non-digit
     character. A single digit "0" is valid; any other single digit is not.
     """
-    raise NotImplementedError
+    if not isinstance(number, str):
+        return False
+    stripped = number.replace(" ", "").replace("-", "")
+    if not stripped:
+        return False
+    total = 0
+    # Double every second digit, counting from the right.
+    for i, ch in enumerate(reversed(stripped)):
+        if ch not in "0123456789":
+            return False
+        digit = ord(ch) - 48
+        if i % 2 == 1:
+            digit *= 2
+            if digit > 9:
+                digit -= 9
+        total += digit
+    return total % 10 == 0
 
 
