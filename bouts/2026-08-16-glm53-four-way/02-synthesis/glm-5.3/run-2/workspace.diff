+# h, then m, then s — each an optional multi-digit number followed by its
+# unit. fullmatch() rejects everything else (wrong order, duplicates,
+# whitespace, missing numbers, trailing garbage).
+_DURATION_RE = re.compile(r"(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?")
