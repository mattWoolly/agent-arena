 def luhn_valid(number):
@@ -26,7 +44,24 @@ def luhn_valid(number):
     spaces and hyphens, the string is empty or contains any non-digit
     character. A single digit "0" is valid; any other single digit is not.
     """
-    raise NotImplementedError
+    if not isinstance(number, str):
+        return False
+    digits = number.replace(" ", "").replace("-", "")
+    if not digits:
+        return False
+    total = 0
+    # Walk right-to-left; double every second digit (positions 1, 3, ...
+    # from the right) and fold doubled values > 9 by subtracting 9.
+    for pos, ch in enumerate(reversed(digits)):
+        if ch < "0" or ch > "9":
+            return False
+        value = ord(ch) - ord("0")
+        if pos % 2 == 1:
+            value *= 2
+            if value > 9:
+                value -= 9
+        total += value
+    return total % 10 == 0
 
 
