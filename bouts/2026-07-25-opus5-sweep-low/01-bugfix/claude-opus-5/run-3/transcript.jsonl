       if len(self._data) >= self.capacity:\n            self._data.popitem(last=False)\n        self._data[key] = (value, self._clock())\n        self._data.move_to_end(key)\n\n    def __len__(self):\n        return len(self._data)\n\n    def __contains__(self, key):\n        return self.get(key, default=_MISSING) is not _MISSING\n\n\n_MISSING = object()\n","structuredPatch":[{"oldStart":27,"oldLines":10,"newStart":27,"newLines":11,"lines":["         if self.ttl is not None and self._clock() - ts > self.ttl:","             del self._data[key]","             return default","+        self._data.move_to_end(key)","         return value"," ","     def put(self, key, value):","-        if len(self._data) >= self.capacity:","+        if key not in self._data and len(self._data) >= self.capacity:","             self._data.popitem(last=False)","         self._data[key] = (value, self._clock())","         self._data.move_to_end(key)"]}],"userModified":false,"replaceAll":false}}
