 """Implement evaluate() and CycleError per README.md."""
+import re
+
+__all__ = ["evaluate", "CycleError"]
 
 
 class CycleError(Exception):
     pass
 
 
+_TOKEN_RE = re.compile(r"\d+(?:\.\d+)?|\.\d+|[A-Za-z]+[0-9]*|[+\-*/()]")
+_NUMBER_RE = re.compile(r"(?:\d+(?:\.\d+)?|\.\d+)")
+_NAME_RE = re.compile(r"[A-Za-z]+[0-9]*")
+
+
+def _tokenize(text):
+    tokens = []
+    pos = 0
+    while pos < len(text):
+        if text[pos].isspace():
+            pos += 1
+            continue
+        m = _TOKEN_RE.match(text, pos)
+        if m is None:
+            raise ValueError(f"bad token at offset {pos} in {text!r}")
+        tokens.append(m.group(0))
+        pos = m.end()
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser/evaluator for a single formula."""
+
+    def __init__(self, tokens, resolve):
+        self.tokens = tokens
+        self.pos = 0
+        self.resolve = resolve
+
+    def _peek(self):
+        return self.tokens[self.pos] if self.pos < len(self.tokens) else None
+
+    def _next(self):
+        tok = self._peek()
+        self.pos += 1
+        return tok
+
+    def parse(self):
+        value = self._expr()
+        if self._peek() is not None:
+            raise ValueError(f"unexpected trailing token {self._peek()!r}")
+        return value
+
+    def _expr(self):
+        value = self._term()
+        while self._peek() in ("+", "-"):
+            op = self._next()
+            rhs = self._term()
+            value = value + rhs if op == "+" else value - rhs
+        return value
+
+    def _term(self):
+        value = self._factor()
+        while self._peek() in ("*", "/"):
+            op = self._next()
+            rhs = self._factor()
+            value = value * rhs if op == "*" else value / rhs
+        return value
+
+    def _factor(self):
+        tok = self._peek()
+        if tok == "-":
+            self._next()
+            return -self._factor()
+        if tok == "+":
+            self._next()
+            return self._factor()
+        return self._primary()
+
+    def _primary(self):
+        tok = self._next()
+        if tok is None:
+            raise ValueError("unexpected end of formula")
+        if tok == "(":
+            value = self._expr()
+            if self._next() != ")":
+                raise ValueError("missing closing parenthesis")
+            return value
+        if _NUMBER_RE.fullmatch(tok):
+            return float(tok)
+        if _NAME_RE.fullmatch(tok):
+            return self.resolve(tok)
+        raise ValueError(f"unexpected token {tok!r}")
+
+
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute the float value of every cell in `cells`.
+
+    Values are bare numbers or formulas beginning with "=". References may
+    point forward and form transitive chains. A dependency cycle raises
+    CycleError; division by zero raises ZeroDivisionError.
+    """
+    values = {}
+    visiting = set()
+
+    def resolve(name):
+        if name in values:
+            return values[name]
+        if name in visiting:
+            raise CycleError(f"dependency cycle involving {name!r}")
+        raw = cells[name]  # KeyError for references to undefined cells
+        visiting.add(name)
+        try:
+            text = raw.strip()
+            if text.startswith("="):
+                value = _Parser(_tokenize(text[1:]), resolve).parse()
+            else:
+                value = float(text)
+            values[name] = value
+        finally:
+            visiting.discard(name)
+        return value
+
+    for name in cells:
+        resolve(name)
+    return values
