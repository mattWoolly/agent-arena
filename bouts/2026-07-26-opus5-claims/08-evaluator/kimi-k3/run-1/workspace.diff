 """Implement evaluate() and CycleError per README.md."""
 
+import re
+
+_TOKEN_RE = re.compile(
+    r"""
+    (?P<number>\d+(?:\.\d*)?|\.\d+)
+    | (?P<ref>[A-Za-z]+\d*)
+    | (?P<op>[+\-*/()])
+    | (?P<ws>\s+)
+    """,
+    re.VERBOSE,
+)
+
 
 class CycleError(Exception):
     pass
 
 
+def _tokenize(text):
+    """Split a formula body into (kind, value) tokens."""
+    tokens = []
+    pos = 0
+    while pos < len(text):
+        m = _TOKEN_RE.match(text, pos)
+        if m is None:
+            raise ValueError(f"unexpected character at {pos}: {text[pos]!r}")
+        pos = m.end()
+        kind = m.lastgroup
+        if kind == "ws":
+            continue
+        tokens.append((kind, m.group()))
+    tokens.append(("end", ""))
+    return tokens
+
+
+class _Parser:
+    """Recursive descent: expr = term (+- term)*; term = factor (*/ factor)*;
+    factor = - factor | ( expr ) | number | ref. All arithmetic float."""
+
+    def __init__(self, tokens, resolve):
+        self.tokens = tokens
+        self.i = 0
+        self.resolve = resolve  # cell name -> float
+
+    def peek(self):
+        return self.tokens[self.i]
+
+    def next(self):
+        tok = self.tokens[self.i]
+        self.i += 1
+        return tok
+
+    def parse(self):
+        value = self.expr()
+        if self.peek()[0] != "end":
+            raise ValueError(f"unexpected trailing token: {self.peek()[1]!r}")
+        return value
+
+    def expr(self):
+        value = self.term()
+        while self.peek() == ("op", "+") or self.peek() == ("op", "-"):
+            op = self.next()[1]
+            rhs = self.term()
+            value = value + rhs if op == "+" else value - rhs
+        return value
+
+    def term(self):
+        value = self.factor()
+        while self.peek() == ("op", "*") or self.peek() == ("op", "/"):
+            op = self.next()[1]
+            rhs = self.factor()
+            value = value * rhs if op == "*" else value / rhs
+        return value
+
+    def factor(self):
+        kind, text = self.peek()
+        if kind == "op" and text == "-":
+            self.next()
+            return -self.factor()
+        if kind == "op" and text == "(":
+            self.next()
+            value = self.expr()
+            if self.next() != ("op", ")"):
+                raise ValueError("expected ')'")
+            return value
+        if kind == "number":
+            self.next()
+            return float(text)
+        if kind == "ref":
+            self.next()
+            return self.resolve(text)
+        raise ValueError(f"unexpected token: {text!r}")
+
+
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute the float value of every cell in `cells`."""
+    values = {}      # name -> computed float
+    resolving = set()  # names on the current dependency stack
+
+    def resolve(name):
+        if name in values:
+            return values[name]
+        if name in resolving:
+            raise CycleError(f"cyclic reference involving {name!r}")
+        if name not in cells:
+            raise KeyError(name)
+        raw = cells[name]
+        if raw.startswith("="):
+            resolving.add(name)
+            try:
+                value = _Parser(_tokenize(raw[1:]), resolve).parse()
+            finally:
+                resolving.discard(name)
+        else:
+            value = float(raw)
+        values[name] = value
+        return value
+
+    return {name: resolve(name) for name in cells}
