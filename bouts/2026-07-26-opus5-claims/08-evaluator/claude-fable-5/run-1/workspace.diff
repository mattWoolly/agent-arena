-"""Implement evaluate() and CycleError per README.md."""
+"""Spreadsheet formula engine: evaluate() and CycleError per README.md."""
+
+import re
 
 
 class CycleError(Exception):
     pass
 
 
+_TOKEN_RE = re.compile(
+    r"\s*(?:(?P<number>\d+(?:\.\d+)?|\.\d+)|(?P<name>[A-Za-z]+\d*)|(?P<op>[+\-*/()]))"
+)
+
+
+def _tokenize(text):
+    tokens = []
+    pos = 0
+    while pos < len(text):
+        match = _TOKEN_RE.match(text, pos)
+        if match is None:
+            if text[pos:].strip() == "":
+                break
+            raise ValueError(f"unexpected character at position {pos}: {text[pos]!r}")
+        if match.group("number") is not None:
+            tokens.append(("number", float(match.group("number"))))
+        elif match.group("name") is not None:
+            tokens.append(("name", match.group("name")))
+        else:
+            tokens.append(("op", match.group("op")))
+        pos = match.end()
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser evaluating a formula directly.
+
+    Grammar:
+        expr   := term (('+' | '-') term)*
+        term   := factor (('*' | '/') factor)*
+        factor := '-' factor | number | name | '(' expr ')'
+    """
+
+    def __init__(self, tokens, resolve):
+        self.tokens = tokens
+        self.pos = 0
+        self.resolve = resolve
+
+    def peek_op(self):
+        if self.pos < len(self.tokens) and self.tokens[self.pos][0] == "op":
+            return self.tokens[self.pos][1]
+        return None
+
+    def next(self):
+        if self.pos >= len(self.tokens):
+            raise ValueError("unexpected end of formula")
+        token = self.tokens[self.pos]
+        self.pos += 1
+        return token
+
+    def parse(self):
+        value = self.expr()
+        if self.pos != len(self.tokens):
+            raise ValueError(f"unexpected token: {self.tokens[self.pos]!r}")
+        return value
+
+    def expr(self):
+        value = self.term()
+        while self.peek_op() in ("+", "-"):
+            op = self.next()[1]
+            rhs = self.term()
+            value = value + rhs if op == "+" else value - rhs
+        return value
+
+    def term(self):
+        value = self.factor()
+        while self.peek_op() in ("*", "/"):
+            op = self.next()[1]
+            rhs = self.factor()
+            value = value * rhs if op == "*" else value / rhs
+        return value
+
+    def factor(self):
+        kind, val = self.next()
+        if kind == "number":
+            return val
+        if kind == "name":
+            return self.resolve(val)
+        if val == "-":
+            return -self.factor()
+        if val == "(":
+            value = self.expr()
+            kind, val = self.next()
+            if kind != "op" or val != ")":
+                raise ValueError("expected ')'")
+            return value
+        raise ValueError(f"unexpected token: {val!r}")
+
+
 def evaluate(cells):
-    raise NotImplementedError
+    values = {}
+    in_progress = set()
+
+    def resolve(name):
+        if name in values:
+            return values[name]
+        if name not in cells:
+            raise KeyError(f"unknown cell: {name}")
+        if name in in_progress:
+            raise CycleError(f"cycle involving cell {name}")
+        in_progress.add(name)
+        try:
+            raw = cells[name].strip()
+            if raw.startswith("="):
+                value = _Parser(_tokenize(raw[1:]), resolve).parse()
+            else:
+                value = float(raw)
+            values[name] = value
+            return value
+        finally:
+            in_progress.discard(name)
+
+    for name in cells:
+        resolve(name)
+    return values
