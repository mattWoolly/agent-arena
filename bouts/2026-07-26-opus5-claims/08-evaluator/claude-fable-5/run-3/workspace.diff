-"""Implement evaluate() and CycleError per README.md."""
+"""Spreadsheet formula engine: evaluate() and CycleError per README.md."""
+
+import re
 
 
 class CycleError(Exception):
     pass
 
 
+_TOKEN_RE = re.compile(
+    r"\s*(?:(?P<number>\d+(?:\.\d+)?|\.\d+)"
+    r"|(?P<name>[A-Za-z]+\d*)"
+    r"|(?P<op>[+\-*/()]))"
+)
+
+
+def _tokenize(text):
+    tokens = []
+    pos = 0
+    while pos < len(text):
+        match = _TOKEN_RE.match(text, pos)
+        if match is None:
+            if text[pos:].strip() == "":
+                break
+            raise ValueError(f"invalid token at {text[pos:]!r}")
+        if match.lastgroup == "number":
+            tokens.append(("number", float(match.group("number"))))
+        elif match.lastgroup == "name":
+            tokens.append(("name", match.group("name")))
+        else:
+            tokens.append(("op", match.group("op")))
+        pos = match.end()
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser producing an AST of nested tuples.
+
+    expr   := term (('+' | '-') term)*
+    term   := factor (('*' | '/') factor)*
+    factor := '-' factor | number | name | '(' expr ')'
+    """
+
+    def __init__(self, tokens):
+        self.tokens = tokens
+        self.pos = 0
+
+    def peek(self):
+        return self.tokens[self.pos] if self.pos < len(self.tokens) else None
+
+    def next(self):
+        token = self.peek()
+        if token is None:
+            raise ValueError("unexpected end of formula")
+        self.pos += 1
+        return token
+
+    def parse(self):
+        node = self.expr()
+        if self.peek() is not None:
+            raise ValueError(f"unexpected token {self.peek()!r}")
+        return node
+
+    def expr(self):
+        node = self.term()
+        while self.peek() in (("op", "+"), ("op", "-")):
+            op = self.next()[1]
+            node = (op, node, self.term())
+        return node
+
+    def term(self):
+        node = self.factor()
+        while self.peek() in (("op", "*"), ("op", "/")):
+            op = self.next()[1]
+            node = (op, node, self.factor())
+        return node
+
+    def factor(self):
+        kind, value = self.next()
+        if (kind, value) == ("op", "-"):
+            return ("neg", self.factor())
+        if kind == "number":
+            return ("number", value)
+        if kind == "name":
+            return ("ref", value)
+        if (kind, value) == ("op", "("):
+            node = self.expr()
+            if self.next() != ("op", ")"):
+                raise ValueError("expected ')'")
+            return node
+        raise ValueError(f"unexpected token {value!r}")
+
+
+def _parse_cell(text):
+    text = text.strip()
+    if text.startswith("="):
+        return _Parser(_tokenize(text[1:])).parse()
+    return ("number", float(text))
+
+
 def evaluate(cells):
-    raise NotImplementedError
+    asts = {name: _parse_cell(text) for name, text in cells.items()}
+    values = {}
+    in_progress = set()
+
+    def cell_value(name):
+        if name in values:
+            return values[name]
+        if name in in_progress:
+            raise CycleError(f"cycle involving cell {name!r}")
+        if name not in asts:
+            raise KeyError(f"unknown cell {name!r}")
+        in_progress.add(name)
+        try:
+            values[name] = eval_node(asts[name])
+        finally:
+            in_progress.discard(name)
+        return values[name]
+
+    def eval_node(node):
+        kind = node[0]
+        if kind == "number":
+            return node[1]
+        if kind == "ref":
+            return cell_value(node[1])
+        if kind == "neg":
+            return -eval_node(node[1])
+        _, left, right = node
+        a, b = eval_node(left), eval_node(right)
+        if kind == "+":
+            return a + b
+        if kind == "-":
+            return a - b
+        if kind == "*":
+            return a * b
+        return a / b
+
+    for name in cells:
+        cell_value(name)
+    return values
