-"""Implement evaluate() and CycleError per README.md."""
+"""Spreadsheet formula engine: evaluate() and CycleError per README.md."""
+
+import re
 
 
 class CycleError(Exception):
     pass
 
 
+_TOKEN_RE = re.compile(
+    r"\s*(?:(?P<number>\d+(?:\.\d*)?|\.\d+)"
+    r"|(?P<name>[A-Za-z]+\d*)"
+    r"|(?P<op>[-+*/()]))"
+)
+
+
+def _tokenize(text):
+    tokens = []
+    pos = 0
+    while pos < len(text):
+        match = _TOKEN_RE.match(text, pos)
+        if match is None:
+            if text[pos:].strip():
+                raise ValueError(f"unexpected character at {pos!r} in {text!r}")
+            break
+        kind = match.lastgroup
+        tokens.append((kind, match.group(kind)))
+        pos = match.end()
+    return tokens
+
+
+class _Parser:
+    """expr := term (('+'|'-') term)*
+    term := factor (('*'|'/') factor)*
+    factor := '-' factor | number | name | '(' expr ')'
+    """
+
+    def __init__(self, tokens, resolve):
+        self.tokens = tokens
+        self.pos = 0
+        self.resolve = resolve
+
+    def peek(self):
+        return self.tokens[self.pos] if self.pos < len(self.tokens) else (None, None)
+
+    def take(self):
+        token = self.peek()
+        self.pos += 1
+        return token
+
+    def parse(self):
+        value = self.expr()
+        if self.pos != len(self.tokens):
+            raise ValueError(f"trailing tokens: {self.tokens[self.pos:]}")
+        return value
+
+    def expr(self):
+        value = self.term()
+        while self.peek() in (("op", "+"), ("op", "-")):
+            op = self.take()[1]
+            rhs = self.term()
+            value = value + rhs if op == "+" else value - rhs
+        return value
+
+    def term(self):
+        value = self.factor()
+        while self.peek() in (("op", "*"), ("op", "/")):
+            op = self.take()[1]
+            rhs = self.factor()
+            value = value * rhs if op == "*" else value / rhs
+        return value
+
+    def factor(self):
+        kind, text = self.take()
+        if (kind, text) == ("op", "-"):
+            return -self.factor()
+        if kind == "number":
+            return float(text)
+        if kind == "name":
+            return self.resolve(text)
+        if (kind, text) == ("op", "("):
+            value = self.expr()
+            if self.take() != ("op", ")"):
+                raise ValueError("missing closing parenthesis")
+            return value
+        raise ValueError(f"unexpected token {text!r}")
+
+
 def evaluate(cells):
-    raise NotImplementedError
+    computed = {}
+    in_progress = set()
+
+    def value_of(name):
+        if name in computed:
+            return computed[name]
+        if name in in_progress:
+            raise CycleError(f"cycle involving {name!r}")
+        in_progress.add(name)
+        try:
+            raw = cells[name]
+            if raw.lstrip().startswith("="):
+                result = _Parser(_tokenize(raw.lstrip()[1:]), value_of).parse()
+            else:
+                result = float(raw)
+        finally:
+            in_progress.discard(name)
+        computed[name] = result
+        return result
+
+    return {name: value_of(name) for name in cells}
