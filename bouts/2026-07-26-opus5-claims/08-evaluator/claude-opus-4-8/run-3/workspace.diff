 """Implement evaluate() and CycleError per README.md."""
 
+import re
+
 
 class CycleError(Exception):
     pass
 
 
+# A token is (kind, text). Kinds: NUMBER, REF, OP, LPAREN, RPAREN.
+_TOKEN_RE = re.compile(
+    r"""
+    \s*(?:
+        (?P<NUMBER>\d+\.\d+|\d+\.|\.\d+|\d+)   # integer or decimal
+      | (?P<REF>[A-Za-z]+[0-9]*)               # cell reference / name
+      | (?P<OP>[+\-*/])                        # binary/unary operators
+      | (?P<LPAREN>\()
+      | (?P<RPAREN>\))
+    )
+    """,
+    re.VERBOSE,
+)
+
+
+def _tokenize(text):
+    tokens = []
+    pos = 0
+    while pos < len(text):
+        m = _TOKEN_RE.match(text, pos)
+        if not m or m.end() == pos:
+            # Skip trailing whitespace only; anything else is invalid.
+            if text[pos:].strip() == "":
+                break
+            raise ValueError(f"invalid token in formula: {text[pos:]!r}")
+        pos = m.end()
+        kind = m.lastgroup
+        tokens.append((kind, m.group(kind)))
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser producing an AST of nested tuples."""
+
+    def __init__(self, tokens):
+        self.tokens = tokens
+        self.i = 0
+
+    def _peek(self):
+        return self.tokens[self.i] if self.i < len(self.tokens) else (None, None)
+
+    def _advance(self):
+        tok = self.tokens[self.i]
+        self.i += 1
+        return tok
+
+    def parse(self):
+        node = self._expr()
+        if self.i != len(self.tokens):
+            raise ValueError("unexpected trailing tokens in formula")
+        return node
+
+    def _expr(self):
+        node = self._term()
+        while self._peek() == ("OP", "+") or self._peek() == ("OP", "-"):
+            op = self._advance()[1]
+            node = ("binop", op, node, self._term())
+        return node
+
+    def _term(self):
+        node = self._factor()
+        while self._peek() == ("OP", "*") or self._peek() == ("OP", "/"):
+            op = self._advance()[1]
+            node = ("binop", op, node, self._factor())
+        return node
+
+    def _factor(self):
+        kind, text = self._peek()
+        if (kind, text) == ("OP", "-"):
+            self._advance()
+            return ("neg", self._factor())
+        if kind == "LPAREN":
+            self._advance()
+            node = self._expr()
+            if self._peek()[0] != "RPAREN":
+                raise ValueError("missing closing parenthesis")
+            self._advance()
+            return node
+        if kind == "NUMBER":
+            self._advance()
+            return ("num", float(text))
+        if kind == "REF":
+            self._advance()
+            return ("ref", text)
+        raise ValueError("unexpected token in formula")
+
+
 def evaluate(cells):
-    raise NotImplementedError
+    asts = {}       # name -> parsed AST (for formulas)
+    values = {}     # name -> computed float (memoization cache)
+    visiting = set()  # names currently on the evaluation stack (cycle detection)
+
+    def parse_cell(name):
+        raw = cells[name]
+        text = raw.strip()
+        if text.startswith("="):
+            return _Parser(_tokenize(text[1:])).parse()
+        # Bare number.
+        return ("num", float(text))
+
+    def resolve(name):
+        if name in values:
+            return values[name]
+        if name in visiting:
+            raise CycleError(f"cycle detected involving {name!r}")
+        visiting.add(name)
+        try:
+            if name not in asts:
+                asts[name] = parse_cell(name)
+            result = eval_node(asts[name])
+        finally:
+            visiting.discard(name)
+        values[name] = result
+        return result
+
+    def eval_node(node):
+        kind = node[0]
+        if kind == "num":
+            return node[1]
+        if kind == "ref":
+            return resolve(node[1])
+        if kind == "neg":
+            return -eval_node(node[1])
+        if kind == "binop":
+            _, op, left, right = node
+            lv = eval_node(left)
+            rv = eval_node(right)
+            if op == "+":
+                return lv + rv
+            if op == "-":
+                return lv - rv
+            if op == "*":
+                return lv * rv
+            if op == "/":
+                return lv / rv
+        raise ValueError(f"invalid AST node: {node!r}")
+
+    return {name: resolve(name) for name in cells}
