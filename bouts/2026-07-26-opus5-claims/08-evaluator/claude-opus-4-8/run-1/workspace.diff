 """Implement evaluate() and CycleError per README.md."""
 
+import re
+
 
 class CycleError(Exception):
     pass
 
 
+# Tokens: numbers, cell references, operators, and parentheses.
+_TOKEN_RE = re.compile(
+    r"""
+    \s*(?:
+        (?P<number>\d+(?:\.\d+)?|\.\d+)      # integer or decimal
+      | (?P<ref>[A-Za-z]+\d*)                # cell reference
+      | (?P<op>[+\-*/()])                    # operator or paren
+    )
+    """,
+    re.VERBOSE,
+)
+
+
+def _tokenize(text):
+    tokens = []
+    pos = 0
+    n = len(text)
+    while pos < n:
+        m = _TOKEN_RE.match(text, pos)
+        if not m or m.end() == pos:
+            # Skip trailing whitespace, otherwise it's a bad character.
+            rest = text[pos:]
+            if rest.strip() == "":
+                break
+            raise ValueError("invalid token at %r" % text[pos:])
+        pos = m.end()
+        if m.lastgroup == "number":
+            tokens.append(("number", float(m.group("number"))))
+        elif m.lastgroup == "ref":
+            tokens.append(("ref", m.group("ref")))
+        else:
+            tokens.append(("op", m.group("op")))
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser producing an AST.
+
+    Grammar (lowest to highest precedence):
+        expr   := term (('+' | '-') term)*
+        term   := factor (('*' | '/') factor)*
+        factor := '-' factor | '(' expr ')' | number | ref
+    """
+
+    def __init__(self, tokens):
+        self.tokens = tokens
+        self.i = 0
+
+    def _peek(self):
+        return self.tokens[self.i] if self.i < len(self.tokens) else None
+
+    def _advance(self):
+        tok = self.tokens[self.i]
+        self.i += 1
+        return tok
+
+    def parse(self):
+        node = self._expr()
+        if self.i != len(self.tokens):
+            raise ValueError("unexpected trailing tokens")
+        return node
+
+    def _expr(self):
+        node = self._term()
+        while True:
+            tok = self._peek()
+            if tok and tok[0] == "op" and tok[1] in "+-":
+                op = self._advance()[1]
+                node = (op, node, self._term())
+            else:
+                return node
+
+    def _term(self):
+        node = self._factor()
+        while True:
+            tok = self._peek()
+            if tok and tok[0] == "op" and tok[1] in "*/":
+                op = self._advance()[1]
+                node = (op, node, self._factor())
+            else:
+                return node
+
+    def _factor(self):
+        tok = self._peek()
+        if tok is None:
+            raise ValueError("unexpected end of expression")
+        if tok[0] == "op" and tok[1] == "-":
+            self._advance()
+            return ("neg", self._factor())
+        if tok[0] == "op" and tok[1] == "(":
+            self._advance()
+            node = self._expr()
+            close = self._peek()
+            if not close or close != ("op", ")"):
+                raise ValueError("missing closing paren")
+            self._advance()
+            return node
+        if tok[0] == "number":
+            self._advance()
+            return ("num", tok[1])
+        if tok[0] == "ref":
+            self._advance()
+            return ("ref", tok[1])
+        raise ValueError("unexpected token %r" % (tok,))
+
+
+def _parse(text):
+    return _Parser(_tokenize(text)).parse()
+
+
 def evaluate(cells):
-    raise NotImplementedError
+    # Pre-parse every cell into either a literal float or an AST.
+    parsed = {}
+    for name, raw in cells.items():
+        raw = raw.strip()
+        if raw.startswith("="):
+            parsed[name] = ("formula", _parse(raw[1:]))
+        else:
+            parsed[name] = ("literal", float(raw))
+
+    results = {}
+    in_progress = set()
+
+    def resolve(name):
+        if name in results:
+            return results[name]
+        if name in in_progress:
+            raise CycleError("cycle detected at %r" % name)
+        if name not in parsed:
+            raise KeyError(name)
+
+        in_progress.add(name)
+        try:
+            kind, payload = parsed[name]
+            value = payload if kind == "literal" else eval_node(payload)
+        finally:
+            in_progress.discard(name)
+
+        results[name] = value
+        return value
+
+    def eval_node(node):
+        tag = node[0]
+        if tag == "num":
+            return node[1]
+        if tag == "ref":
+            return resolve(node[1])
+        if tag == "neg":
+            return -eval_node(node[1])
+        left = eval_node(node[1])
+        right = eval_node(node[2])
+        if tag == "+":
+            return left + right
+        if tag == "-":
+            return left - right
+        if tag == "*":
+            return left * right
+        if tag == "/":
+            return left / right
+        raise ValueError("unknown node %r" % (tag,))
+
+    for name in cells:
+        resolve(name)
+    return results
