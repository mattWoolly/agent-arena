 class CycleError(Exception):
+    """Raised when a cell reaches itself through references, directly or
+    transitively."""
+
     pass
 
 
+# --- Tokenizer -------------------------------------------------------------
+
+def _tokenize(text):
+    """Turn a formula body (the part after ``=``) into a list of tokens.
+
+    Tokens are either operator strings (``+ - * / ( )``) or ``(kind, value)``
+    tuples where ``kind`` is ``"num"`` (value: float) or ``"name"`` (value:
+    the cell name).
+    """
+    tokens = []
+    i = 0
+    n = len(text)
+    while i < n:
+        c = text[i]
+        if c.isspace():
+            i += 1
+            continue
+        if c in "+-*/()":
+            tokens.append(c)
+            i += 1
+            continue
+        if c.isdigit() or c == ".":
+            j = i
+            while j < n and (text[j].isdigit() or text[j] == "."):
+                j += 1
+            tokens.append(("num", float(text[i:j])))
+            i = j
+            continue
+        if c.isalpha():
+            j = i
+            while j < n and text[j].isalpha():
+                j += 1
+            while j < n and text[j].isdigit():
+                j += 1
+            tokens.append(("name", text[i:j]))
+            i = j
+            continue
+        raise ValueError("Unexpected character %r in formula" % c)
+    return tokens
+
+
+# --- Parser ----------------------------------------------------------------
+#
+# Grammar (usual precedence, left-associative):
+#   expr   := term   (('+' | '-') term)*
+#   term   := factor (('*' | '/') factor)*
+#   factor := '-' factor | '(' expr ')' | number | name
+#
+# The parser produces an AST of tuples:
+#   ('num', float)          literal
+#   ('ref', name)           cell reference
+#   ('neg', node)           unary minus
+#   ('bin', op, lhs, rhs)   binary operator
+
+class _Parser:
+    def __init__(self, tokens):
+        self._tokens = tokens
+        self._pos = 0
+
+    def _peek(self):
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos]
+        return None
+
+    def _advance(self):
+        tok = self._tokens[self._pos]
+        self._pos += 1
+        return tok
+
+    def parse(self):
+        node = self._expr()
+        if self._pos != len(self._tokens):
+            raise ValueError("Unexpected trailing tokens in formula")
+        return node
+
+    def _expr(self):
+        node = self._term()
+        while self._peek() in ("+", "-"):
+            op = self._advance()
+            node = ("bin", op, node, self._term())
+        return node
+
+    def _term(self):
+        node = self._factor()
+        while self._peek() in ("*", "/"):
+            op = self._advance()
+            node = ("bin", op, node, self._factor())
+        return node
+
+    def _factor(self):
+        tok = self._peek()
+        if tok == "-":
+            self._advance()
+            return ("neg", self._factor())
+        if tok == "+":  # tolerate a unary plus for symmetry
+            self._advance()
+            return self._factor()
+        if tok == "(":
+            self._advance()
+            node = self._expr()
+            if self._peek() != ")":
+                raise ValueError("Missing closing parenthesis")
+            self._advance()
+            return node
+        if isinstance(tok, tuple):
+            self._advance()
+            kind, value = tok
+            if kind == "num":
+                return ("num", value)
+            return ("ref", value)
+        raise ValueError("Unexpected token %r in formula" % (tok,))
+
+
+def _parse_cell(raw):
+    """Parse a raw cell string into an AST node."""
+    text = raw.strip()
+    if text.startswith("="):
+        return _Parser(_tokenize(text[1:])).parse()
+    return ("num", float(text))
+
+
+# --- Evaluation ------------------------------------------------------------
+
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute every cell's ``float`` value.
+
+    References resolve lazily (supporting forward and transitive references)
+    with memoization; any dependency cycle raises :class:`CycleError`.
+    """
+    asts = {name: _parse_cell(raw) for name, raw in cells.items()}
+    results = {}
+    visiting = set()
+
+    def eval_node(node):
+        kind = node[0]
+        if kind == "num":
+            return node[1]
+        if kind == "ref":
+            return compute(node[1])
+        if kind == "neg":
+            return -eval_node(node[1])
+        # ('bin', op, lhs, rhs)
+        _, op, lhs, rhs = node
+        left = eval_node(lhs)
+        right = eval_node(rhs)
+        if op == "+":
+            return left + right
+        if op == "-":
+            return left - right
+        if op == "*":
+            return left * right
+        return left / right  # real division; ZeroDivisionError propagates
+
+    def compute(name):
+        if name in results:
+            return results[name]
+        if name in visiting:
+            raise CycleError(name)
+        visiting.add(name)
+        try:
+            value = eval_node(asts[name])
+        finally:
+            visiting.discard(name)
+        results[name] = value
+        return value
+
+    for name in cells:
+        compute(name)
+    return results
