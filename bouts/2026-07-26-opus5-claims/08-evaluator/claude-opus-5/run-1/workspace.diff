-"""Implement evaluate() and CycleError per README.md."""
+"""A small spreadsheet formula engine (see README.md)."""
+
+import re
+
+__all__ = ["evaluate", "CycleError"]
 
 
 class CycleError(Exception):
-    pass
+    """Raised when a cell reaches itself through references."""
+
+
+_NUMBER = r"\d+\.\d*|\.\d+|\d+"
+_NAME = r"[A-Za-z]+\d*"
+_TOKEN_RE = re.compile(r"(?P<number>%s)|(?P<name>%s)|(?P<op>[-+*/()])" % (_NUMBER, _NAME))
+
+_ADD_OPS = ("+", "-")
+_MUL_OPS = ("*", "/")
+
+_GREY, _BLACK = 1, 2
 
 
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute every cell in ``cells``, returning a name -> float dict."""
+    tokens = {}
+    literals = {}
+    deps = {}
+    for cell, raw in cells.items():
+        text = raw.strip()
+        if text.startswith("="):
+            tokens[cell] = _tokenize(text[1:], cell)
+            deps[cell] = [tok for kind, tok in tokens[cell] if kind == "name"]
+        else:
+            literals[cell] = _literal(text, cell)
+            deps[cell] = ()
+
+    values = {}
+    for cell in _dependency_order(cells, deps):
+        if cell in literals:
+            values[cell] = literals[cell]
+        else:
+            values[cell] = _Parser(tokens[cell], values, cell).parse()
+    return values
+
+
+def _literal(text, cell):
+    try:
+        return float(text)
+    except ValueError:
+        raise ValueError("%s: %r is not a number or a formula" % (cell, text)) from None
+
+
+def _tokenize(text, cell):
+    tokens = []
+    pos, end = 0, len(text)
+    while pos < end:
+        if text[pos].isspace():
+            pos += 1
+            continue
+        match = _TOKEN_RE.match(text, pos)
+        if match is None:
+            raise ValueError("%s: unexpected character %r" % (cell, text[pos]))
+        tokens.append((match.lastgroup, match.group()))
+        pos = match.end()
+    return tokens
+
+
+def _dependency_order(cells, deps):
+    """Return cell names ordered so every cell follows the cells it reads.
+
+    Uses an explicit stack rather than recursion so that long reference
+    chains cannot exhaust the interpreter's stack.
+    """
+    state = {}
+    order = []
+    for root in cells:
+        if root in state:
+            continue
+        state[root] = _GREY
+        stack = [(root, iter(deps[root]))]
+        while stack:
+            cell, pending = stack[-1]
+            descended = False
+            for dep in pending:
+                if dep not in deps:
+                    continue  # unknown cell; reported when the formula is read
+                marker = state.get(dep)
+                if marker == _GREY:
+                    raise CycleError(_describe_cycle(stack, dep))
+                if marker is None:
+                    state[dep] = _GREY
+                    stack.append((dep, iter(deps[dep])))
+                    descended = True
+                    break
+            if descended:
+                continue
+            state[cell] = _BLACK
+            order.append(cell)
+            stack.pop()
+    return order
+
+
+def _describe_cycle(stack, dep):
+    path = [cell for cell, _ in stack]
+    return "cycle: " + " -> ".join(path[path.index(dep):] + [dep])
+
+
+class _Parser:
+    """Recursive-descent evaluator for a single formula's token list.
+
+    Binary operators are folded in a loop as they are read, so the recursion
+    depth tracks only how deeply parentheses and unary minus are nested.
+    """
+
+    def __init__(self, tokens, values, cell):
+        self._tokens = tokens
+        self._values = values
+        self._cell = cell
+        self._pos = 0
+
+    def parse(self):
+        value = self._expression()
+        token = self._peek()
+        if token is not None:
+            raise ValueError("%s: unexpected %r" % (self._cell, token[1]))
+        return value
+
+    def _peek(self):
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos]
+        return None
+
+    def _next_op(self, ops):
+        token = self._peek()
+        if token is not None and token[0] == "op" and token[1] in ops:
+            self._pos += 1
+            return token[1]
+        return None
+
+    def _expression(self):
+        value = self._term()
+        while True:
+            op = self._next_op(_ADD_OPS)
+            if op is None:
+                return value
+            right = self._term()
+            value = value + right if op == "+" else value - right
+
+    def _term(self):
+        value = self._factor()
+        while True:
+            op = self._next_op(_MUL_OPS)
+            if op is None:
+                return value
+            right = self._factor()
+            value = value * right if op == "*" else value / right
+
+    def _factor(self):
+        op = self._next_op(_ADD_OPS)
+        if op is None:
+            return self._primary()
+        value = self._factor()
+        return -value if op == "-" else value
+
+    def _primary(self):
+        token = self._peek()
+        if token is None:
+            raise ValueError("%s: unexpected end of formula" % self._cell)
+        kind, text = token
+        self._pos += 1
+        if kind == "number":
+            return float(text)
+        if kind == "name":
+            try:
+                return self._values[text]
+            except KeyError:
+                raise KeyError(
+                    "%s references unknown cell %r" % (self._cell, text)
+                ) from None
+        if text == "(":
+            value = self._expression()
+            if self._next_op((")",)) is None:
+                raise ValueError("%s: missing ')'" % self._cell)
+            return value
+        raise ValueError("%s: unexpected %r" % (self._cell, text))
