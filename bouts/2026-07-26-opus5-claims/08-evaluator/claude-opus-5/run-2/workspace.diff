+"""A small spreadsheet formula engine.
+
+`evaluate(cells)` computes every cell in a sheet, resolving references (including
+forward and transitive ones) and raising `CycleError` on dependency cycles.
+"""
+
+import re
 
 
 class CycleError(Exception):
-    pass
+    """Raised when a cell reaches itself through references."""
+
+
+# --- tokenizer ---------------------------------------------------------------
+
+_NUMBER = r"(?:\d+(?:\.\d*)?|\.\d+)"
+_NAME = r"[A-Za-z]+\d*"
+_TOKEN = re.compile(r"\s*(?:(?P<num>%s)|(?P<name>%s)|(?P<op>[-+*/()]))" % (_NUMBER, _NAME))
+
+
+def _tokenize(text):
+    """Yield ``(kind, value)`` tokens; whitespace between tokens is skipped."""
+    tokens = []
+    pos = 0
+    while pos < len(text):
+        match = _TOKEN.match(text, pos)
+        if match is None:
+            if text[pos:].strip() == "":
+                break
+            raise SyntaxError("unexpected character %r in %r" % (text[pos], text))
+        pos = match.end()
+        if match.group("num") is not None:
+            tokens.append(("num", float(match.group("num"))))
+        elif match.group("name") is not None:
+            tokens.append(("name", match.group("name")))
+        else:
+            tokens.append((match.group("op"), None))
+    return tokens
+
+
+# --- parser ------------------------------------------------------------------
+#
+# expr   := term (('+' | '-') term)*
+# term   := unary (('*' | '/') unary)*
+# unary  := ('-' | '+') unary | primary
+# primary:= NUMBER | NAME | '(' expr ')'
+#
+# Nodes are tuples: ('num', v) ('ref', name) ('neg', node) ('bin', op, l, r)
+
+
+class _Parser:
+    def __init__(self, tokens, source):
+        self._tokens = tokens
+        self._source = source
+        self._pos = 0
+
+    def parse(self):
+        node = self._expr()
+        if self._pos != len(self._tokens):
+            raise SyntaxError("trailing input in %r" % (self._source,))
+        return node
+
+    def _peek(self):
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos][0]
+        return None
+
+    def _expr(self):
+        node = self._term()
+        while self._peek() in ("+", "-"):
+            op = self._tokens[self._pos][0]
+            self._pos += 1
+            node = ("bin", op, node, self._term())
+        return node
+
+    def _term(self):
+        node = self._unary()
+        while self._peek() in ("*", "/"):
+            op = self._tokens[self._pos][0]
+            self._pos += 1
+            node = ("bin", op, node, self._unary())
+        return node
+
+    def _unary(self):
+        kind = self._peek()
+        if kind in ("-", "+"):
+            self._pos += 1
+            operand = self._unary()
+            return ("neg", operand) if kind == "-" else operand
+        return self._primary()
+
+    def _primary(self):
+        if self._pos >= len(self._tokens):
+            raise SyntaxError("unexpected end of input in %r" % (self._source,))
+        kind, value = self._tokens[self._pos]
+        self._pos += 1
+        if kind == "num":
+            return ("num", value)
+        if kind == "name":
+            return ("ref", value)
+        if kind == "(":
+            node = self._expr()
+            if self._peek() != ")":
+                raise SyntaxError("missing ')' in %r" % (self._source,))
+            self._pos += 1
+            return node
+        raise SyntaxError("unexpected token %r in %r" % (kind, self._source))
+
+
+def _parse_cell(raw):
+    """Parse one cell's raw string into an AST."""
+    text = raw.strip() if isinstance(raw, str) else str(raw)
+    if text.startswith("="):
+        text = text[1:]
+    if text == "":
+        return ("num", 0.0)
+    return _Parser(_tokenize(text), text).parse()
+
+
+def _refs(node, out=None):
+    """Referenced cell names, in first-appearance order, without duplicates."""
+    if out is None:
+        out = []
+    kind = node[0]
+    if kind == "ref":
+        if node[1] not in out:
+            out.append(node[1])
+    elif kind == "neg":
+        _refs(node[1], out)
+    elif kind == "bin":
+        _refs(node[2], out)
+        _refs(node[3], out)
+    return out
+
+
+def _eval_ast(node, values):
+    kind = node[0]
+    if kind == "num":
+        return node[1]
+    if kind == "ref":
+        return values[node[1]]
+    if kind == "neg":
+        return -_eval_ast(node[1], values)
+    _, op, left, right = node
+    a = _eval_ast(left, values)
+    b = _eval_ast(right, values)
+    if op == "+":
+        return a + b
+    if op == "-":
+        return a - b
+    if op == "*":
+        return a * b
+    return a / b  # real division; 0 divisor raises ZeroDivisionError
+
+
+# --- evaluation --------------------------------------------------------------
 
 
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute every cell in `cells`, returning ``{name: float}``.
+
+    Uses an explicit-stack depth-first walk of the dependency graph so that long
+    reference chains cannot exhaust Python's recursion limit.
+    """
+    asts = {name: _parse_cell(raw) for name, raw in cells.items()}
+    deps = {name: _refs(node) for name, node in asts.items()}
+
+    values = {}
+    active = set()
+    path = []
+
+    for start in asts:
+        if start in values:
+            continue
+        stack = [(start, False)]
+        while stack:
+            name, expanded = stack.pop()
+            if expanded:
+                # All dependencies are resolved; compute and leave the frame.
+                active.discard(name)
+                path.pop()
+                values[name] = float(_eval_ast(asts[name], values))
+                continue
+            if name in values:
+                continue
+            if name in active:
+                cycle = path[path.index(name):] + [name]
+                raise CycleError("cycle detected: " + " -> ".join(cycle))
+            active.add(name)
+            path.append(name)
+            stack.append((name, True))
+            for ref in deps[name]:
+                if ref not in values:
+                    if ref not in asts:
+                        raise KeyError(ref)
+                    stack.append((ref, False))
+
+    return values
