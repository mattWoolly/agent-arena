+"""Tiny spreadsheet formula engine.
+
+Implements evaluate() and CycleError per README.md.
+"""
+
+import re
 
 
 class CycleError(Exception):
     pass
 
 
+_TOKEN_RE = re.compile(
+    r"""
+    \s*(?:
+      (?P<number>\d+(?:\.\d+)?|\.\d+)
+    | (?P<name>[A-Za-z]+\d*)
+    | (?P<op>[+\-*/^()]))
+    """,
+    re.VERBOSE,
+)
+
+
+def _tokenize(text):
+    tokens = []
+    pos = 0
+    while pos < len(text):
+        m = _TOKEN_RE.match(text, pos)
+        if not m or m.end() == pos:
+            raise ValueError(f"invalid token at {text[pos:]!r}")
+        pos = m.end()
+        kind = m.lastgroup
+        value = m.group(kind)
+        if kind == "number":
+            tokens.append(("num", float(value)))
+        elif kind == "name":
+            tokens.append(("ref", value))
+        else:
+            tokens.append((value, None))
+    tokens.append(("end", None))
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser/evaluator.
+
+    Grammar (low to high precedence):
+        expr  := term (('+'|'-') term)*
+        term  := unary (('*'|'/') unary)*
+        unary := '-' unary | power        # unary minus looser than ^
+        power := atom ('^' unary)?        # right-associative
+        atom  := number | ref | '(' expr ')'
+    """
+
+    def __init__(self, tokens, resolve):
+        self.tokens = tokens
+        self.i = 0
+        self.resolve = resolve
+
+    def peek(self):
+        return self.tokens[self.i][0]
+
+    def next(self):
+        tok = self.tokens[self.i]
+        self.i += 1
+        return tok
+
+    def parse(self):
+        value = self.expr()
+        if self.peek() != "end":
+            raise ValueError("trailing tokens in formula")
+        return value
+
+    def expr(self):
+        value = self.term()
+        while self.peek() in ("+", "-"):
+            op = self.next()[0]
+            rhs = self.term()
+            value = value + rhs if op == "+" else value - rhs
+        return value
+
+    def term(self):
+        value = self.unary()
+        while self.peek() in ("*", "/"):
+            op = self.next()[0]
+            rhs = self.unary()
+            value = value * rhs if op == "*" else value / rhs
+        return value
+
+    def unary(self):
+        if self.peek() == "-":
+            self.next()
+            return -self.unary()
+        if self.peek() == "+":
+            self.next()
+            return self.unary()
+        return self.power()
+
+    def power(self):
+        base = self.atom()
+        if self.peek() == "^":
+            self.next()
+            # Right-associative, and exponent may itself be a unary expr
+            # so that 2^-3 works; precedence keeps -2^2 = -(2^2).
+            return base ** self.unary()
+        return base
+
+    def atom(self):
+        kind, val = self.next()
+        if kind == "num":
+            return val
+        if kind == "ref":
+            return self.resolve(val)
+        if kind == "(":
+            value = self.expr()
+            if self.peek() != ")":
+                raise ValueError("missing closing parenthesis")
+            self.next()
+            return value
+        raise ValueError(f"unexpected token {kind!r}")
+
+
 def evaluate(cells):
-    raise NotImplementedError
+    results = {}
+    visiting = []
+
+    def compute(name):
+        if name in results:
+            return results[name]
+        if name not in cells:
+            raise KeyError(f"unknown cell {name!r}")
+        if name in visiting:
+            cycle = visiting[visiting.index(name):] + [name]
+            raise CycleError("dependency cycle: " + " -> ".join(cycle))
+        visiting.append(name)
+        try:
+            raw = cells[name]
+            if isinstance(raw, str) and raw.lstrip().startswith("="):
+                value = _Parser(_tokenize(raw.lstrip()[1:]), compute).parse()
+            else:
+                value = float(raw)
+        finally:
+            visiting.pop()
+        results[name] = value
+        return value
+
+    for name in cells:
+        compute(name)
+    return results
