-"""Implement evaluate() and CycleError per README.md."""
+"""Spreadsheet formula engine: tokenizer, recursive-descent parser, evaluator."""
 
 
 class CycleError(Exception):
     pass
 
 
+def _tokenize(text):
+    tokens = []
+    i = 0
+    n = len(text)
+    while i < n:
+        c = text[i]
+        if c.isspace():
+            i += 1
+        elif c.isalpha() or c == "_":
+            j = i
+            while j < n and (text[j].isalnum() or text[j] == "_"):
+                j += 1
+            tokens.append(("NAME", text[i:j]))
+            i = j
+        elif c.isdigit() or c == ".":
+            j = i
+            while j < n and (text[j].isdigit() or text[j] == "."):
+                j += 1
+            tokens.append(("NUM", float(text[i:j])))
+            i = j
+        elif c in "+-*/^()":
+            tokens.append((c, c))
+            i += 1
+        else:
+            raise ValueError(f"unexpected character: {c!r}")
+    tokens.append(("EOF", None))
+    return tokens
+
+
+class _Parser:
+    """Grammar (precedence low -> high):
+    expr  := term  (('+'|'-') term)*
+    term  := unary (('*'|'/') unary)*
+    unary := '-' unary | power
+    power := atom  ('^' unary)?        # right-associative
+    atom  := NUM | NAME | '(' expr ')'
+    """
+
+    def __init__(self, tokens):
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self):
+        return self.tokens[self.pos][0]
+
+    def _next(self):
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self):
+        node = self._expr()
+        if self._peek() != "EOF":
+            raise ValueError("trailing tokens in formula")
+        return node
+
+    def _expr(self):
+        node = self._term()
+        while self._peek() in ("+", "-"):
+            op = self._next()[0]
+            node = (op, node, self._term())
+        return node
+
+    def _term(self):
+        node = self._unary()
+        while self._peek() in ("*", "/"):
+            op = self._next()[0]
+            node = (op, node, self._unary())
+        return node
+
+    def _unary(self):
+        if self._peek() == "-":
+            self._next()
+            return ("neg", self._unary())
+        if self._peek() == "+":
+            self._next()
+            return self._unary()
+        return self._power()
+
+    def _power(self):
+        base = self._atom()
+        if self._peek() == "^":
+            self._next()
+            return ("^", base, self._unary())
+        return base
+
+    def _atom(self):
+        kind, value = self._next()
+        if kind == "NUM":
+            return ("num", value)
+        if kind == "NAME":
+            return ("ref", value)
+        if kind == "(":
+            node = self._expr()
+            if self._peek() != ")":
+                raise ValueError("missing closing parenthesis")
+            self._next()
+            return node
+        raise ValueError(f"unexpected token: {kind}")
+
+
+_BINOPS = {
+    "+": lambda a, b: a + b,
+    "-": lambda a, b: a - b,
+    "*": lambda a, b: a * b,
+    "/": lambda a, b: a / b,
+    "^": lambda a, b: a ** b,
+}
+
+
 def evaluate(cells):
-    raise NotImplementedError
+    asts = {}
+    for name, raw in cells.items():
+        text = raw.strip()
+        if text.startswith("="):
+            asts[name] = _Parser(_tokenize(text[1:])).parse()
+        else:
+            asts[name] = ("num", float(text))
+
+    values = {}
+    visiting = set()
+
+    def resolve(name):
+        if name in values:
+            return values[name]
+        if name in visiting:
+            raise CycleError(f"cycle involving cell {name}")
+        if name not in asts:
+            raise KeyError(f"unknown cell: {name}")
+        visiting.add(name)
+        try:
+            values[name] = _eval(asts[name])
+        finally:
+            visiting.discard(name)
+        return values[name]
+
+    def _eval(node):
+        op = node[0]
+        if op == "num":
+            return node[1]
+        if op == "ref":
+            return resolve(node[1])
+        if op == "neg":
+            return -_eval(node[1])
+        return _BINOPS[op](_eval(node[1]), _eval(node[2]))
+
+    return {name: resolve(name) for name in cells}
