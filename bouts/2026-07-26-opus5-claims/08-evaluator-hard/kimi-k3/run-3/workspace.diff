 """Implement evaluate() and CycleError per README.md."""
 
+import re
+
 
 class CycleError(Exception):
     pass
 
 
+_TOKEN_RE = re.compile(
+    r"""
+    (?P<number>\d+(?:\.\d+)?)
+    | (?P<name>[A-Za-z]+\d*)
+    | (?P<op>[+\-*/^()])
+    | (?P<ws>\s+)
+    | (?P<bad>.)
+    """,
+    re.VERBOSE,
+)
+
+
+def _tokenize(text):
+    tokens = []
+    for m in _TOKEN_RE.finditer(text):
+        kind = m.lastgroup
+        if kind == "ws":
+            continue
+        if kind == "bad":
+            raise ValueError(f"unexpected character {m.group()!r} in formula")
+        tokens.append((kind, m.group()))
+    tokens.append(("end", ""))
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser.
+
+    Grammar (precedence low -> high):
+        expr   := term (('+' | '-') term)*
+        term   := unary (('*' | '/') unary)*
+        unary  := '-' unary | power
+        power  := atom ('^' unary)?      # right-associative
+        atom   := number | name | '(' expr ')'
+
+    Unary minus binds looser than '^', so -2^2 == -(2^2) == -4,
+    while 2^-3 works because the exponent is a unary.
+    """
+
+    def __init__(self, tokens):
+        self.tokens = tokens
+        self.pos = 0
+
+    def _peek(self):
+        return self.tokens[self.pos]
+
+    def _next(self):
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self):
+        node = self._expr()
+        if self._peek()[0] != "end":
+            raise ValueError(f"unexpected token {self._peek()[1]!r}")
+        return node
+
+    def _expr(self):
+        node = self._term()
+        while self._peek() == ("op", "+") or self._peek() == ("op", "-"):
+            op = self._next()[1]
+            rhs = self._term()
+            node = (op, node, rhs)
+        return node
+
+    def _term(self):
+        node = self._unary()
+        while self._peek() == ("op", "*") or self._peek() == ("op", "/"):
+            op = self._next()[1]
+            rhs = self._unary()
+            node = (op, node, rhs)
+        return node
+
+    def _unary(self):
+        if self._peek() == ("op", "-"):
+            self._next()
+            return ("neg", self._unary())
+        if self._peek() == ("op", "+"):
+            self._next()
+            return self._unary()
+        return self._power()
+
+    def _power(self):
+        base = self._atom()
+        if self._peek() == ("op", "^"):
+            self._next()
+            exp = self._unary()
+            return ("^", base, exp)
+        return base
+
+    def _atom(self):
+        kind, value = self._next()
+        if kind == "number":
+            return ("num", float(value))
+        if kind == "name":
+            return ("ref", value)
+        if (kind, value) == ("op", "("):
+            node = self._expr()
+            if self._next() != ("op", ")"):
+                raise ValueError("missing closing parenthesis")
+            return node
+        raise ValueError(f"unexpected token {value!r}")
+
+
+def _eval_node(node, resolve):
+    op = node[0]
+    if op == "num":
+        return node[1]
+    if op == "ref":
+        return resolve(node[1])
+    if op == "neg":
+        return -_eval_node(node[1], resolve)
+    left = _eval_node(node[1], resolve)
+    right = _eval_node(node[2], resolve)
+    if op == "+":
+        return left + right
+    if op == "-":
+        return left - right
+    if op == "*":
+        return left * right
+    if op == "/":
+        return left / right
+    if op == "^":
+        return left ** right
+    raise ValueError(f"unknown operator {op!r}")
+
+
 def evaluate(cells):
-    raise NotImplementedError
+    values = {}
+    in_progress = set()
+
+    def resolve(name):
+        if name in values:
+            return values[name]
+        if name in in_progress:
+            raise CycleError(f"cyclic reference involving {name!r}")
+        if name not in cells:
+            raise KeyError(f"undefined cell {name!r}")
+        in_progress.add(name)
+        try:
+            raw = cells[name]
+            if isinstance(raw, str) and raw.startswith("="):
+                ast = _Parser(_tokenize(raw[1:])).parse()
+                value = float(_eval_node(ast, resolve))
+            else:
+                value = float(raw)
+        finally:
+            in_progress.discard(name)
+        values[name] = value
+        return value
+
+    return {name: resolve(name) for name in cells}
