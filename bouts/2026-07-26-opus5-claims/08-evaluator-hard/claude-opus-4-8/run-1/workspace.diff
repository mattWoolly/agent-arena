+"""A small spreadsheet formula engine.
+
+Implements ``evaluate(cells)`` and ``CycleError`` per README.md.
+"""
+
+import re
 
 
 class CycleError(Exception):
-    pass
+    """Raised when a cell reaches itself through references."""
+
+
+# One master token pattern. Leading ``\s*`` makes whitespace between tokens
+# insignificant. Numbers are integer or decimal; cell references are one or
+# more letters followed by zero or more digits.
+_TOKEN_RE = re.compile(
+    r"\s*(?:"
+    r"(?P<num>\d+\.?\d*|\.\d+)"
+    r"|(?P<ref>[A-Za-z]+\d*)"
+    r"|(?P<op>[+\-*/^()])"
+    r")"
+)
+
+
+def _tokenize(text):
+    """Turn a formula body (without the leading ``=``) into a token list."""
+    tokens = []
+    pos = 0
+    length = len(text)
+    while pos < length:
+        match = _TOKEN_RE.match(text, pos)
+        if match is None or match.end() == pos:
+            # No token matched. Only acceptable if the remainder is whitespace.
+            if text[pos:].strip() == "":
+                break
+            raise ValueError(f"invalid token in {text!r} at position {pos}")
+        pos = match.end()
+        if match.group("num") is not None:
+            tokens.append(("num", float(match.group("num"))))
+        elif match.group("ref") is not None:
+            tokens.append(("ref", match.group("ref")))
+        else:
+            tokens.append(("op", match.group("op")))
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser that evaluates as it parses.
+
+    Grammar (precedence low to high)::
+
+        expr  := term (('+' | '-') term)*      # left-associative
+        term  := unary (('*' | '/') unary)*    # left-associative
+        unary := '-' unary | power             # looser than '^'
+        power := primary ('^' unary)?          # right-associative
+        primary := number | ref | '(' expr ')'
+    """
+
+    def __init__(self, tokens, resolve):
+        self._tokens = tokens
+        self._pos = 0
+        self._resolve = resolve
+
+    def _peek(self):
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos]
+        return (None, None)
+
+    def _advance(self):
+        tok = self._tokens[self._pos]
+        self._pos += 1
+        return tok
+
+    def parse(self):
+        value = self._expr()
+        if self._pos != len(self._tokens):
+            raise ValueError("unexpected trailing tokens")
+        return value
+
+    def _expr(self):
+        value = self._term()
+        while self._peek() in (("op", "+"), ("op", "-")):
+            op = self._advance()[1]
+            rhs = self._term()
+            value = value + rhs if op == "+" else value - rhs
+        return value
+
+    def _term(self):
+        value = self._unary()
+        while self._peek() in (("op", "*"), ("op", "/")):
+            op = self._advance()[1]
+            rhs = self._unary()
+            value = value * rhs if op == "*" else value / rhs
+        return value
+
+    def _unary(self):
+        if self._peek() == ("op", "-"):
+            self._advance()
+            return -self._unary()
+        return self._power()
+
+    def _power(self):
+        base = self._primary()
+        if self._peek() == ("op", "^"):
+            self._advance()
+            # Right-associative, and the exponent is a unary expression so
+            # that ``2^-3`` and ``2^3^2`` parse as expected.
+            exponent = self._unary()
+            return base ** exponent
+        return base
+
+    def _primary(self):
+        kind, value = self._peek()
+        if kind == "num":
+            self._advance()
+            return value
+        if kind == "ref":
+            self._advance()
+            return self._resolve(value)
+        if (kind, value) == ("op", "("):
+            self._advance()
+            inner = self._expr()
+            if self._peek() != ("op", ")"):
+                raise ValueError("expected ')'")
+            self._advance()
+            return inner
+        raise ValueError("unexpected end of formula" if kind is None
+                         else f"unexpected token {value!r}")
 
 
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute every cell's value, returning ``{name: float}``.
+
+    References resolve lazily (supporting forward and transitive chains) and
+    results are memoized. Any dependency cycle raises :class:`CycleError`.
+    """
+    values = {}
+    in_progress = set()
+
+    def resolve(name):
+        if name in values:
+            return values[name]
+        if name in in_progress:
+            raise CycleError(name)
+        in_progress.add(name)
+        raw = cells[name].strip()
+        if raw.startswith("="):
+            tokens = _tokenize(raw[1:])
+            result = _Parser(tokens, resolve).parse()
+        else:
+            result = float(raw)
+        in_progress.discard(name)
+        values[name] = result
+        return result
+
+    return {name: resolve(name) for name in cells}
