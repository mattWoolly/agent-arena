 """Implement evaluate() and CycleError per README.md."""
 
+import re
+
 
 class CycleError(Exception):
     pass
 
 
+# Token kinds: NUMBER, CELL, OP (one of + - * / ^), LPAREN, RPAREN.
+_TOKEN_RE = re.compile(
+    r"""
+      \s*(?:
+          (?P<NUMBER>\d+\.\d+|\d+\.|\.\d+|\d+)   # 3, 3.5, 3., .5
+        | (?P<CELL>[A-Za-z]+\d*)                 # A, A1, TOTAL, X12
+        | (?P<OP>[+\-*/^])
+        | (?P<LPAREN>\()
+        | (?P<RPAREN>\))
+      )
+    """,
+    re.VERBOSE,
+)
+
+
+def _tokenize(text):
+    tokens = []
+    pos = 0
+    n = len(text)
+    while pos < n:
+        if text[pos].isspace():
+            pos += 1
+            continue
+        m = _TOKEN_RE.match(text, pos)
+        if not m or m.start() == m.end():
+            raise ValueError(f"invalid token at {pos!r} in {text!r}")
+        kind = m.lastgroup
+        value = m.group(kind)
+        tokens.append((kind, value))
+        pos = m.end()
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser producing a value via `resolve(name)`.
+
+    Grammar (low to high precedence):
+        expr   := term (('+' | '-') term)*
+        term   := factor (('*' | '/') factor)*
+        factor := ('-' | '+') factor | power     # unary, looser than '^'
+        power  := atom ('^' factor)?             # right-associative
+        atom   := NUMBER | CELL | '(' expr ')'
+    """
+
+    def __init__(self, tokens, resolve):
+        self.tokens = tokens
+        self.pos = 0
+        self.resolve = resolve
+
+    def _peek(self):
+        return self.tokens[self.pos] if self.pos < len(self.tokens) else (None, None)
+
+    def _advance(self):
+        tok = self.tokens[self.pos]
+        self.pos += 1
+        return tok
+
+    def parse(self):
+        value = self._expr()
+        if self.pos != len(self.tokens):
+            raise ValueError("unexpected trailing tokens")
+        return value
+
+    def _expr(self):
+        value = self._term()
+        while True:
+            kind, op = self._peek()
+            if kind == "OP" and op in "+-":
+                self._advance()
+                rhs = self._term()
+                value = value + rhs if op == "+" else value - rhs
+            else:
+                return value
+
+    def _term(self):
+        value = self._factor()
+        while True:
+            kind, op = self._peek()
+            if kind == "OP" and op in "*/":
+                self._advance()
+                rhs = self._factor()
+                value = value * rhs if op == "*" else value / rhs
+            else:
+                return value
+
+    def _factor(self):
+        kind, op = self._peek()
+        if kind == "OP" and op in "+-":
+            self._advance()
+            operand = self._factor()
+            return -operand if op == "-" else operand
+        return self._power()
+
+    def _power(self):
+        base = self._atom()
+        kind, op = self._peek()
+        if kind == "OP" and op == "^":
+            self._advance()
+            exponent = self._factor()  # right-assoc, looser-than-'^' unary
+            return base ** exponent
+        return base
+
+    def _atom(self):
+        kind, value = self._peek()
+        if kind == "NUMBER":
+            self._advance()
+            return float(value)
+        if kind == "CELL":
+            self._advance()
+            return self.resolve(value)
+        if kind == "LPAREN":
+            self._advance()
+            inner = self._expr()
+            close_kind, _ = self._peek()
+            if close_kind != "RPAREN":
+                raise ValueError("expected ')'")
+            self._advance()
+            return inner
+        raise ValueError("expected number, cell reference, or '('")
+
+
 def evaluate(cells):
-    raise NotImplementedError
+    computed = {}          # name -> float result (memoized)
+    in_progress = set()    # names currently being evaluated (cycle detection)
+
+    def resolve(name):
+        if name in computed:
+            return computed[name]
+        if name in in_progress:
+            raise CycleError(f"cycle detected at {name!r}")
+        if name not in cells:
+            raise KeyError(name)
+
+        in_progress.add(name)
+        try:
+            raw = cells[name].strip()
+            if raw.startswith("="):
+                tokens = _tokenize(raw[1:])
+                value = _Parser(tokens, resolve).parse()
+            else:
+                value = float(raw)
+        finally:
+            in_progress.discard(name)
+
+        computed[name] = value
+        return value
+
+    return {name: resolve(name) for name in cells}
