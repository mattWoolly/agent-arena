 """Implement evaluate() and CycleError per README.md."""
 
+import re
+
 
 class CycleError(Exception):
     pass
 
 
+_TOKEN_RE = re.compile(
+    r"""\s*(?:
+          (?P<number> \d+\.\d* | \.\d+ | \d+ )
+        | (?P<name>   [A-Za-z]+\d* )
+        | (?P<op>     [-+*/^()] )
+    )""",
+    re.VERBOSE,
+)
+
+
+def _tokenize(src):
+    """Turn a formula body into a list of (kind, text) tokens."""
+    tokens = []
+    pos = 0
+    end = len(src)
+    while pos < end:
+        match = _TOKEN_RE.match(src, pos)
+        if match is None:
+            rest = src[pos:].lstrip()
+            if not rest:
+                break
+            raise ValueError("unexpected character %r in %r" % (rest[0], src))
+        kind = match.lastgroup
+        tokens.append((kind, match.group(kind)))
+        pos = match.end()
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent parser for the formula grammar.
+
+    expr  := term (('+' | '-') term)*
+    term  := unary (('*' | '/') unary)*
+    unary := ('-' | '+') unary | power
+    power := atom ('^' unary)?          # right-associative
+    atom  := number | name | '(' expr ')'
+
+    Putting `unary` above `power` makes unary minus bind looser than `^`
+    (`-2^2` is `-(2^2)`) while still allowing `2^-3`.
+    """
+
+    def __init__(self, tokens):
+        self._tokens = tokens
+        self._pos = 0
+        self.refs = []
+
+    def parse(self):
+        node = self._expr()
+        if self._pos != len(self._tokens):
+            raise ValueError("trailing input at token %d" % self._pos)
+        return node
+
+    def _peek(self):
+        if self._pos < len(self._tokens):
+            return self._tokens[self._pos]
+        return (None, None)
+
+    def _accept(self, *texts):
+        kind, text = self._peek()
+        if kind == "op" and text in texts:
+            self._pos += 1
+            return text
+        return None
+
+    def _expr(self):
+        node = self._term()
+        while True:
+            op = self._accept("+", "-")
+            if op is None:
+                return node
+            node = ("bin", op, node, self._term())
+
+    def _term(self):
+        node = self._unary()
+        while True:
+            op = self._accept("*", "/")
+            if op is None:
+                return node
+            node = ("bin", op, node, self._unary())
+
+    def _unary(self):
+        op = self._accept("-", "+")
+        if op is None:
+            return self._power()
+        operand = self._unary()
+        if op == "-":
+            return ("neg", operand)
+        return operand
+
+    def _power(self):
+        base = self._atom()
+        if self._accept("^") is None:
+            return base
+        # Right-associative, and the exponent may itself be unary: 2^-3.
+        return ("bin", "^", base, self._unary())
+
+    def _atom(self):
+        kind, text = self._peek()
+        if kind == "number":
+            self._pos += 1
+            return ("num", float(text))
+        if kind == "name":
+            self._pos += 1
+            self.refs.append(text)
+            return ("ref", text)
+        if kind == "op" and text == "(":
+            self._pos += 1
+            node = self._expr()
+            if self._accept(")") is None:
+                raise ValueError("expected ')'")
+            return node
+        if kind is None:
+            raise ValueError("unexpected end of formula")
+        raise ValueError("unexpected token %r" % text)
+
+
+def _parse(name, raw):
+    """Compile one cell's source into (ast, refs)."""
+    if not isinstance(raw, str):
+        raise ValueError("cell %s: expected a string, got %r" % (name, raw))
+    text = raw.strip()
+    if text.startswith("="):
+        parser = _Parser(_tokenize(text[1:]))
+        try:
+            ast = parser.parse()
+        except ValueError as exc:
+            raise ValueError("cell %s: %s" % (name, exc))
+        return ast, parser.refs
+    try:
+        return ("num", float(text)), []
+    except ValueError:
+        raise ValueError("cell %s: not a number or formula: %r" % (name, raw))
+
+
+def _eval(node, values):
+    """Evaluate an AST whose referenced cells are all present in `values`."""
+    kind = node[0]
+    if kind == "num":
+        return node[1]
+    if kind == "ref":
+        return values[node[1]]
+    if kind == "neg":
+        return -_eval(node[1], values)
+    _, op, left, right = node
+    a = _eval(left, values)
+    b = _eval(right, values)
+    if op == "+":
+        return a + b
+    if op == "-":
+        return a - b
+    if op == "*":
+        return a * b
+    if op == "/":
+        return a / b
+    return a ** b
+
+
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute every cell's value, resolving references in dependency order."""
+    compiled = {name: _parse(name, raw) for name, raw in cells.items()}
+    values = {}
+
+    # Iterative depth-first resolution, so long reference chains cannot
+    # exhaust the interpreter's recursion limit. A cell is "open" from the
+    # moment we start expanding its dependencies until we evaluate it; any
+    # open cell we reach again is an ancestor of the current cell, i.e. a
+    # cycle.
+    open_cells = set()
+    for root in compiled:
+        if root in values:
+            continue
+        stack = [root]
+        while stack:
+            name = stack[-1]
+            if name in values:
+                stack.pop()
+                continue
+            ast, refs = compiled[name]
+            if name in open_cells:
+                values[name] = _eval(ast, values)
+                open_cells.discard(name)
+                stack.pop()
+                continue
+            open_cells.add(name)
+            for ref in refs:
+                if ref not in compiled:
+                    raise KeyError(ref)
+                if ref in open_cells:
+                    raise CycleError(
+                        "cycle detected involving %s and %s" % (name, ref)
+                    )
+                if ref not in values:
+                    stack.append(ref)
+
+    return values
