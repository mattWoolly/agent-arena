+_NUMBER = re.compile(r"\d+(?:\.\d*)?|\.\d+")
+_REF = re.compile(r"[A-Za-z]+\d*")
+_OPERATORS = set("+-*/^()")
+
+
+def _tokenize(text):
+    tokens = []
+    i, n = 0, len(text)
+    while i < n:
+        c = text[i]
+        if c.isspace():
+            i += 1
+        elif c in _OPERATORS:
+            tokens.append(("op", c))
+            i += 1
+        else:
+            m = _NUMBER.match(text, i)
+            if m:
+                tokens.append(("num", float(m.group())))
+                i = m.end()
+                continue
+            m = _REF.match(text, i)
+            if m:
+                tokens.append(("ref", m.group()))
+                i = m.end()
+                continue
+            raise ValueError(f"unexpected character {c!r} in formula")
+    return tokens
+
+
+class _Parser:
+    """Recursive-descent evaluator.
+
+    Grammar (low to high precedence):
+        expr  := term  (('+' | '-') term)*     left-associative
+        term  := unary (('*' | '/') unary)*    left-associative
+        unary := '-' unary | power             minus binds looser than '^'
+        power := atom ('^' unary)?             right-associative
+        atom  := number | ref | '(' expr ')'
+    """
+
+    def __init__(self, tokens, resolve):
+        self.tokens = tokens
+        self.pos = 0
+        self.resolve = resolve
+
+    def parse(self):
+        value = self.expr()
+        if self.pos != len(self.tokens):
+            raise ValueError(f"unexpected token {self.tokens[self.pos][1]!r}")
+        return value
+
+    def _take_op(self, ops):
+        if self.pos < len(self.tokens):
+            kind, val = self.tokens[self.pos]
+            if kind == "op" and val in ops:
+                self.pos += 1
+                return val
+        return None
+
+    def expr(self):
+        value = self.term()
+        while True:
+            op = self._take_op("+-")
+            if op is None:
+                return value
+            rhs = self.term()
+            value = value + rhs if op == "+" else value - rhs
+
+    def term(self):
+        value = self.unary()
+        while True:
+            op = self._take_op("*/")
+            if op is None:
+                return value
+            rhs = self.unary()
+            value = value * rhs if op == "*" else value / rhs
+
+    def unary(self):
+        if self._take_op("-"):
+            return -self.unary()
+        return self.power()
+
+    def power(self):
+        base = self.atom()
+        if self._take_op("^"):
+            return base ** self.unary()
+        return base
+
+    def atom(self):
+        if self.pos >= len(self.tokens):
+            raise ValueError("unexpected end of formula")
+        kind, val = self.tokens[self.pos]
+        if kind == "num":
+            self.pos += 1
+            return val
+        if kind == "ref":
+            self.pos += 1
+            return self.resolve(val)
+        if val == "(":
+            self.pos += 1
+            value = self.expr()
+            if not self._take_op(")"):
+                raise ValueError("missing ')'")
+            return value
+        raise ValueError(f"unexpected token {val!r}")
 
 
 def evaluate(cells):
-    raise NotImplementedError
+    values = {}
+    in_progress = set()
+
+    def resolve(name):
+        if name in values:
+            return values[name]
+        if name in in_progress:
+            raise CycleError(f"cycle detected at cell {name!r}")
+        raw = cells[name].strip()
+        in_progress.add(name)
+        try:
+            if raw.startswith("="):
+                value = _Parser(_tokenize(raw[1:]), resolve).parse()
+            else:
