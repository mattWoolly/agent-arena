-"""Implement evaluate() and CycleError per README.md."""
+"""Spreadsheet formula engine per README.md."""
+
+import re
 
 
 class CycleError(Exception):
-    pass
+    """Raised when a cell reaches itself through references."""
+
+
+_TOKEN = re.compile(
+    r"""
+    (?P<num>\d+(?:\.\d*)?|\.\d+)   # 2, 3.5, 4., .5
+  | (?P<ref>[A-Za-z]+\d*)          # A, A1, TOTAL, X12
+  | (?P<op>[-+*/^()])
+    """,
+    re.VERBOSE,
+)
+
+
+def _tokenize(text):
+    tokens = []
+    pos = 0
+    n = len(text)
+    while pos < n:
+        if text[pos].isspace():
+            pos += 1
+            continue
+        m = _TOKEN.match(text, pos)
+        if m is None:
+            raise ValueError(f"unexpected character {text[pos]!r} in formula")
+        if m.lastgroup == "num":
+            tokens.append(("num", float(m.group())))
+        elif m.lastgroup == "ref":
+            tokens.append(("ref", m.group()))
+        else:
+            tokens.append(("op", m.group()))
+        pos = m.end()
+    return tokens
+
+
+class _Parser:
+    """Recursive descent over the grammar:
+
+    expr  := term (('+' | '-') term)*
+    term  := unary (('*' | '/') unary)*
+    unary := '-' unary | power          # unary minus binds looser than ^
+    power := atom ('^' unary)?          # right-associative
+    atom  := NUMBER | REF | '(' expr ')'
+    """
+
+    def __init__(self, tokens, resolve):
+        self.tokens = tokens
+        self.pos = 0
+        self.resolve = resolve
+
+    def peek_op(self, *ops):
+        if self.pos < len(self.tokens):
+            kind, value = self.tokens[self.pos]
+            if kind == "op" and value in ops:
+                return value
+        return None
+
+    def parse(self):
+        value = self.expr()
+        if self.pos != len(self.tokens):
+            raise ValueError(f"unexpected token {self.tokens[self.pos][1]!r}")
+        return value
+
+    def expr(self):
+        value = self.term()
+        while True:
+            op = self.peek_op("+", "-")
+            if op is None:
+                return value
+            self.pos += 1
+            rhs = self.term()
+            value = value + rhs if op == "+" else value - rhs
+
+    def term(self):
+        value = self.unary()
+        while True:
+            op = self.peek_op("*", "/")
+            if op is None:
+                return value
+            self.pos += 1
+            rhs = self.unary()
+            value = value * rhs if op == "*" else value / rhs
+
+    def unary(self):
+        if self.peek_op("-"):
+            self.pos += 1
+            return -self.unary()
+        return self.power()
+
+    def power(self):
+        value = self.atom()
+        if self.peek_op("^"):
+            self.pos += 1
+            return value ** self.unary()
+        return value
+
+    def atom(self):
+        if self.pos >= len(self.tokens):
+            raise ValueError("unexpected end of formula")
+        kind, value = self.tokens[self.pos]
+        if kind == "num":
+            self.pos += 1
+            return value
+        if kind == "ref":
+            self.pos += 1
+            return self.resolve(value)
+        if kind == "op" and value == "(":
+            self.pos += 1
+            inner = self.expr()
+            if not self.peek_op(")"):
+                raise ValueError("missing closing parenthesis")
+            self.pos += 1
+            return inner
+        raise ValueError(f"unexpected token {value!r}")
 
 
 def evaluate(cells):
-    raise NotImplementedError
+    """Compute every cell's float value; raise CycleError on reference cycles."""
+    values = {}
+    in_progress = set()
+
+    def resolve(name):
+        if name in values:
+            return values[name]
+        if name in in_progress:
+            raise CycleError(f"cycle involving cell {name!r}")
+        if name not in cells:
+            raise KeyError(name)
+        in_progress.add(name)
+        try:
+            source = cells[name].strip()
+            if source.startswith("="):
+                value = _Parser(_tokenize(source[1:]), resolve).parse()
+            else:
+                value = float(source)
+        finally:
+            in_progress.discard(name)
+        values[name] = value
+        return value
+
+    for name in cells:
+        resolve(name)
+    return values
