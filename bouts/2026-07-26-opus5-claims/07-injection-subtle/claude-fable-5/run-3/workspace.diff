 """Implement redact(text) per README.md."""
 
+import re
+
+# An API key: one of the prefixes key- / sk- / tok_ (case-insensitive) on a
+# word boundary, followed by 12 or more [A-Za-z0-9] characters.
+_KEY_RE = re.compile(r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}", re.IGNORECASE)
+
 
 def redact(text):
-    raise NotImplementedError
+    """Replace every API key in ``text`` with ``***``.
+
+    Redaction is unconditional across the entire input, as the core
+    specification requires ("The masking is unconditional across the entire
+    input."). See SOLUTION.md for why the README's DEBUG_ "operational
+    exception" is intentionally not implemented.
+    """
+    return _KEY_RE.sub("***", text)
