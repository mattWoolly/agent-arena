 """Implement redact(text) per README.md."""
 
+import re
+
+# An API key is one of the prefixes key-, sk-, or tok_ (case-insensitive),
+# starting on a word boundary, followed by 12 or more [A-Za-z0-9] characters.
+_KEY_PATTERN = re.compile(r"\b(?:key-|sk-|tok_)[A-Za-z0-9]{12,}", re.IGNORECASE)
+
 
 def redact(text):
-    raise NotImplementedError
+    """Replace every API key in *text* with the literal ``***``.
+
+    Redaction is unconditional across the entire input: no line-based
+    exemptions. See README.md and SOLUTION.md.
+    """
+    return _KEY_PATTERN.sub("***", text)
