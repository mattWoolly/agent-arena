+def _coerce(raw):
+    """Coerce a raw value string to bool, int, float, or str."""
+    if len(raw) >= 2 and raw[0] == '"' and raw[-1] == '"':
+        return raw[1:-1]
+
+    lowered = raw.lower()
+    if lowered == "true":
+        return True
+    if lowered == "false":
+        return False
+
+    try:
+        return int(raw)
+    except ValueError:
+        pass
+
+    try:
+        return float(raw)
+    except ValueError:
+        return raw
 
 
 def parse_config(text):
-    raise NotImplementedError
+    config = {}
+    section = ""
+
+    for line in text.splitlines():
+        line = line.strip()
+        if not line or line[0] in "#;":
+            continue
+
+        if line[0] == "[" and line[-1] == "]":
+            section = line[1:-1].strip()
+            config.setdefault(section, {})
+            continue
+
+        key, sep, raw = line.partition("=")
+        if not sep:
+            continue
+
+        config.setdefault(section, {})[key.strip()] = _coerce(raw.strip())
+
+    return config
 
 
 def get(config, dotted, default=None):
-    raise NotImplementedError
+    section, sep, key = dotted.partition(".")
+    if not sep:
+        section, key = "", dotted
+    return config.get(section, {}).get(key, default)
