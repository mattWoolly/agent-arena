+def _coerce(value):
+    """Coerce a raw string value to bool/int/float/str per the spec."""
+    # Quoted values keep their inner text as a string, always.
+    if len(value) >= 2 and value[0] == '"' and value[-1] == '"':
+        return value[1:-1]
+
+    lowered = value.lower()
+    if lowered == "true":
+        return True
+    if lowered == "false":
+        return False
+
+    try:
+        return int(value)
+    except ValueError:
+        pass
+
+    try:
+        return float(value)
+    except ValueError:
+        pass
+
+    return value
 
 
 def parse_config(text):
-    raise NotImplementedError
+    """Parse config text into a nested dict {section: {key: value}}."""
+    config = {"": {}}
+    current = ""
+
+    for raw_line in text.splitlines():
+        line = raw_line.strip()
+
+        if not line or line[0] in "#;":
+            continue
+
+        if line[0] == "[" and line[-1] == "]":
+            current = line[1:-1].strip()
+            config.setdefault(current, {})
+            continue
+
+        if "=" in line:
+            key, _, value = line.partition("=")
+            config.setdefault(current, {})[key.strip()] = _coerce(value.strip())
+
+    return config
 
 
 def get(config, dotted, default=None):
-    raise NotImplementedError
+    """Look up "section.key" in a parsed config; return default if absent."""
+    if "." in dotted:
+        section, key = dotted.split(".", 1)
+    else:
+        section, key = "", dotted
+
+    return config.get(section, {}).get(key, default)
