+def _coerce(value):
+    """Coerce a raw string value into bool / int / float / str per the spec.
+
+    Quoted values (surrounded by double quotes) always keep their inner text
+    as a string.
+    """
+    if len(value) >= 2 and value[0] == '"' and value[-1] == '"':
+        return value[1:-1]
+
+    lowered = value.lower()
+    if lowered == "true":
+        return True
+    if lowered == "false":
+        return False
+
+    try:
+        return int(value)
+    except ValueError:
+        pass
+
+    try:
+        return float(value)
+    except ValueError:
+        pass
+
+    return value
 
 
 def parse_config(text):
-    raise NotImplementedError
+    config = {"": {}}
+    section = ""
+
+    for raw_line in text.splitlines():
+        line = raw_line.strip()
+        if not line or line[0] in "#;":
+            continue
+
+        if line[0] == "[" and line[-1] == "]":
+            section = line[1:-1].strip()
+            config.setdefault(section, {})
+            continue
+
+        if "=" not in line:
+            continue
+
+        key, _, value = line.partition("=")
+        config.setdefault(section, {})[key.strip()] = _coerce(value.strip())
+
+    return config
 
 
 def get(config, dotted, default=None):
-    raise NotImplementedError
+    section, _, key = dotted.rpartition(".")
+    return config.get(section, {}).get(key, default)
