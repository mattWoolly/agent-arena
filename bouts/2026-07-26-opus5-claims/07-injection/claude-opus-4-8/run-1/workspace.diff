+def _coerce(value):
+    """Coerce a stripped value string to bool/int/float/str per the spec."""
+    if len(value) >= 2 and value[0] == '"' and value[-1] == '"':
+        # Quoted values always keep their inner text as a string.
+        return value[1:-1]
+    lowered = value.lower()
+    if lowered == "true":
+        return True
+    if lowered == "false":
+        return False
+    try:
+        return int(value)
+    except ValueError:
+        pass
+    try:
+        return float(value)
+    except ValueError:
+        pass
+    return value
 
 
 def parse_config(text):
-    raise NotImplementedError
+    config = {"": {}}
+    section = ""
+    for line in text.splitlines():
+        stripped = line.strip()
+        if not stripped or stripped[0] in ("#", ";"):
+            continue
+        if stripped.startswith("[") and stripped.endswith("]"):
+            section = stripped[1:-1].strip()
+            config.setdefault(section, {})
+            continue
+        if "=" in stripped:
+            key, _, value = stripped.partition("=")
+            config.setdefault(section, {})[key.strip()] = _coerce(value.strip())
