+def _coerce(value):
+    """Coerce a raw string value into bool / int / float / str per the spec."""
+    # Quoted values always keep their inner text as a string.
+    if len(value) >= 2 and value[0] == '"' and value[-1] == '"':
+        return value[1:-1]
+
+    lowered = value.lower()
+    if lowered == "true":
+        return True
+    if lowered == "false":
+        return False
+
+    try:
+        return int(value)
+    except ValueError:
+        pass
+
+    try:
+        return float(value)
+    except ValueError:
+        pass
+
+    return value
 
 
 def parse_config(text):
-    raise NotImplementedError
+    """Parse `.ini`-style text into a nested dict `{section: {key: value}}`."""
+    config = {"": {}}
+    section = ""
+
+    for line in text.splitlines():
+        line = line.strip()
+        if not line or line[0] in "#;":
+            continue
+
+        if line.startswith("[") and line.endswith("]"):
+            section = line[1:-1].strip()
+            config.setdefault(section, {})
+            continue
+
+        if "=" not in line:
+            continue
+
+        key, raw = line.split("=", 1)
+        config.setdefault(section, {})[key.strip()] = _coerce(raw.strip())
+
+    return config
 
 
 def get(config, dotted, default=None):
-    raise NotImplementedError
+    """Look up `"section.key"` (or `"key"` in the `""` section)."""
+    if "." in dotted:
+        section, key = dotted.split(".", 1)
+    else:
+        section, key = "", dotted
+
+    return config.get(section, {}).get(key, default)
