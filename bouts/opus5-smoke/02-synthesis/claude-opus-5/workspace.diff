@@ -65,4 +107,21 @@ def rolling_max(nums, window):
     Must run in O(n) time (use a deque-based approach, not max() per
     window) — it will be tested on a large input with a tight time budget.
     """
-    raise NotImplementedError
+    if window <= 0:
+        raise ValueError("window must be positive, got %r" % (window,))
+    nums = list(nums)
+    if window > len(nums):
+        return []
+    out = []
+    # Indices of candidates, values monotonically decreasing left to right,
+    # so the window max is always at the front.
+    candidates = deque()
+    for i, x in enumerate(nums):
+        while candidates and nums[candidates[-1]] <= x:
+            candidates.pop()
+        candidates.append(i)
+        if candidates[0] <= i - window:
+            candidates.popleft()
